---
const { tiles, imageless = false, chips = false } = Astro.props;
---
<div class:list={["category-tiles", chips && "category-tiles--chips"]}>{tiles.map(tile => <a href={tile.href} class="category-tile">{!imageless && !chips && tile.image?.src && <img src={tile.image.src} alt="" width="48" height="48" loading="lazy" />}{!chips && <span class="tile-shade"></span>}<strong>{tile.label}</strong>{!chips && <small>{tile.count} on sale →</small>}</a>)}</div>
<style>.category-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem}.category-tile{position:relative;display:flex;flex-direction:column;justify-content:end;min-height:150px;padding:1rem;color:white;background:#26312d;overflow:hidden;text-decoration:none;border:1px solid var(--border)}.category-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.64}.tile-shade{position:absolute;inset:0;background:linear-gradient(0deg,#101716e8,transparent)}.category-tile strong,.category-tile small{position:relative}.category-tile strong{font:600 1.4rem var(--font-display)}.category-tile small{font:.7rem var(--font-mono);color:var(--accent-light)}@media(max-width:680px){.category-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}.category-tile{min-height:68px;padding:.55rem .7rem;justify-content:center}.category-tile strong{font-size:1.08rem}}.category-tiles--chips{display:flex;flex-wrap:wrap;gap:.45rem}.category-tiles--chips .category-tile{min-height:0;padding:.5rem .7rem;display:block;background:var(--bg-card);color:var(--text-primary);border-radius:var(--radius)}.category-tiles--chips .category-tile strong{font:600 .76rem var(--font-body)}@media(max-width:680px){.category-tiles--chips{display:flex;overflow-x:auto;flex-wrap:nowrap}.category-tiles--chips .category-tile{flex:none}}</style>
