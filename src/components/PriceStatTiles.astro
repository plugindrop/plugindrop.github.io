---
const { tiles } = Astro.props;
---
{tiles?.length > 0 && <div class="price-stat-tiles" data-price-stat-tiles>{tiles.map(tile => <div class="price-stat-tile"><span>{tile.label}</span><strong>{tile.value}</strong><small>{tile.note}</small></div>)}</div>}
<style>.price-stat-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin:1rem 0}.price-stat-tile{border:1px solid var(--border);padding:.7rem;background:var(--bg-card);display:flex;flex-direction:column;gap:.15rem}.price-stat-tile span{font-size:.7rem;color:var(--text-muted)}.price-stat-tile strong{font-size:1.2rem}.price-stat-tile small{font-size:.68rem;color:var(--text-muted)}@media(max-width:680px){.price-stat-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>
