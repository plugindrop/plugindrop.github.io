---
interface Props { model: any }
const { model } = Astro.props;
const cell = (row: any, key: string) => row.facts[key] ?? (row.prices[key] != null ? { value: row.prices[key] } : null);
---
{model.mode === 'table' && <div class="facts-scroll" data-facts-table data-coverage-total={model.coverage.total} data-coverage-qualified={model.coverage.qualified}><table data-facts-cells><thead><tr>
  <th scope="col">Product</th>{model.columns.map((column: any, index: number) => <th scope="col"><button type="button" data-facts-sort={index + 1}>{column.label} ↕</button></th>)}
</tr></thead><tbody>
  {model.rows.map((row: any) => <tr><th scope="row">{row.name}</th>{model.columns.map((column: any) => {
    const value: any = column.key === 'source' ? Object.values(row.facts)[0] : cell(row, column.key);
    return <td>{value ? value.url ? <a href={value.url}>{column.key === 'source' ? `Developer page (${value.fetchedAt})` : value.value}</a> : value.value : <span aria-label="not listed">—</span>}</td>;
  })}</tr>)}
</tbody></table>{model.alsoCovered.length > 0 && <p>Also covered: {model.alsoCovered.join(', ')}</p>}</div>}
<script>
  document.querySelectorAll<HTMLElement>('[data-facts-table]').forEach((block) => {
    const body = block.querySelector('tbody');
    block.querySelectorAll<HTMLButtonElement>('[data-facts-sort]').forEach((button) => button.addEventListener('click', () => {
      const index = Number(button.dataset.factsSort);
      const descending = button.dataset.descending !== 'true';
      button.dataset.descending = String(descending);
      Array.from(body?.rows ?? []).sort((a, b) => {
        const left = a.cells[index]?.textContent?.trim() ?? '—';
        const right = b.cells[index]?.textContent?.trim() ?? '—';
        if (left === '—') return 1;
        if (right === '—') return -1;
        return (descending ? -1 : 1) * left.localeCompare(right, undefined, { numeric: true });
      }).forEach((row) => body?.appendChild(row));
    }));
  });
</script>
<style>
  .facts-scroll { overflow-x: auto; margin: 1.5rem 0; }
  table { width: 100%; border-collapse: collapse; font-size: .82rem; }
  th, td { padding: .55rem .7rem; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; min-width: 6rem; }
  th:first-child { min-width: 10rem; }
  th button { border: 0; background: none; color: inherit; font: inherit; font-weight: 700; cursor: pointer; white-space: nowrap; }
</style>
