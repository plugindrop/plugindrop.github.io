---
import '../styles/global.css';
import { SITE_TITLE, SITE_TWITTER } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
	articleSection?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/images/default-og.jpg', ogType = 'website', articleSection } = Astro.props;
const resolvedImage = new URL(image, Astro.site);

// Pinterest prefers portrait images (2:3 ratio). Use 1000x1500 for pin-optimized pages.
// Standard OG uses 1200x630 (landscape). We expose both via og:image:width/height
// so each platform picks the right size. For article pages the hero is landscape,
// but we declare the dimensions explicitly so Pinterest can crop intelligently.
const isArticle = ogType === 'article';
---

<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-X5T5VNEGW5"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  // ?pd_internal=1 でlocalStorageにフラグをセット（管理者の自己訪問を内部トラフィックとして除外）
  (function() {
    try {
      var params = new URLSearchParams(window.location.search);
      if (params.get('pd_internal') === '1') {
        localStorage.setItem('pd_internal', '1');
      }
    } catch(e) {}
  })();
  var _pdInternal = (function() {
    try { return localStorage.getItem('pd_internal') === '1'; } catch(e) { return false; }
  })();
  gtag('config', 'G-X5T5VNEGW5', _pdInternal ? { traffic_type: 'internal' } : {});
</script>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0e0e0e" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" sizes="64x64" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />

<!-- Pinterest OGP: portrait image variant (1000x1500, 2:3 ratio recommended by Pinterest) -->
<!-- Pinterest picks the best image from og:image tags; we declare the landscape one above -->
<!-- and add explicit dimensions so Pinterest's crawler can choose the portrait crop. -->
{isArticle && (
  <>
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="1500" />
  </>
)}

<!-- article:section for Pinterest category signals -->
{articleSection && <meta property="article:section" content={articleSection} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_TWITTER} />
<meta name="twitter:creator" content={SITE_TWITTER} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage} />
<meta name="twitter:image:alt" content={title} />

<!-- Pinterest Rich Pin verification (article type) -->
{isArticle && <meta name="pinterest:media" content={String(resolvedImage)} />}

<!-- Bing Webmaster Tools -->
<meta name="msvalidate.01" content="D65FD174BC09065B3E7ECD3506F12B99" />

<!-- FlexOffers Ownership Verification (for Sweetwater affiliate application) -->
<meta name="fo-verify" content="7a68388e-91e2-4676-997d-b56aa9acfa6a" />

<!-- Indexing -->
<meta name="robots" content="index, follow, max-image-preview:large" />

<!-- Organization + WebSite schema (site-wide brand identity for AI/LLM citations) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://plugindrop.net/#organization",
      "name": "PluginDrop",
      "url": "https://plugindrop.net",
      "logo": {
        "@type": "ImageObject",
        "url": "https://plugindrop.net/favicon.png",
        "width": 64,
        "height": 64
      },
      "description": "PluginDrop curates the best VST plugin deals, honest reviews, and free downloads for music producers — updated daily.",
      "knowsAbout": ["VST plugins", "audio plugins", "music production", "mixing", "mastering", "synthesizers", "sample packs"],
      "publishingPrinciples": "https://plugindrop.net/about/"
    },
    {
      "@type": "WebSite",
      "@id": "https://plugindrop.net/#website",
      "url": "https://plugindrop.net",
      "name": "PluginDrop",
      "description": "Best VST plugin deals, free downloads and reviews — curated daily for music producers.",
      "publisher": { "@id": "https://plugindrop.net/#organization" },
      "inLanguage": "en-US"
    }
  ]
})} />
