---
import '../styles/global.css';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/jetbrains-mono';
import PersonalizationScript from './PersonalizationScript.astro';
import { SITE_TITLE, SITE_TWITTER } from '../consts';
import { stripMarkdownEmphasis } from '../lib/textUtils';
import { resolveInternalFlag, tagPbHrefForInternal } from '../lib/internalTraffic.mjs';

interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
	noindex?: boolean;
	canonicalPath?: string;
}

const canonicalURL = new URL(Astro.props.canonicalPath ?? Astro.url.pathname, Astro.site);
const { title, description, image = '/images/default-og.jpg', ogType = 'website', noindex = false } = Astro.props;
const resolvedImage = new URL(image, Astro.site);
// description は <meta> にプレーンテキストとして出力される場所なので、生Markdown記号が
// 紛れ込んでいても表示に出ないよう保険でstripする（本来の除去は生成側で行う）
const plainDescription = stripMarkdownEmphasis(description);
// Keep the tested helpers in the classic inline script so gtag runs before config.
const internalTrafficScript = `${resolveInternalFlag.toString()}
${tagPbHrefForInternal.toString()}
window.dataLayer = window.dataLayer || [];
function gtag() { window.dataLayer.push(arguments); }
gtag('js', new Date());
var internalParams = new URLSearchParams(location.search);
var storedInternal = null;
try { storedInternal = localStorage.getItem('pd_internal'); } catch (e) { /* storage unavailable */ }
var internalState = resolveInternalFlag(location.search, storedInternal);
try {
  if (internalState.write === '1') localStorage.setItem('pd_internal', '1');
  if (internalState.write === 'clear') localStorage.removeItem('pd_internal');
} catch (e) { /* storage unavailable */ }
if (internalParams.has('internal')) {
  var cleanUrl = new URL(location.href);
  cleanUrl.searchParams.delete('internal');
  history.replaceState(history.state, '', cleanUrl.pathname + cleanUrl.search + cleanUrl.hash);
}
if (internalState.flag) gtag('set', { traffic_type: 'internal' });
gtag('config', 'G-X5T5VNEGW5', internalState.flag ? { traffic_type: 'internal' } : {});
if (internalState.flag) {
  var showInternal = function () {
    var badge = document.createElement('span');
    badge.textContent = 'internal';
    badge.style.cssText = 'position:fixed;right:8px;bottom:8px;z-index:2147483647;padding:2px 5px;background:#222;color:#fff;font:11px sans-serif;opacity:.8;pointer-events:none';
    document.body.appendChild(badge);
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', showInternal, { once: true });
  else showInternal();
}
document.addEventListener('click', function (ev) {
  try {
    var a = ev.target && ev.target.closest && ev.target.closest('a[href]');
    if (!a) return;
    var url = new URL(a.href, location.href);
    if (url.hostname !== 'pluginboutique.com' && url.hostname !== 'www.pluginboutique.com') return;
    var host = a.closest('[data-slug]');
    var slug = host ? host.getAttribute('data-slug') : (a.getAttribute('data-slug') || '');
    var eventData = { slug: slug, chan: url.searchParams.get('chan') || '' };
    var placement = url.searchParams.get('data2');
    if (placement) eventData.placement = placement;
    if (internalState.flag) {
      eventData.traffic_type = 'internal';
      a.href = tagPbHrefForInternal(a.href);
    }
    gtag('event', 'pb_click', eventData);
  } catch (e) { /* noop */ }
}, { capture: true, passive: true });`;
---

<meta charset="utf-8" />

<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-X5T5VNEGW5"></script>
<script is:inline set:html={internalTrafficScript} />

<!-- Google AdSense: indexable pages only (noindex pages carry no ad tag) -->
{!noindex && (
	<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6778334514115669" crossorigin="anonymous"></script>
)}

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&display=swap" rel="stylesheet" />

<!-- Global Metadata -->
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0e0e0e" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" sizes="64x64" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={plainDescription} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={plainDescription} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_TWITTER} />
<meta name="twitter:creator" content={SITE_TWITTER} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={plainDescription} />
<meta name="twitter:image" content={resolvedImage} />

<!-- Bing Webmaster Tools -->
<meta name="msvalidate.01" content="D65FD174BC09065B3E7ECD3506F12B99" />

<!-- Indexing -->
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<PersonalizationScript />
