---
import '../styles/global.css';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/jetbrains-mono';
import PersonalizationScript from './PersonalizationScript.astro';
import { SITE_TITLE, SITE_TWITTER } from '../consts';
import { stripMarkdownEmphasis } from '../lib/textUtils';

interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/images/default-og.jpg', ogType = 'website', noindex = false } = Astro.props;
const resolvedImage = new URL(image, Astro.site);
// description は <meta> にプレーンテキストとして出力される場所なので、生Markdown記号が
// 紛れ込んでいても表示に出ないよう保険でstripする（本来の除去は生成側で行う）
const plainDescription = stripMarkdownEmphasis(description);
---

<meta charset="utf-8" />

<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-X5T5VNEGW5"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  var _pdInternal = (function() {
    try { return localStorage.getItem('pd_internal') === '1'; } catch(e) { return false; }
  })();
  gtag('config', 'G-X5T5VNEGW5', _pdInternal ? { traffic_type: 'internal' } : {});
</script>
<script is:inline>
(function () {
  // 上のGA4初期化スクリプトは is:inline が無いためAstroにtype="module"へバンドルされ、
  // その中の gtag はモジュールスコープに閉じ込められグローバルに出てこない。
  // ここで直接 dataLayer に積む同等の gtag を再定義して依存を切る。
  function gtag(){ window.dataLayer = window.dataLayer || []; window.dataLayer.push(arguments); }
  document.addEventListener('click', function (ev) {
    try {
      var a = ev.target && ev.target.closest && ev.target.closest('a[href*="pluginboutique.com"]');
      if (!a) return;
      var host = a.closest('[data-slug]');
      var slug = host ? host.getAttribute('data-slug') : (a.getAttribute('data-slug') || '');
      var url = new URL(a.href, location.href);
      var chan = url.searchParams.get('chan') || '';
      if (typeof gtag === 'function') {
        gtag('event', 'pb_click', { slug: slug, chan: chan });
      }
    } catch (e) { /* noop */ }
  }, { capture: true, passive: true });
})();
</script>

<!-- Google AdSense (site verification / pending review) -->
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6778334514115669" crossorigin="anonymous"></script>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&display=swap" rel="stylesheet" />

<!-- Global Metadata -->
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0e0e0e" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" sizes="64x64" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={plainDescription} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={plainDescription} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_TWITTER} />
<meta name="twitter:creator" content={SITE_TWITTER} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={plainDescription} />
<meta name="twitter:image" content={resolvedImage} />

<!-- Bing Webmaster Tools -->
<meta name="msvalidate.01" content="D65FD174BC09065B3E7ECD3506F12B99" />

<!-- FlexOffers Ownership Verification (for Sweetwater affiliate application) -->
<meta name="fo-verify" content="7a68388e-91e2-4676-997d-b56aa9acfa6a" />

<!-- Indexing -->
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<PersonalizationScript />
