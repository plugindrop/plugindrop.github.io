---
import { cheaperPeers, sameCategoryPeers } from '../../lib/priceInsights.mjs';
import { categoryForProduct } from '../../lib/categoryInference.mjs';
import { regularPriceOf, formatPrice } from '../../lib/priceUtils.ts';
import { slugifyProduct } from '../../lib/indexPolicy.mjs';
const { entry, name, candidates, lastUpdated } = Astro.props;
const cheaper = cheaperPeers(entry, name, candidates, categoryForProduct);
const peers = cheaper ?? sameCategoryPeers(entry, name, candidates, categoryForProduct);
---
<section class="options">
  <h2>{cheaper ? 'Cheaper options in the same category right now' : 'Similar products we track'}</h2>
  {peers.length > 0 && <table data-cheaper-table><thead><tr><th>Product</th><th>Current tracked price</th><th>Regular</th><th>On sale</th></tr></thead><tbody>{peers.map(peer => { const regular = regularPriceOf(peer.entry); const off = regular && peer.price < regular ? Math.round((1 - peer.price / regular) * 100) : 0; return <tr><td><a href={`/plugin-prices/${slugifyProduct(peer.name)}/`}>{peer.name}</a></td><td>{formatPrice(peer.price)}</td><td>{formatPrice(regular)}</td><td>{off ? `${off}%` : '—'}</td></tr>; })}</tbody></table>}
  <p class="source">Prices from PluginDrop's checks, last updated {lastUpdated}.</p>
</section>
<style>.options{margin:2rem 0}.options table{width:100%;min-width:0;border-collapse:collapse;font-size:.9rem;table-layout:fixed}.options th,.options td{padding:.7rem .4rem;border-bottom:1px solid var(--border);text-align:left;overflow-wrap:anywhere}.options th:first-child,.options td:first-child{width:40%}.source{font-size:.75rem;color:var(--text-muted)}@media(max-width:699px){.options th:nth-child(3),.options td:nth-child(3){display:none}.options table{font-size:.78rem}.options th:first-child,.options td:first-child{width:48%}}</style>
