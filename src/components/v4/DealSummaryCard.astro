---
import { verdictLabel } from '../../lib/verdict.mjs';
import { priceStatTiles } from '../../lib/priceStats.mjs';
import { regularPriceOf, currentPriceOf, formatPrice } from '../../lib/priceUtils.ts';
const { entry, name, image, state, href, pricePath, expiry } = Astro.props;
const current = currentPriceOf(entry), regular = regularPriceOf(entry);
const label = state === 'live' ? verdictLabel(entry) : state === 'ended' ? 'ENDED' : 'NOT CONFIRMED';
const off = current != null && regular != null && regular > current ? Math.round((1 - current / regular) * 100) : 0;
const lowest = priceStatTiles(entry).find(tile => tile.label === "Lowest we've tracked")?.value;
---
<section class="summary" aria-label="Current price summary">
  {image && <div class="art"><img src={image} alt={name} loading="eager" fetchpriority="high" /></div>}
  <div class="info">
    <span class="verdict">{label}</span>
    <div class="price">{formatPrice(current)}</div>
    <p>{regular != null && off > 0 && <><s>{formatPrice(regular)}</s> <strong>{off}% off</strong></>}</p>
    {lowest && <p>{current != null && lowest === formatPrice(current) ? "Lowest we've tracked" : `Lowest we've tracked: ${lowest}`}</p>}
    {state === 'live' && expiry && <p>Sale ends {expiry}</p>}
    {href && <a class="buy" href={href} rel="noopener sponsored" target="_blank">{state === 'live' ? 'Check current deal' : 'Check current price'}</a>}
    {pricePath && <a class="history" href={pricePath}>Full price history →</a>}
  </div>
</section>
<style>
.summary{display:grid;grid-template-columns:5fr 6fr;gap:1rem;border:1px solid var(--border);background:var(--bg-card);padding:1rem;margin:1rem 0 1.4rem;min-width:0}.art{min-width:0;background:#161a1a}.art img{display:block;width:100%;height:100%;max-height:370px;object-fit:contain}.info{display:flex;flex-direction:column;align-items:start;justify-content:center;min-width:0}.verdict{font:700 .78rem var(--font-mono);padding:.35rem .55rem;background:var(--accent-muted);color:var(--accent)}.price{font:700 clamp(2rem,5vw,3.5rem) var(--font-display);margin:.5rem 0}.info p{margin:.2rem 0}.buy{display:block;text-align:center;background:var(--accent);color:#fff;padding:.8rem 1rem;margin:.8rem 0;text-decoration:none;font-weight:700;min-width:200px}.history{font-size:.85rem}@media(max-width:699px){.summary{display:block;padding:.65rem}.art{display:none}.info{padding:.3rem}.price{font-size:2.4rem}.buy{width:100%;box-sizing:border-box;margin:.4rem 0;min-width:0}}
</style>
