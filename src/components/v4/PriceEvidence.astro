---
import PriceSparkline from './PriceSparkline.astro';
import PriceStatTiles from '../PriceStatTiles.astro';
import { priceStatTiles } from '../../lib/priceStats.mjs';
import { episodeRows } from '../../lib/pricePageEvidence.mjs';
import { verdictLabel } from '../../lib/verdict.mjs';
import { formatPrice } from '../../lib/priceUtils.ts';
const { entry, state, writtenDate, href, ctaText } = Astro.props;
const label = state === 'live' ? verdictLabel(entry) : state === 'ended' ? 'ENDED' : 'NOT CONFIRMED';
const episodes = episodeRows(entry).slice(0, 3);
---
<section id="price-check" class="evidence">
  <h2>Should you buy now?</h2>
  <p><strong class="verdict">{label}</strong> {state === 'live' ? 'Compare the current tracked price with the history below.' : 'Check the store before buying; the last tracked sale is not confirmed live.'}</p>
  <PriceStatTiles tiles={priceStatTiles(entry).map(tile => state === 'live' || tile.label !== 'Current' ? tile : { ...tile, label: 'Last seen' })} />
  <PriceSparkline entry={entry} />
  {episodes.length ? <><h3>Last 3 sales</h3><table><thead><tr><th>Sale window</th><th>Low</th><th>Off</th></tr></thead><tbody>{episodes.map(ep => <tr><td>{ep.start} → {ep.end}</td><td>{formatPrice(ep.low)}</td><td>{ep.depth == null ? '—' : `${ep.depth}%`}</td></tr>)}</tbody></table></> : <p>First sale we've tracked for this product.</p>}
  <p class="written">Our take, written {writtenDate}. Prices and sale status above reflect our latest tracked checks.</p>
  <slot />
  {href && <a class="cta" href={href} rel="noopener sponsored" target="_blank">{state === 'live' ? ctaText : 'Check current price'}</a>}
</section>
<style>.evidence{padding:1.2rem;border:1px solid var(--border);background:var(--bg-card);margin:2rem 0}.evidence h2{margin-top:0}.verdict{display:inline-block;padding:.25rem .45rem;background:var(--accent-muted);color:var(--accent);font:.75rem var(--font-mono)}.evidence table{width:100%;min-width:0;border-collapse:collapse;font-size:.86rem}.evidence th,.evidence td{text-align:left;padding:.5rem;border-bottom:1px solid var(--border)}.written{font-size:.8rem;color:var(--text-muted)}.cta{display:inline-block;background:var(--accent);color:white;text-decoration:none;font-weight:700;padding:.75rem 1rem;margin-top:.6rem}@media(max-width:699px){.evidence{padding:.75rem}.evidence table{font-size:.73rem}.evidence th,.evidence td{padding:.35rem}}</style>
