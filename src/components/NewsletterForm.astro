---
// NewsletterForm.astro - Resend経由メール登録フォーム
// フッター + evergreenガイド記事本文（BlogPost.astro isEvergreen）に埋め込む。
// 価格ドロップアラート訴求（generic "weekly deals" から変更・2026-07 CRO改善）。
---

<div class="newsletter-wrap" id="subscribe">
  <div class="nl-magnet">
    <span class="nl-gift">🔔</span>
    <div class="nl-magnet-text">
      <p class="nl-headline"><strong>Price-drop alerts</strong></p>
      <p class="nl-sub">We track 200+ plugins daily. Get one email when something you want hits its lowest price.</p>
    </div>
  </div>
  <form class="nl-form" id="nl-form" novalidate>
    <label for="nl-email" class="sr-only">Email address</label>
    <input
      type="email"
      name="email"
      id="nl-email"
      placeholder="your@email.com"
      autocomplete="email"
      required
      class="nl-input"
      aria-describedby="nl-msg"
    />
    <button type="submit" class="nl-btn" id="nl-btn">Get Alerts</button>
  </form>
  <fieldset class="nl-interests">
    <legend class="nl-interests-legend">What are you into? (optional)</legend>
    <label class="nl-interest"><input type="checkbox" name="interests" value="synth" /> Synths</label>
    <label class="nl-interest"><input type="checkbox" name="interests" value="guitar-bass" /> Guitar &amp; Bass</label>
    <label class="nl-interest"><input type="checkbox" name="interests" value="drums" /> Drums</label>
    <label class="nl-interest"><input type="checkbox" name="interests" value="vocals" /> Vocals</label>
    <label class="nl-interest"><input type="checkbox" name="interests" value="orchestral" /> Orchestral</label>
    <label class="nl-interest"><input type="checkbox" name="interests" value="mixing" /> Mixing &amp; Mastering</label>
  </fieldset>
  <p class="nl-msg" id="nl-msg" aria-live="polite"></p>
  <p class="nl-fine">No spam. Unsubscribe anytime.</p>
</div>

<script>
  const form = document.getElementById("nl-form") as HTMLFormElement | null;
  const msg = document.getElementById("nl-msg");
  const btn = document.getElementById("nl-btn") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = (document.getElementById("nl-email") as HTMLInputElement)?.value?.trim();
    if (!email) return;

    const interests = Array.from(
      document.querySelectorAll<HTMLInputElement>('.nl-interest input[name="interests"]:checked')
    ).map((el) => el.value);

    if (btn) btn.disabled = true;
    if (msg) { msg.textContent = "Subscribing…"; msg.className = "nl-msg"; }

    try {
      const SUBSCRIBE_URL = "https://plugindrop-subscribe.plugindrop.workers.dev";
      const res = await fetch(SUBSCRIBE_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, interests }),
      });
      const data = await res.json();
      if (data.success) {
        if (msg) { msg.textContent = "You're in! Check your inbox."; msg.className = "nl-msg nl-ok"; }
        form.reset();
      } else {
        throw new Error(data.error || "Unknown error");
      }
    } catch {
      if (msg) { msg.textContent = "Something went wrong. Try again."; msg.className = "nl-msg nl-err"; }
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>

<style>
  .newsletter-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.5rem 1rem 1.25rem;
    background: var(--bg-low, #111);
    border-top: 1px solid var(--border, #222);
    border-bottom: 1px solid var(--border, #222);
    width: 100%;
  }
  .nl-magnet {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 420px;
    width: 100%;
    margin-bottom: 0.25rem;
  }
  .nl-gift {
    font-size: 1.6rem;
    flex-shrink: 0;
    line-height: 1;
  }
  .nl-magnet-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .nl-headline {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-primary, #f0f0f0);
    line-height: 1.4;
  }
  .nl-headline strong {
    color: var(--accent, #7c3aed);
  }
  .nl-sub {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted, #888);
    line-height: 1.4;
  }
  .nl-fine {
    margin: 0;
    font-size: 0.72rem;
    color: var(--text-muted, #666);
  }
  .nl-form {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    max-width: 380px;
  }
  .nl-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--border, #333);
    background: var(--bg-base, #131319);
    color: var(--text-primary, #f0f0f0);
    font-size: 0.85rem;
    outline: none;
    min-width: 0;
  }
  .nl-input:focus {
    border-color: var(--accent, #7c3aed);
  }
  .nl-btn {
    padding: 0.5rem 1rem;
    background: var(--accent, #7c3aed);
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .nl-btn:hover { opacity: 0.85; }
  .nl-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .nl-interests {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.7rem;
    width: 100%;
    max-width: 420px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .nl-interests-legend {
    width: 100%;
    text-align: center;
    padding: 0;
    margin: 0 0 0.2rem;
    font-size: 0.72rem;
    color: var(--text-muted, #666);
  }
  .nl-interest {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-muted, #999);
    cursor: pointer;
  }
  .nl-interest input {
    accent-color: var(--accent, #7c3aed);
    cursor: pointer;
  }
  .nl-msg {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted, #888);
    min-height: 1.2em;
  }
  .nl-ok { color: #2ecc71 !important; }
  .nl-err { color: #e44 !important; }
  .sr-only {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
