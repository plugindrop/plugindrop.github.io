---
/**
 * Inline price-check card for blog posts.
 * Shows current price, an honest deal-score badge, a mini trend sparkline,
 * lowest-tracked price, and a "See deal" CTA for each tracked plugin.
 * Usage: pass pluginNames[] (unchanged interface — articles keep working as-is).
 */
import priceDataRaw from '../data/price_history.json';
import {
  type PriceEntry,
  pbLink as basePbLink,
  slugify,
  formatPrice,
  currentPriceOf,
  sparklinePoints,
  dealScore,
  dealScoreNumeric,
} from '../lib/priceUtils';

interface Props {
  pluginNames: string[];
}

const { pluginNames } = Astro.props;

const UTM = "utm_source=plugindrop&utm_medium=article&utm_campaign=price-tracker";
function pbLink(path: string) {
  return basePbLink(path, UTM);
}

const priceData = priceDataRaw as { last_updated: string; bundles: Record<string, PriceEntry>; plugins?: Record<string, PriceEntry> };
const lastUpdated = priceData.last_updated ?? '';

const allPlugins: Record<string, PriceEntry> = {
  ...(priceData.bundles ?? {}),
  ...(priceData.plugins ?? {}),
};

const tracked = pluginNames
  .map(name => ({ name, data: allPlugins[name] }))
  .filter((x): x is { name: string; data: PriceEntry } => !!x.data)
  .map(({ name, data }) => ({
    name,
    data,
    slug: slugify(name),
    current: currentPriceOf(data),
    pts: sparklinePoints(data.history),
    score: dealScore(currentPriceOf(data), data.typical_regular, data.typical_sale, data.all_time_low),
    numericScore: dealScoreNumeric(data),
  }));
---

{tracked.length > 0 && (
  <div class="pt-box">
    <div class="pt-header">
      <span class="pt-label">Price Check</span>
      <a href="/plugin-prices/" class="pt-fulllink">See full history →</a>
    </div>
    <div class="pt-grid">
      {tracked.map(({ name, data, slug, current, pts, score, numericScore }) => (
        <div class="pt-card">
          <div class="pt-card-top">
            <a href={`/plugin-prices/${slug}/`} class="pt-name">{name}</a>
            <span class={`pt-badge ${score.cls}`}>{score.label}</span>
            {numericScore.verdict === 'none' ? (
              <span class="score-none" title="No discount history — price is stable">—</span>
            ) : (
              <span class={`score-badge ${numericScore.verdict}`}>{numericScore.score}</span>
            )}
          </div>
          <div class="pt-card-mid">
            <span class="pt-price mono">{formatPrice(current)}</span>
            {pts ? (
              <svg class="pt-spark-svg" width="64" height="22" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
                <polyline
                  points={pts}
                  fill="none"
                  stroke="var(--accent)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            ) : (
              <span class="pt-spark-none" aria-hidden="true">—</span>
            )}
          </div>
          <div class="pt-card-bottom">
            <span class="pt-low">
              {data.all_time_low !== null ? `Lowest tracked ${formatPrice(data.all_time_low)}` : ''}
            </span>
            {lastUpdated && <span class="pt-checked">checked {lastUpdated}</span>}
          </div>
          <a href={pbLink(data.pb_url)} class="pt-cta" target="_blank" rel="noopener sponsored">See deal →</a>
        </div>
      ))}
    </div>
    <p class="pt-note">
      Prices tracked at Plugin Boutique. <a href="/plugin-prices/">View full price history →</a>
      &middot; <a href="/how-we-track-prices/">How we track →</a>
    </p>
  </div>
)}

<style>
  .pt-box {
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent-muted);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: 0.9rem 1.1rem;
    font-size: 0.85rem;
  }
  .pt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .pt-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 700;
  }
  .pt-fulllink {
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
  }
  .pt-fulllink:hover { text-decoration: underline; }

  .pt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 0.75rem;
  }
  .pt-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.7rem 0.75rem;
    background: var(--bg-low);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    min-width: 0;
  }
  .pt-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .pt-name {
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.88rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }
  .pt-name:hover { color: var(--accent); }

  .pt-badge {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .ds-lowest  { background: rgba(230, 57, 70, 0.15); color: #ff8a94; }
  .ds-great   { background: rgba(80, 200, 120, 0.15); color: #50c878; }
  .ds-sale    { background: rgba(255, 186, 69, 0.12); color: var(--sale-text); }
  .ds-rare    { background: rgba(150, 150, 180, 0.1); color: var(--text-muted); }
  .ds-wait    { background: rgba(150, 150, 180, 0.12); color: var(--text-secondary); }
  .ds-unknown { background: rgba(150, 150, 180, 0.1); color: var(--text-muted); }

  .score-badge {
    display: inline-flex;
    min-width: 2rem;
    align-items: center;
    justify-content: center;
    padding: 0.18rem 0.4rem;
    border-radius: var(--radius-sm);
    color: var(--bg-base);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
  }
  .score-badge.good { background: var(--verdict-good); }
  .score-badge.ok { background: var(--verdict-ok); }
  .score-badge.bad { background: var(--verdict-bad); }
  .score-none { color: var(--text-muted); font-family: var(--font-mono); }

  .pt-card-mid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .pt-price {
    font-weight: 800;
    color: var(--text-primary);
    font-size: 1.05rem;
  }
  .pt-spark-svg { display: block; flex-shrink: 0; }
  .pt-spark-none {
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .pt-card-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 1.6em;
  }
  .pt-low {
    font-size: 0.7rem;
    font-weight: 700;
    color: #e63946;
  }
  .pt-checked {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .pt-cta {
    display: block;
    text-align: center;
    margin-top: 0.15rem;
    padding: 0.4rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--bg-base);
    background: var(--accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .pt-cta:hover { background: var(--accent-light); }

  .pt-note {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin: 0.85rem 0 0;
    line-height: 1.5;
  }
  .pt-note a { color: var(--accent); text-decoration: none; }
  .pt-note a:hover { text-decoration: underline; }

  .mono {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 400px) {
    .pt-grid { grid-template-columns: 1fr; }
  }
</style>
