---
/**
 * Inline price tracker widget for blog posts.
 * Shows current price, typical sale, ATL, and deal badge for tracked plugins.
 * Usage: pass pluginNames[] and the full priceData object.
 */
import priceDataRaw from '../data/price_history.json';

interface Props {
  pluginNames: string[];
}

const { pluginNames } = Astro.props;

const AFF = "a_aid=69cb95abe1763";
const UTM = "utm_source=plugindrop&utm_medium=article&utm_campaign=price-tracker";

interface HistoryEntry {
  date: string;
  regular: number | null;
  sale: number | null;
  source: string;
}

interface PluginData {
  pb_url: string;
  typical_regular: number | null;
  typical_sale: number | null;
  all_time_low: number | null;
  notes?: string;
  history: HistoryEntry[];
}

const allPlugins: Record<string, PluginData> = {
  ...(priceDataRaw.bundles ?? {}),
  ...((priceDataRaw as any).plugins ?? {}),
};

const tracked = pluginNames
  .map(name => ({ name, data: allPlugins[name] }))
  .filter(x => x.data);

function pbLink(path: string) {
  if (!path) return '#';
  if (path.startsWith('http')) return path;
  const sep = path.includes('?') ? '&' : '?';
  return `https://www.pluginboutique.com${path}${sep}${AFF}&${UTM}`;
}

function formatPrice(val: number | null): string {
  if (val === null) return '—';
  return `$${val}`;
}

function dealRating(d: PluginData): { label: string; cls: string } {
  const latest = d.history.at(-1);
  if (!latest) return { label: 'No Data', cls: 'pt-unknown' };
  const cur = latest.sale ?? latest.regular;
  if (cur === null) return { label: 'No Data', cls: 'pt-unknown' };
  if (latest.sale !== null && d.typical_sale !== null && latest.sale <= d.typical_sale)
    return { label: 'Great Deal', cls: 'pt-great' };
  if (latest.sale !== null)
    return { label: 'On Sale', cls: 'pt-sale' };
  return { label: 'Normal Price', cls: 'pt-normal' };
}
---

{tracked.length > 0 && (
  <div class="pt-box">
    <div class="pt-header">
      <span class="pt-label">Price Tracker</span>
      <a href="/plugin-prices/" class="pt-fulllink">See full history →</a>
    </div>
    <div class="pt-rows">
      {tracked.map(({ name, data }) => {
        const latest = data.history.at(-1);
        const curSale = latest?.sale ?? null;
        const curReg = latest?.regular ?? null;
        const rating = dealRating(data);
        return (
          <div class="pt-row">
            <div class="pt-name-wrap">
              <a href={pbLink(data.pb_url)} class="pt-name" target="_blank" rel="noopener sponsored">{name}</a>
              <span class={`pt-badge ${rating.cls}`}>{rating.label}</span>
            </div>
            <div class="pt-prices">
              {curSale !== null ? (
                <span class="pt-price-sale">{formatPrice(curSale)}</span>
              ) : (
                <span class="pt-price-reg">{formatPrice(curReg)}</span>
              )}
              {data.typical_sale !== null && (
                <span class="pt-typical">typical sale: {formatPrice(data.typical_sale)}</span>
              )}
              {data.all_time_low !== null && (
                <span class="pt-atl">Lowest tracked: {formatPrice(data.all_time_low)}</span>
              )}
            </div>
          </div>
        );
      })}
    </div>
    <p class="pt-note">
      Prices tracked at Plugin Boutique. <a href="/plugin-prices/">View full price history →</a>
    </p>
  </div>
)}

<style>
  .pt-box {
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent-muted);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: 0.9rem 1.1rem;
    font-size: 0.85rem;
  }
  .pt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }
  .pt-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 700;
  }
  .pt-fulllink {
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
  }
  .pt-fulllink:hover { text-decoration: underline; }
  .pt-rows {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .pt-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .pt-row:last-child { border-bottom: none; padding-bottom: 0; }
  .pt-name-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .pt-name {
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
  }
  .pt-name:hover { color: var(--accent); }
  .pt-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pt-great  { background: rgba(80,200,120,0.15); color: #50c878; }
  .pt-sale   { background: rgba(255,200,60,0.12); color: #ffc83c; }
  .pt-normal { background: rgba(150,150,180,0.12); color: var(--text-muted); }
  .pt-unknown { background: rgba(150,150,180,0.1); color: var(--text-muted); }
  .pt-prices {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .pt-price-sale { font-weight: 800; color: #50c878; font-size: 0.95rem; }
  .pt-price-reg  { font-weight: 700; color: var(--text-primary); font-size: 0.95rem; }
  .pt-typical { color: var(--text-muted); font-size: 0.75rem; }
  .pt-atl {
    font-size: 0.7rem;
    font-weight: 700;
    color: #e63946;
    background: rgba(230,57,70,0.1);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }
  .pt-note {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin: 0.6rem 0 0;
    line-height: 1.5;
  }
  .pt-note a { color: var(--accent); text-decoration: none; }
  .pt-note a:hover { text-decoration: underline; }
</style>
