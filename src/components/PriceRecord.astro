---
import { priceRecord } from '../lib/priceRecord.mjs';

const { entry } = Astro.props;
const record = priceRecord(entry);
---
<section class="price-record" aria-label="Price record" data-price-record data-product-url={entry?.pb_url ?? ''} data-observed-date={record.observed?.date ?? ''} data-observed-price={record.observed?.price ?? ''} data-observations={record.checks}>
  <h2>Price record</h2>
  {!record.enough ? <p>{record.checks ? `${record.checks} checks observed; not enough sale episodes yet` : 'No confirmed price observations yet'}</p> : <ul>
    <li>Observed {record.from} to {record.to}: {record.checks} checks</li>
    <li>{record.episodes} sale episodes observed</li>
    {record.previous && <li>Previous sale: {record.previous.depth === null ? 'discount unavailable' : `${record.previous.depth}% off`}; last observed {record.previous.end}</li>}
    {record.returned && <li>Price after sale: {record.returned.price} observed {record.returned.date}</li>}
    {record.lowest && <li>Lowest observed price, excluding research: {record.lowest}</li>}
  </ul>}
</section>
