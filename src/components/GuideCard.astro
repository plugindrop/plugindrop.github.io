---
const { post } = Astro.props;
---
<a class="guide-card" href={`/posts/${post.id}/`}><img src={post.data.heroImage} alt="" width="480" height="300" loading="lazy" /><div><small>GUIDE</small><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div></a>
<style>.guide-card{display:block;overflow:hidden;color:inherit;text-decoration:none;background:var(--bg-card);border:1px solid var(--border)}.guide-card img{width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;display:block}.guide-card div{padding:.8rem}.guide-card small{font:700 .62rem var(--font-mono);letter-spacing:.1em;color:var(--accent)}.guide-card h3{margin:.35rem 0;font:600 1.08rem/1.2 var(--font-display);color:var(--text-primary)}.guide-card p{margin:0;color:var(--text-muted);font-size:.75rem;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}</style>
