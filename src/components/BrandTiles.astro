---
const { tiles } = Astro.props;
---
<div class="brand-tiles">{tiles.map(tile => <a href={tile.href}><strong>{tile.brand}</strong><small>{tile.count} on sale →</small></a>)}</div>
<style>.brand-tiles{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.55rem}.brand-tiles a{display:flex;min-width:0;min-height:74px;flex-direction:column;justify-content:space-between;padding:.65rem;background:var(--bg-card);border:1px solid var(--border);text-decoration:none}.brand-tiles strong{font-size:.78rem;overflow-wrap:anywhere;color:var(--text-primary)}.brand-tiles small{font:.64rem var(--font-mono);color:var(--accent)}@media(max-width:680px){.brand-tiles{grid-template-columns:repeat(3,minmax(0,1fr))}.brand-tiles a{min-height:65px}}</style>
