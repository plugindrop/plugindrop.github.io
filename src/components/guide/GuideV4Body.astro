---
import PicksPriceTable from './PicksPriceTable.astro';
import PickCard from './PickCard.astro';
import VsTable from './VsTable.astro';
import CheapestWayIn from './CheapestWayIn.astro';
import PriceEvidence from '../v4/PriceEvidence.astro';
import CheaperOptionsTable from '../v4/CheaperOptionsTable.astro';
import { dealState } from '../../lib/articleDeal.mjs';
const { parsed, picks = [], candidates = [], lastUpdated = '', writtenDate = '', slug = '' } = Astro.props;
const firstVideo = picks.find(p => p?.video?.video_id);
const primary = picks[0];
const state = primary?.entry ? dealState(primary.entry, Date.now()) : 'unknown';
const sections = parsed.sections;
---
<div class="v4-layout guide-v4"><div class="v4-read prose"><slot name="header" /></div>{parsed.kind === 'review' && primary && <section class="product-hero"><h2>{primary.name}</h2><p>{primary.content?.prose?.intro ?? 'Product overview and tracked price evidence'}</p><p>{primary.priceFacts ? `Current tracked price: ${primary.priceFacts.today ?? 'Not tracked'}` : 'Price not tracked'}</p></section>}<nav class="jump" aria-label="Jump to section">{sections.map(s => <a href={`#${s.id}`}>{s.role}</a>)}</nav><div class="v4-read prose" set:html={parsed.tldrHtml} />{firstVideo && <div class="first-video"><iframe src={`https://www.youtube-nocookie.com/embed/${firstVideo.video.video_id}`} title={`${firstVideo.name} demo`} loading="lazy" allowfullscreen></iframe></div>}{parsed.kind === 'roundup' && <PicksPriceTable {picks} {lastUpdated} />}{parsed.kind === 'vs' && <VsTable {picks} />}{sections.map(section => section.role === 'faq' && parsed.faqItems.length ? <section id={section.id} class="guide-faq v4-read prose"><h2>FAQ</h2>{parsed.faqItems.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section> : <div class="v4-read prose"><div set:html={section.html} />{section.role === 'pick' && section.pick && picks.find(p => p.name === section.pick) && <PickCard pick={picks.find(p => p.name === section.pick)} {slug} />}</div>)}{parsed.kind === 'review' && primary?.entry && <><PriceEvidence entry={primary.entry} {state} {writtenDate} /><CheaperOptionsTable entry={primary.entry} name={primary.name} {candidates} {lastUpdated} /></>}{parsed.kind === 'roundup' && <CheapestWayIn {picks} {candidates} free={slug.includes('free')} />}{parsed.kind === 'guide' && picks.length >= 2 && <PicksPriceTable {picks} {lastUpdated} />}<div class="v4-read prose"><slot name="footer" /></div></div>
<style>.v4-layout{max-width:960px;margin:0 auto;padding:0 16px;box-sizing:border-box}.v4-read{overflow-wrap:anywhere;max-width:none;font-size:1.125rem;line-height:1.75}.jump{display:flex;gap:.5rem;overflow-x:auto;white-space:nowrap;margin:1rem 0}.jump a{flex:none;padding:.4rem .6rem;border:1px solid var(--border)}.first-video iframe{width:100%;aspect-ratio:16/9;border:0}.v4-read :global(img){max-width:100%;height:auto}@media(max-width:699px){.v4-layout{padding:0 12px}}</style>
