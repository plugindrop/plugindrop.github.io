---
import PicksPriceTable from './PicksPriceTable.astro';
import PickCard from './PickCard.astro';
import VsTable from './VsTable.astro';
import CheapestWayIn from './CheapestWayIn.astro';
const { parsed, picks = [], lastUpdated = '', slug = '' } = Astro.props;
const firstVideo = picks.find(p => p?.video?.video_id);
const sections = parsed.sections;
---
<div class="v4-layout guide-v4"><div class="v4-read prose"><slot name="header" /></div><nav class="jump" aria-label="Jump to section">{sections.map(s => <a href={`#${s.id}`}>{s.role}</a>)}</nav><div class="v4-read prose" set:html={parsed.tldrHtml} />{firstVideo && <div class="first-video"><iframe src={`https://www.youtube-nocookie.com/embed/${firstVideo.video.video_id}`} title={`${firstVideo.name} demo`} loading="lazy" allowfullscreen></iframe></div>}{parsed.kind === 'roundup' && <PicksPriceTable {picks} {lastUpdated} />}{parsed.kind === 'vs' && <VsTable {picks} />}{sections.map(section => <div class="v4-read prose"><div set:html={section.html} />{section.role === 'pick' && section.pick && picks.find(p => p.name === section.pick) && <PickCard pick={picks.find(p => p.name === section.pick)} {slug} />}</div>)}{parsed.kind === 'roundup' && <CheapestWayIn {picks} free={slug.includes('free')} />}{parsed.kind === 'guide' && picks.length >= 2 && <PicksPriceTable {picks} {lastUpdated} />}<div class="v4-read prose"><slot name="footer" /></div></div>
<style>.v4-layout{max-width:960px;margin:0 auto;padding:0 16px;box-sizing:border-box}.v4-read{max-width:none;font-size:1.125rem;line-height:1.75}.jump{display:flex;gap:.5rem;overflow-x:auto;white-space:nowrap;margin:1rem 0}.jump a{flex:none;padding:.4rem .6rem;border:1px solid var(--border)}.first-video iframe{width:100%;aspect-ratio:16/9;border:0}.v4-read :global(img){max-width:100%;height:auto}@media(max-width:699px){.v4-layout{padding:0 12px}}</style>
