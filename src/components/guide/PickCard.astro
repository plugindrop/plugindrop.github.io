---
import { priceTableRow } from '../../lib/guideV4.mjs';
import { episodeRows } from '../../lib/pricePageEvidence.mjs';
import { pbLink } from '../../lib/priceUtils';
const { pick, compact = false, showVideo = true } = Astro.props;
const row = priceTableRow(pick);
const episode = pick?.entry ? episodeRows(pick.entry)[0] : null;
const buyHref = pick?.freeFact?.official_url ?? (pick?.entry?.pb_url ? pbLink(pick.entry.pb_url, 'chan=art', { data1: Astro.props.slug ?? '', placement: 'body' }) : null);
---
{pick && <section class:list={['guide-pick', { compact }]} data-pick={pick.name}><h3>{pick.name}</h3>{showVideo && pick.video?.video_id && <div class="guide-video"><iframe src={`https://www.youtube-nocookie.com/embed/${pick.video.video_id}`} title={`${pick.name} demo`} loading="lazy" allowfullscreen></iframe></div>}{pick.content?.prose?.intro && <p>{pick.content.prose.intro}</p>}<p class="price">{row.current} · Regular {row.regular} · {row.off} off · Low {row.low}</p>{episode && <p>Last sale we tracked: {episode.start}–{episode.end}, low ${episode.low} ({episode.depth}% off)</p>}{buyHref && <a class="buy" href={buyHref} rel="noopener sponsored">{pick.freeFact ? 'Get free' : 'Buy'}</a>}</section>}
<style>.guide-pick{border:1px solid var(--border);padding:1rem;margin:1.5rem 0;background:var(--bg-card)}.guide-pick h3{margin-top:0}.guide-video iframe{display:block;width:100%;aspect-ratio:16/9;border:0}.guide-pick .price{font-weight:700}.guide-pick.compact{padding:.75rem}</style>
