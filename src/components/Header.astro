---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import priceData from '../data/price_history.json';
---

<header>
	<nav aria-label="Main navigation">
		<a href="/" class="logo">
			<img src="/images/logo.png" alt="PluginDrop" class="logo-icon" width="32" height="32" />
			<span class="logo-text">{SITE_TITLE}</span>
			<span class="freshness">Prices checked {priceData.last_updated}</span>
		</a>
		<div class="nav-links">
			<HeaderLink href="/posts/">All Deals</HeaderLink>
			<HeaderLink href="/best/">Best by Category</HeaderLink>
			<a href="/free/" class="nav-badge free">Free</a>
			<a href="/posts/?filter=sale" class="nav-badge sale">Sales</a>
			<a href="/posts/?filter=guide" class="nav-link-guides">Guides</a>
			<HeaderLink href="/plugin-prices/">Price Tracker</HeaderLink>
			<HeaderLink href="/brands/">Brands</HeaderLink>
			<HeaderLink href="/categories/">Categories</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
		</div>
		<form class="header-search" action="/posts/" method="get" role="search"><input type="search" name="q" placeholder="Search plugins and deals" aria-label="Search plugins and deals" /><button type="submit">Search</button></form>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(27, 25, 23, 0.85);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-bottom: 1px solid var(--border);
		padding: 0 1.5rem;
	}
	nav {
		max-width: 1400px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 52px;
		gap: 1rem;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--text-primary);
		flex-shrink: 0;
	}
	.logo-icon {
		width: 26px;
		height: 26px;
		border-radius: 4px;
	}
	.logo-text {
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		color: var(--text-primary);
	}
	.freshness {
		font-size: 0.68rem;
		color: var(--accent-dark);
		font-weight: 600;
		letter-spacing: 0.02em;
		padding-left: 0.5rem;
		border-left: 1px solid var(--border);
		margin-left: 0.25rem;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}
	.header-search { display: flex; min-width: 170px; width: clamp(170px, 24vw, 340px); border: 1px solid var(--border); background: var(--bg-low); border-radius: var(--radius); }
	.header-search input { min-width: 0; width: 100%; padding: .38rem .65rem; color: var(--text-primary); background: transparent; border: 0; font: inherit; font-size: .78rem; }
	.header-search button { padding: .3rem .6rem; color: var(--accent); background: transparent; border: 0; cursor: pointer; font-size: .76rem; }
	.header-search:focus-within { border-color: var(--accent); }
	@media (max-width: 800px) { nav { flex-wrap: wrap; padding: .45rem 0; } .header-search { order: 2; width: 100%; } .nav-links { flex: 1; } }
	.nav-links::-webkit-scrollbar {
		display: none;
	}
	.nav-links a {
		flex-shrink: 0;
	}
	@media (max-width: 640px) {
		.freshness { display: none; }
	}
	.nav-links a {
		padding: 0.4rem 0.8rem;
		color: var(--text-muted);
		font-size: 0.875rem;
		font-weight: 600;
		border-radius: var(--radius-sm);
		transition: color 0.15s, background 0.15s;
		text-decoration: none;
	}
	.nav-links a:hover,
	.nav-links a.active {
		color: var(--text-primary);
		background: var(--bg-card);
	}
	.nav-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.78rem !important;
		font-weight: 700 !important;
		padding: 0.3rem 0.65rem !important;
		border-radius: 2px !important;
	}
	.nav-badge::before {
		content: '';
		display: block;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.nav-badge.free::before { background: var(--free-text); }
	.nav-badge.sale::before { background: var(--sale-text); }
	.nav-badge.free {
		color: var(--free-text) !important;
		background: var(--free-bg) !important;
	}
	.nav-badge.sale {
		color: var(--sale-text) !important;
		background: var(--sale-bg) !important;
	}
	.nav-badge.free:hover {
		background: rgba(148, 211, 196, 0.18) !important;
	}
	.nav-badge.sale:hover {
		background: rgba(255, 186, 69, 0.18) !important;
	}
	@media (max-width: 480px) {
		.nav-badge { display: none; }
	}
</style>
