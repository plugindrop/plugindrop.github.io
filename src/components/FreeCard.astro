---
const { item } = Astro.props;
---
<article class="free-card"><a href={item.url} target="_blank" rel="noopener"><div class="free-art">{item.image ? <img src={item.image} alt="" width="480" height="300" loading="lazy" /> : <span>{item.name}</span>}<strong>FREE</strong></div><h3>{item.name}</h3></a><a class="free-cta" href={item.url} target="_blank" rel="noopener">Download free (official site) →</a></article>
<style>.free-card{min-width:0;background:var(--bg-card);border:1px solid var(--border);overflow:hidden}.free-card>a:first-child{color:inherit;text-decoration:none}.free-art{position:relative;aspect-ratio:16/10;background:linear-gradient(135deg,#1a3d39,#141d21);display:grid;place-items:center;overflow:hidden}.free-art img{width:100%;height:100%;object-fit:contain}.free-art span{font:600 clamp(1.2rem,2vw,2rem) var(--font-display);color:var(--accent)}.free-art strong{position:absolute;right:0;bottom:0;padding:.2rem .5rem;background:var(--accent);color:var(--bg-base);font:.7rem var(--font-mono)}.free-card h3{margin:.7rem .7rem .4rem;font-size:.9rem;color:var(--text-primary)}.free-cta{display:block;margin:0 .7rem .8rem;color:var(--accent);font-size:.7rem;text-decoration:none}@media(max-width:680px){.free-card h3{font-size:.8rem}}</style>
