---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page Not Found | ${SITE_TITLE}`} description="The page you're looking for doesn't exist." />
		<style>
			main {
				max-width: 600px;
				margin: 6rem auto;
				padding: 0 1.5rem;
				text-align: center;
			}
			h1 {
				font-size: 4rem;
				font-weight: 800;
				color: var(--accent);
				margin: 0 0 0.5rem;
			}
			p {
				color: var(--text-muted);
				margin-bottom: 2rem;
			}
			a {
				display: inline-block;
				padding: 0.6rem 1.4rem;
				background: var(--accent-muted);
				color: var(--accent-light);
				border-radius: var(--radius-sm);
				text-decoration: none;
				font-weight: 600;
				font-size: 0.9rem;
			}
			a:hover { background: var(--accent); color: #000; }
		</style>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">
			<h1>404</h1>
			<p>That page doesn't exist — it may have expired or been removed.</p>
			<a href="/posts">Browse all deals →</a>
		</main>
		<Footer />
	</body>
</html>
