---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import DealCard from '../../components/DealCard.astro';
import priceData from '../../data/price_history.json';
import copy from '../../data/deal_copy.json';
import videos from '../../data/product_videos.json';
import { buildDealPool, toCardModel } from '../../lib/homeDeals.mjs';
import { siteStats, brandStats } from '../../lib/siteStats.mjs';
const { trackingSince } = siteStats(priceData);
import { isBrandPageIndexable, slugifyProduct } from '../../lib/indexPolicy.mjs';
import { countIndexableBrandProducts } from '../../lib/brandIndexability.mjs';
import { detectBrand } from '../../lib/brands.mjs';

interface HistoryEntry {
  date: string;
  regular: number | null;
  sale: number | null;
  source: string;
}
interface EntryData {
  pb_url: string;
  typical_regular: number | null;
  typical_sale: number | null;
  all_time_low: number | null;
  notes?: string;
  category?: string;
  history: HistoryEntry[];
}
interface PriceData {
  last_updated: string;
  bundles: Record<string, EntryData>;
  plugins?: Record<string, EntryData>;
}
interface Product {
  name: string;
  kind: 'plugin' | 'bundle';
  entry: EntryData;
}

const data = priceData as PriceData;
const plugins = data.plugins ?? {};
const bundles = data.bundles ?? {};

const allProducts: Product[] = [];
for (const [n, e] of Object.entries(plugins)) allProducts.push({ name: n, kind: 'plugin', entry: e });
for (const [n, e] of Object.entries(bundles)) allProducts.push({ name: n, kind: 'bundle', entry: e });

const groups = new Map<string, Product[]>();
for (const p of allProducts) {
  const brand = detectBrand(p.name, p.entry.notes);
  if (!brand) continue;
  const arr = groups.get(brand) ?? [];
  arr.push(p);
  groups.set(brand, arr);
}

const cardEntries = { ...priceData.bundles, ...priceData.plugins };
const cardNow = Date.now();
const dealPool = buildDealPool(cardEntries, [], cardNow);
const stats = brandStats(priceData, { now: cardNow, dealPool });
const cards = dealPool.map(deal => toCardModel(deal, { entries: cardEntries, priceData, now: cardNow, videos, copy }));

interface BrandSummary {
  brand: string;
  slug: string;
  tracked: number;
  onSaleNow: number;
}

const brandSummaries: BrandSummary[] = [...groups.entries()]
  .filter(([, products]) => isBrandPageIndexable(countIndexableBrandProducts(products)))
  .map(([brand]) => ({
    brand,
    slug: slugifyProduct(brand),
    tracked: stats.get(brand)!.tracked,
    onSaleNow: stats.get(brand)!.onSaleNow,
  }))
  .sort((a, b) => a.brand.localeCompare(b.brand));

const pageTitle = 'Browse Plugin Deals by Brand | PluginDrop';
const pageDescription = `Browse tracked VST/AU plugin prices and deals by manufacturer — ${brandSummaries.length} brands, updated daily.`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <style>
      main { max-width: 960px; margin: 0 auto; padding: 2rem 1rem 3rem; }

      .breadcrumb { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.5rem; }
      .breadcrumb a { color: var(--text-muted); text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .breadcrumb .sep { margin: 0 0.4rem; }

      h1 {
        font-size: clamp(1.6rem, 4.5vw, 2.4rem); font-weight: 800; margin: 0 0 0.85rem;
        line-height: 1.2; color: var(--text-primary);
      }
      .page-intro { color: var(--text-secondary); font-size: 1rem; line-height: 1.6; margin: 0 0 2rem; }

      .brand-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem;
      }
      .brand-card {
        display: block; background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.1rem 1.25rem; text-decoration: none;
        transition: border-color 0.15s, background 0.15s;
      }
      .brand-card:hover { border-color: var(--accent); background: var(--bg-card-hover); }
      .brand-name { color: var(--text-primary); font-weight: 700; font-size: 1rem; margin: 0 0 0.4rem; }
      .brand-meta { color: var(--text-muted); font-size: 0.8rem; margin: 0; }
      .brand-meta .sale-flag { color: var(--sale-text); font-weight: 700; }

      .trust-line {
        margin-top: 2.5rem; padding: 1rem 1.25rem; border-left: 3px solid var(--accent-muted);
        color: var(--text-muted); font-size: 0.82rem; line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="sr-only">Skip to content</a>
    <Header />
    <main id="main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <span>Brands</span>
      </nav>

      <h1>Browse Plugin Deals by Brand</h1>
      <p class="page-intro">
        We track {brandSummaries.length} plugin manufacturers. Pick a brand to see every product's current price, typical sale price, and lowest price recorded.
      </p>

      <p class="page-intro">This directory groups every plugin in our price tracker by manufacturer. A brand is listed once it has enough tracked products to give a useful picture of its pricing. Each brand page shows list prices, typical sale prices, and the lowest price we have recorded for each product, and the count on each card shows how many products are currently priced below their regular price. The data comes from PluginDrop's own price tracking, which records prices from vendor and manufacturer product pages and sale announcements. Brand listings describe what we track; they are not rankings or recommendations. See <a href="/how-we-track-prices/">how we track prices</a> for the methodology and its limits.</p>

      <div class="brand-grid">
        {brandSummaries.map((b) => (
          <section class="brand-group"><a href={`/brands/${b.slug}/`} class="brand-card">
            <p class="brand-name">{b.brand}</p>
            <p class="brand-meta">
              {b.tracked} products tracked<span class="sale-flag"> · {b.onSaleNow} on sale now</span>
            </p>
          </a><div class="deal-grid">{cards.filter(card => card.brand === b.brand && card.image.src).slice(0, 2).map(card => <DealCard deal={card} variant="compact" />)}</div></section>
        ))}
      </div>

      <p class="trust-line">Prices checked daily. Automated tracking since <span data-tracking-since={trackingSince ?? ''}>{trackingSince}</span>.</p>
    </main>
    <Footer />
  </body>
</html>
<style>.brand-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.brand-group{min-width:0}.brand-card{margin-bottom:.5rem}.deal-grid{display:grid;gap:.5rem}@media(max-width:680px){.brand-grid{grid-template-columns:1fr}}</style>
