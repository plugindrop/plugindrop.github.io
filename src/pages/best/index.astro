---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import manifestRaw from '../../data/programmatic_pages.json';
import priceData from '../../data/price_history.json';
import { rowsFor, sortRows, type ProgrammaticManifest, type ProgrammaticPriceData } from '../../lib/programmaticUtils';

const manifest = manifestRaw as ProgrammaticManifest;
const data = priceData as ProgrammaticPriceData;
const categories = manifest.categories
  .filter((c) => c.status === 'published')
  .map((c) => ({ ...c, rows: sortRows(rowsFor(c.products, data)) }))
  .sort((a, b) => b.rows.length - a.rows.length || a.label.localeCompare(b.label));

const pageTitle = `Best Plugin Deals by Category — Live Price Verdicts | ${SITE_TITLE}`;
const pageDescription = `Browse ${categories.length} plugin categories with live, tracked price verdicts — updated from our own price history, not press releases.`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <style>
      main { max-width: 960px; margin: 0 auto; padding: 2rem 1rem 3rem; }

      .breadcrumb { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.5rem; }
      .breadcrumb a { color: var(--text-muted); text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .breadcrumb .sep { margin: 0 0.4rem; }

      h1 {
        margin: 0 0 0.85rem; color: var(--text-primary); font-family: var(--font-display);
        font-size: clamp(1.6rem, 4.5vw, 2.4rem); font-weight: 400; line-height: 1.2;
      }
      .page-intro { margin: 0 0 2rem; color: var(--text-secondary); font-size: 1rem; line-height: 1.6; }

      .category-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
      .category-card {
        display: block; padding: 1.1rem 1.25rem; color: var(--text-primary); background: var(--bg-card);
        border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none;
        transition: border-color 0.15s, background 0.15s;
      }
      .category-card:hover { background: var(--bg-card-hover); border-color: var(--accent); }
      .category-name { margin: 0 0 0.4rem; color: var(--text-primary); font-size: 1rem; font-weight: 700; }
      .category-meta { margin: 0; color: var(--text-muted); font-size: 0.8rem; }
      .category-sale { color: var(--sale-text); font-weight: 700; }

      .trust-line {
        margin-top: 2.5rem; padding: 1rem 1.25rem; color: var(--text-muted);
        border-left: 3px solid var(--accent-muted); font-size: 0.82rem; line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="sr-only">Skip to content</a>
    <Header />
    <main id="main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <span>Best</span>
      </nav>

      <h1>Best plugin deals, by category</h1>
      <p class="page-intro">Live price verdicts recalculated from our own tracker on every update — not a one-time "best of" list.</p>

      <div class="category-grid">
        {categories.map((category) => {
          const onSaleCount = category.rows.filter((r) => r.hasLiveDrop).length;
          return (
            <a href={`/best/${category.slug}/`} class="category-card">
              <p class="category-name">{category.label}</p>
              <p class="category-meta">
                {category.rows.length} tracked
                {onSaleCount > 0 && <> · <span class="category-sale">{onSaleCount} on sale</span></>}
              </p>
            </a>
          );
        })}
      </div>

      <p class="trust-line">Prices checked daily. Data since Apr 2026.</p>
    </main>
    <Footer />
  </body>
</html>
