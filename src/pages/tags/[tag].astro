---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const slugifyTag = (t: string): string => t.trim().toLowerCase().replace(/\s+/g, '-');

export async function getStaticPaths() {
	const _slugify = (t: string) => t.trim().toLowerCase().replace(/\s+/g, '-');
	const posts = await getCollection('blog');
	// Map from slug → original tag for filtering
	const tagSlugMap = new Map<string, string>();
	for (const post of posts) {
		for (const tag of (post.data.tags ?? [])) {
			if (tag && tag.trim()) {
				const slug = _slugify(tag);
				if (!tagSlugMap.has(slug)) tagSlugMap.set(slug, tag.trim().toLowerCase());
			}
		}
	}
	return [...tagSlugMap.entries()].map(([slug, _rawTag]) => ({
		params: { tag: slug },
		props: { tag: slug },
	}));
}

const { tag } = Astro.props;

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter(p => !p.data.draft && (p.data.tags ?? []).some((t: string) => slugifyTag(t) === tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagDisplay = tag.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());

// タグ別に最適化されたタイトル・ディスクリプション
const TAG_META: Record<string, { title: string; desc: string }> = {
	'free':             { title: 'Free VST Plugins & Sample Packs', desc: 'Download free VST plugins, sample packs, and presets. Updated daily with the latest free music production tools.' },
	'sale':             { title: 'VST Plugin Sales & Deals', desc: 'Best VST plugin sales and discounts. Save on synths, effects, sample packs, and more — updated daily.' },
	'vst-plugin':       { title: 'VST Plugin Deals', desc: 'The best VST plugin deals, discounts, and free downloads for music producers. Verified daily.' },
	'vst':              { title: 'VST Plugin Guides & Reviews 2026', desc: 'In-depth VST plugin guides, reviews, and comparisons for music producers. Tested and ranked by category.' },
	'synth':            { title: 'Synth Plugin Deals & Free Downloads', desc: 'Best deals on synthesizer plugins including wavetable, analog, and FM synths. Free and paid options.' },
	'reverb':           { title: 'Reverb Plugin Deals', desc: 'Top reverb plugin deals and free downloads. Plate, hall, room, and convolution reverbs for music production.' },
	'eq':               { title: 'EQ Plugin Deals', desc: 'Best equalizer plugin deals. Parametric, dynamic, and graphic EQs for mixing and mastering.' },
	'compressor':       { title: 'Compressor Plugin Deals', desc: 'Top compressor and dynamics plugin deals for mixing and mastering. Free and discounted options.' },
	'drums':            { title: 'Drum Plugin & Sample Pack Deals', desc: 'Best drum machine plugins, drum sample packs, and beat-making tools on sale or free.' },
	'sample-pack':      { title: 'Sample Pack Deals & Free Downloads', desc: 'Best sample pack deals — loops, one-shots, construction kits for hip-hop, electronic, and more.' },
	'preset-pack':      { title: 'Preset Pack Deals', desc: 'Top VST preset packs on sale or free. Serum, Massive, Omnisphere presets for any style.' },
	'bundle':           { title: 'Plugin Bundle Deals', desc: 'Best plugin bundle deals — get multiple plugins at a fraction of the price. Sales updated daily.' },
	'mixing':           { title: 'Mixing Plugin Deals', desc: 'Top mixing plugin deals — channel strips, saturators, metering tools, and more on sale.' },
	'mastering':        { title: 'Mastering Plugin Deals', desc: 'Best mastering plugin deals — limiters, stereo wideners, and mastering chains at discounted prices.' },
	'effects':          { title: 'Audio Effects Plugin Deals', desc: 'Creative audio effects plugins on sale — chorus, flanger, bitcrusher, and more.' },
	'guitar':           { title: 'Guitar & Amp Sim Plugin Deals', desc: 'Best guitar amp simulator and effects plugin deals for producers and guitarists.' },
	'serum':            { title: 'Serum Preset Deals & Free Downloads', desc: 'Best Xfer Serum preset packs on sale or free. Expand your Serum sound library.' },
	'music-production': { title: 'Music Production Plugin Deals', desc: 'Daily deals on music production plugins, sample packs, and tools for producers at every level.' },
	'guide':            { title: 'VST Plugin Guides & Comparisons 2026', desc: 'In-depth guides covering the best VST plugins for mixing, mastering, synthesis, and music production. Ranked by producers.' },
	'review':           { title: 'VST Plugin Reviews 2026 — Tested & Ranked', desc: 'Honest VST plugin reviews for 2026. Tested in real sessions and ranked against competitors at every price point.' },
	'instruments':      { title: 'Virtual Instrument Plugin Deals 2026', desc: 'Best virtual instrument plugin deals — pianos, strings, brass, orchestral libraries, and synths on sale or free.' },
	'alternatives':     { title: 'Free Alternatives to Popular VST Plugins', desc: 'Best free alternatives to expensive VST plugins. Find free substitutes for Serum, Kontakt, Valhalla, FabFilter, and more.' },
	'tutorials':        { title: 'VST Plugin Tutorials & How-To Guides 2026', desc: 'Step-by-step guides on how to use VST plugins for mixing, mastering, compression, EQ, reverb, and more.' },
	'vocals':           { title: 'Vocal Processing Plugin Guides & Deals', desc: 'Best vocal plugins for pitch correction, EQ, compression, and reverb. Free and paid options tested in 2026.' },
	'bass':             { title: 'Bass Plugin Guides & Deals 2026', desc: 'Best VST plugins for bass guitar and bass synths — EQ, compression, saturation, and enhancement. Tested and ranked.' },
	'ableton':          { title: 'Best Plugins for Ableton Live 2026', desc: 'Top VST plugins compatible with Ableton Live — synths, effects, and tools tested with Ableton Live 11 and 12.' },
	'fl-studio':        { title: 'Best Plugins for FL Studio 2026', desc: 'Top VST plugins for FL Studio — synths, effects, and samples tested for compatibility and workflow in FL Studio 21.' },
	'daw-specific':     { title: 'DAW-Specific Plugin Guides 2026', desc: 'Plugin guides and recommendations tailored to specific DAWs including Ableton, FL Studio, Logic Pro, and Reaper.' },
	'techno':           { title: 'Best Plugins for Techno Production 2026', desc: 'Top VST plugins for techno — synths, effects, and mixing tools used by techno producers. Free and paid options.' },
	'house':            { title: 'Best Plugins for House Music Production 2026', desc: 'Best VST plugins for house music — synths, samples, and effects for deep house, tech house, and progressive house.' },
	'metal':            { title: 'Best VST Plugins for Metal Mixing 2026', desc: 'Top plugins for metal production — amp sims, drum replacers, EQ, and mastering tools. Tested for extreme music.' },
	'film-scoring':     { title: 'Best Plugins for Film Scoring & Cinematic Music 2026', desc: 'Top orchestral libraries and plugins for film scoring, game audio, and cinematic music production.' },
	'orchestral':       { title: 'Best Orchestral VST Plugins & Libraries 2026', desc: 'Top orchestral sample libraries and virtual instruments for composers and film scorers. Free and premium options.' },
	'lo-fi':            { title: 'Best Plugins for Lo-Fi Music Production 2026', desc: 'Best VST plugins for lo-fi beats and chill production — vinyl, tape, and degradation effects. Free and paid picks.' },
};
const meta = TAG_META[tag] ?? {
	title: `${tagDisplay} Deals & Plugins`,
	desc: `Browse the best ${tagDisplay} plugin deals, free downloads, and discounts on PluginDrop. Updated daily.`,
};
const pageTitle = meta.title;
const pageDesc = meta.desc;

const breadcrumbLD = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).href },
		{ "@type": "ListItem", "position": 2, "name": "Deals", "item": new URL("/posts", Astro.site).href },
		{ "@type": "ListItem", "position": 3, "name": tagDisplay },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${pageTitle} | ${SITE_TITLE}`} description={pageDesc} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />
		<style>
			main { max-width: 960px; margin: 0 auto; padding: 2rem 1rem; }
			.tag-header { margin-bottom: 2rem; }
			.tag-header h1 { font-size: 1.8rem; font-weight: 700; margin: 0 0 0.5rem; }
			.tag-header p { color: var(--text-muted); font-size: 0.95rem; margin: 0; }
			.post-list { display: flex; flex-direction: column; gap: 1rem; }
			.post-card {
				display: flex; gap: 1rem; align-items: flex-start;
				padding: 1rem; border: 1px solid var(--border);
				border-radius: var(--radius); background: var(--bg-card);
				text-decoration: none; color: inherit;
				transition: border-color 0.15s;
			}
			.post-card:hover { border-color: var(--accent); }
			.post-thumb {
				width: 120px; height: 68px; object-fit: cover;
				border-radius: 4px; flex-shrink: 0;
			}
			.post-info { flex: 1; }
			.post-title { font-size: 0.95rem; font-weight: 600; margin: 0 0 0.3rem; line-height: 1.3; }
			.post-meta { font-size: 0.8rem; color: var(--text-muted); }
			.post-price { font-weight: 700; color: var(--accent); margin-left: 0.5rem; }
			.breadcrumb { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.5rem; }
			.breadcrumb a { color: var(--text-muted); text-decoration: none; }
			.breadcrumb a:hover { text-decoration: underline; }
			.sep { margin: 0 0.4rem; }
			.empty { color: var(--text-muted); font-size: 0.95rem; }
		</style>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a><span class="sep">/</span>
				<a href="/posts">Deals</a><span class="sep">/</span>
				<span>{tagDisplay}</span>
			</nav>
			<div class="tag-header">
				<h1>{pageTitle}</h1>
				<p>{posts.length} deal{posts.length !== 1 ? 's' : ''} found</p>
			</div>
			{posts.length === 0 ? (
				<p class="empty">No deals found for this tag.</p>
			) : (
				<ul class="post-list" role="list">
					{posts.map(post => (
						<li>
							<a href={`/posts/${post.id.replace(/\.mdx?$/, '')}/`} class="post-card">
								{post.data.heroImage && (
									<img src={post.data.heroImage} alt="" loading="lazy" width="120" height="68" class="post-thumb" />
								)}
								<div class="post-info">
									<p class="post-title">{post.data.title}</p>
									<span class="post-meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.dealPrice && <span class="post-price">{post.data.dealPrice}</span>}
									</span>
								</div>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>
