---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import priceData from '../../data/price_history.json';
import { pdAttr } from '../../lib/interestTaxonomy.mjs';
import productVideosRaw from '../../data/product_videos.json';
import { latestCheckedDate, formatCheckedDate, dealScoreNumeric } from '../../lib/priceUtils';
import { getCollection } from 'astro:content';

const AFF = "a_aid=69cb95abe1763";
const pbLink = (path: string | null | undefined) =>
  !path ? '#' : path.startsWith('http') ? path : `https://www.pluginboutique.com${path}?${AFF}`;

interface HistoryEntry {
  date: string;
  regular: number | null;
  sale: number | null;
  source: string;
}

interface EntryData {
  pb_url: string;
  typical_regular: number | null;
  typical_sale: number | null;
  all_time_low: number | null;
  notes?: string;
  category?: string;
  history: HistoryEntry[];
}

interface PriceData {
  last_updated: string;
  bundles: Record<string, EntryData>;
  plugins?: Record<string, EntryData>;
}

interface StaticEntry {
  name: string;
  kind: 'plugin' | 'bundle';
  entry: EntryData;
  guides: Array<{ title: string; slug: string }>;
}

const data = priceData as PriceData;
const pluginEntries = data.plugins ?? {};
const bundleEntries = data.bundles ?? {};

function slugify(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function allStaticEntries(): StaticEntry[] {
  const rows: StaticEntry[] = [];
  for (const [name, entry] of Object.entries(pluginEntries)) rows.push({ name, kind: 'plugin', entry, guides: [] });
  for (const [name, entry] of Object.entries(bundleEntries)) rows.push({ name, kind: 'bundle', entry, guides: [] });
  return rows;
}

export async function getStaticPaths() {
  function _slugify(n: string): string {
    return n
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }
  const _data = priceData as PriceData;
  const _plugins = _data.plugins ?? {};
  const _bundles = _data.bundles ?? {};

  const allPosts = await getCollection('blog', (p) => !p.data.draft);

  function findGuides(productName: string): Array<{ title: string; slug: string }> {
    const words = productName.toLowerCase().split(/[\s\-\/]+/).filter((w) => w.length >= 4);
    if (words.length === 0) return [];
    return allPosts
      .filter((p) => {
        const title = p.data.title.toLowerCase();
        return words.some((w) => title.includes(w));
      })
      .sort((a, b) => {
        const sa = ((a.data as Record<string, unknown>).score as number) ?? 0;
        const sb = ((b.data as Record<string, unknown>).score as number) ?? 0;
        return sb - sa;
      })
      .slice(0, 5)
      .map((p) => ({ title: p.data.title, slug: p.id }));
  }

  const rows: StaticEntry[] = [];
  for (const [n, e] of Object.entries(_plugins)) rows.push({ name: n, kind: 'plugin', entry: e, guides: [] });
  for (const [n, e] of Object.entries(_bundles)) rows.push({ name: n, kind: 'bundle', entry: e, guides: [] });

  return rows.map(({ name, kind, entry }) => ({
    params: { slug: _slugify(name) },
    props: { name, kind, entry, guides: findGuides(name) },
  }));
}

const { name, kind, entry, guides } = Astro.props as StaticEntry;
const { slug } = Astro.params;

// Verified demo video for this product (built by build_product_videos.py from
// already-audited article embeds; only high-confidence matches are included).
interface ProductVideo { video_id: string; title: string; channel: string }
const productVideos = productVideosRaw as Record<string, ProductVideo>;
const demoVideo: ProductVideo | null = productVideos[name] ?? null;

// --- Price helpers -----------------------------------------------------
// "Current" price follows the same rule the ledger page uses: sale price
// when we have one, otherwise the regular price. Never fabricated.
function currentPrice(e: EntryData): number | null {
  return e.typical_sale ?? e.typical_regular ?? null;
}
function isOnSale(e: EntryData): boolean {
  return e.typical_sale !== null && e.typical_regular !== null && e.typical_sale < e.typical_regular;
}
function pctOff(sale: number | null, regular: number | null): number {
  if (sale === null || regular === null || regular <= 0 || sale >= regular) return 0;
  return Math.round((1 - sale / regular) * 100);
}
function formatPrice(val: number | null): string {
  return val === null ? '—' : `$${val}`;
}

const category = entry.category ?? (kind === 'bundle' ? 'Plugin Bundle' : 'Plugin');
const current = currentPrice(entry);
const regular = entry.typical_regular;
const onSale = isOnSale(entry);
const off = onSale ? pctOff(entry.typical_sale, entry.typical_regular) : 0;

// --- Verdict line --------------------------------------------------------
function verdictLine(e: EntryData): string {
  if (e.all_time_low === null) {
    return "No discount on record yet — we're watching for sales.";
  }
  if (e.typical_sale !== null && e.typical_regular !== null && e.typical_sale < e.typical_regular) {
    const p = pctOff(e.typical_sale, e.typical_regular);
    return `Typically drops to $${e.typical_sale} (~${p}% off) during sales.`;
  }
  if (e.notes) return e.notes;
  return `Lowest price we've tracked so far is $${e.all_time_low}.`;
}
const verdict = verdictLine(entry);
const dealScore = dealScoreNumeric(entry);

// --- Lowest tracked price + date ------------------------------------------
function findLowestDate(e: EntryData): string | null {
  if (e.all_time_low === null) return null;
  const match = e.history.find((h) => (h.sale ?? h.regular) === e.all_time_low);
  return match ? match.date : null;
}
const lowestDate = findLowestDate(entry);

// --- Provenance: when we actually last scraped this product (D4) --------
const checkedDate = latestCheckedDate(entry);
const checkedLabel = checkedDate ? `Last checked: ${formatCheckedDate(checkedDate)}` : 'Tracking since 2026 — no price data yet';

// --- Price history chart ---------------------------------------------------
// Real price-tracker data (Keepa/SteamDB) is a dense daily series. Ours is not:
// each product only has a handful of logged observations plus a couple of
// summary reference values (typical_regular / all_time_low). The chart below
// is built honestly from exactly what we have — no interpolation, no invented
// data points — and refuses to render a misleading line when there isn't
// enough history to plot one (see emptyStateText below).

interface SeriesPoint {
  date: string;
  value: number;
  isSale: boolean;
  isLowest: boolean;
}

function toTimestamp(d: string): number {
  return new Date(`${d}T00:00:00Z`).getTime();
}

function formatShortDate(d: string): string {
  // Full 4-digit year: "Jul 26" reads as "July 26th" when it actually means
  // July 2026 — "Jul 2026" is unambiguous on the x-axis.
  return new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

// Build the plotted series from every dated observation we actually have:
// logged history points, plus today's current price. If the all-time-low
// happens to match a logged history point, that point is flagged so it can
// be highlighted — we never fabricate a date for it.
function buildPriceSeries(e: EntryData, lastUpdated: string): SeriesPoint[] {
  const byDate = new Map<string, SeriesPoint>();

  for (const h of e.history) {
    const value = h.sale ?? h.regular;
    if (value === null) continue;
    byDate.set(h.date, {
      date: h.date,
      value,
      isSale: h.sale !== null,
      isLowest: e.all_time_low !== null && value === e.all_time_low,
    });
  }

  const cur = currentPrice(e);
  if (cur !== null) {
    const curDate = lastUpdated || '2026-07-11';
    if (!byDate.has(curDate)) {
      byDate.set(curDate, {
        date: curDate,
        value: cur,
        isSale: isOnSale(e),
        isLowest: e.all_time_low !== null && cur === e.all_time_low,
      });
    }
  }

  return [...byDate.values()].sort((a, b) => toTimestamp(a.date) - toTimestamp(b.date));
}

interface PlottedPoint extends SeriesPoint {
  x: number;
  y: number;
}
interface AxisTick {
  pos: number;
  label: string;
}
interface ChartGeom {
  width: number;
  height: number;
  padX: number;
  padTop: number;
  padBottom: number;
  points: PlottedPoint[];
  stepPath: string;
  areaPath: string;
  yTicks: AxisTick[];
  xTicks: AxisTick[];
  regularY: number | null;
  lowestY: number | null;
}

// Reference lines (regular / lowest-tracked) are folded into the value range
// so they always fit on the chart with room for their labels, even if the
// logged history never actually touched those values.
function buildChartGeom(series: SeriesPoint[], regularVal: number | null, lowestVal: number | null): ChartGeom | null {
  if (series.length < 2) return null;

  const width = 760;
  const height = 280;
  const padX = 46;
  const padTop = 26;
  const padBottom = 34;
  const innerW = width - padX * 2;
  const innerH = height - padTop - padBottom;

  const times = series.map((p) => toTimestamp(p.date));
  const minT = Math.min(...times);
  const maxT = Math.max(...times);
  const spanT = maxT - minT || 1;

  const values = series.map((p) => p.value);
  const rangeCandidates = [...values];
  if (regularVal !== null) rangeCandidates.push(regularVal);
  if (lowestVal !== null) rangeCandidates.push(lowestVal);
  const rawMin = Math.min(...rangeCandidates);
  const rawMax = Math.max(...rangeCandidates);
  const rawRange = rawMax - rawMin || Math.max(rawMax * 0.1, 10);
  const pad = rawRange * 0.18;
  const yMin = Math.max(0, rawMin - pad);
  const yMax = rawMax + pad;
  const yRange = yMax - yMin || 1;

  const xForT = (t: number) => padX + ((t - minT) / spanT) * innerW;
  const yForV = (v: number) => padTop + innerH * (1 - (v - yMin) / yRange);

  const points: PlottedPoint[] = series.map((p) => ({
    ...p,
    x: xForT(toTimestamp(p.date)),
    y: yForV(p.value),
  }));

  // Step-after line: price holds flat at the old value until the next
  // observation, then steps — this is how real price trackers draw sparse
  // data, and it doesn't invent a diagonal trend between two unrelated points.
  let stepPath = `M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`;
  for (let i = 1; i < points.length; i++) {
    const prev = points[i - 1];
    const p = points[i];
    stepPath += ` L ${p.x.toFixed(1)} ${prev.y.toFixed(1)} L ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
  }
  const rightEdge = width - padX;
  const lastPoint = points[points.length - 1];
  if (rightEdge > lastPoint.x) {
    // Hold the current price through to "today" on the right edge.
    stepPath += ` L ${rightEdge.toFixed(1)} ${lastPoint.y.toFixed(1)}`;
  }

  const baseline = height - padBottom;
  const areaPath = `${stepPath} L ${rightEdge.toFixed(1)} ${baseline.toFixed(1)} L ${points[0].x.toFixed(1)} ${baseline.toFixed(1)} Z`;

  const tickCount = 4;
  const yTicks: AxisTick[] = Array.from({ length: tickCount }, (_, i) => {
    const v = yMin + (yRange * i) / (tickCount - 1);
    return { pos: yForV(v), label: `$${Math.round(v)}` };
  });

  const maxXTicks = Math.min(5, points.length);
  const tickIdxs = new Set<number>();
  for (let i = 0; i < maxXTicks; i++) {
    tickIdxs.add(Math.round((i * (points.length - 1)) / Math.max(1, maxXTicks - 1)));
  }
  const xTicks: AxisTick[] = [...tickIdxs]
    .sort((a, b) => a - b)
    .map((idx) => ({ pos: points[idx].x, label: formatShortDate(points[idx].date) }));

  return {
    width,
    height,
    padX,
    padTop,
    padBottom,
    points,
    stepPath,
    areaPath,
    yTicks,
    xTicks,
    regularY: regularVal !== null ? yForV(regularVal) : null,
    lowestY: lowestVal !== null ? yForV(lowestVal) : null,
  };
}

function emptyStateText(e: EntryData): string {
  let s = 'Not enough price history yet — we started tracking in 2026.';
  if (e.typical_regular !== null) {
    s += ` Regular $${e.typical_regular}`;
    s += e.typical_sale !== null ? `; typically drops to $${e.typical_sale} on sale.` : '.';
  }
  return s;
}

const series = buildPriceSeries(entry, data.last_updated);
const chartGeom = buildChartGeom(series, entry.typical_regular, entry.all_time_low);

// --- FAQ -------------------------------------------------------------------
function faqSaleAnswer(e: EntryData): string {
  if (e.typical_sale !== null && e.typical_regular !== null && e.typical_sale < e.typical_regular) {
    const p = pctOff(e.typical_sale, e.typical_regular);
    return `Yes — it typically drops to $${e.typical_sale} (about ${p}% off the $${e.typical_regular} list price) during sales.`;
  }
  if (e.all_time_low === null) {
    return `Not that we've recorded — we've been tracking ${name} since 2026 and haven't logged a discount yet.`;
  }
  return `Occasionally. ${e.notes ?? `The lowest price we've tracked is $${e.all_time_low}.`}`;
}
function faqLowestAnswer(e: EntryData): string {
  if (e.all_time_low === null) {
    return `No discount recorded for ${name} yet — we're watching for sales.`;
  }
  return lowestDate
    ? `The lowest price we've tracked for ${name} is $${e.all_time_low}, recorded on ${lowestDate}.`
    : `The lowest price we've tracked for ${name} is $${e.all_time_low}.`;
}
function faqAvailabilityAnswer(e: EntryData): string {
  if (!e.pb_url) return `We don't currently have a Plugin Boutique link for ${name}.`;
  return `Yes — ${name} is sold through Plugin Boutique, currently listed around ${formatPrice(current)}${onSale ? ' (on sale)' : ''}.`;
}

const faqs = [
  { q: `Does ${name} go on sale?`, a: faqSaleAnswer(entry) },
  { q: `What's the lowest price for ${name}?`, a: faqLowestAnswer(entry) },
  { q: `Is ${name} available on Plugin Boutique?`, a: faqAvailabilityAnswer(entry) },
];

// --- Cheaper alternatives ----------------------------------------------------
const otherEntries = allStaticEntries().filter((e) => e.name !== name);
const selfCategory = entry.category ?? null;
let pool = otherEntries;
if (selfCategory) {
  const sameCategory = otherEntries.filter((e) => (e.entry.category ?? null) === selfCategory);
  if (sameCategory.length > 0) pool = sameCategory;
}
const withPrices = pool
  .map((e) => ({ ...e, price: currentPrice(e.entry) }))
  .filter((e): e is StaticEntry & { price: number } => e.price !== null)
  .sort((a, b) => a.price - b.price);

const cheaperThanSelf = current !== null ? withPrices.filter((e) => e.price < current) : [];
const alternatives = (cheaperThanSelf.length >= 2 ? cheaperThanSelf : withPrices).slice(0, 3);

// --- Meta / JSON-LD -----------------------------------------------------------
const pageTitle = `${name} Price History & Best Price 2026 | ${SITE_TITLE}`;
const pageDescription = current !== null
  ? `${name} price history: currently ${formatPrice(current)}${regular !== null && onSale ? ` (regular ${formatPrice(regular)})` : ''}${entry.all_time_low !== null ? `, lowest tracked ${formatPrice(entry.all_time_low)}` : ''}. See when ${name} typically goes on sale at Plugin Boutique.`
  : `Price history and sale tracking for ${name} at Plugin Boutique — updated regularly.`;

const productLD: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": name,
  "category": category,
};
// Offer schema は「7日以内の実測観測」がある場合のみ出す。typical値を
// Google に「現在の販売価格」として渡さない（Live Drops と同じ鮮度規律）。
const freshObs = (() => {
  const obs = entry.history
    .filter((h) => h.source === 'auto_check' && (h.sale ?? h.regular) !== null)
    .sort((a, b) => (a.date < b.date ? -1 : 1))
    .at(-1);
  if (!obs) return null;
  const age = Date.now() - new Date(`${obs.date}T00:00:00Z`).getTime();
  return age >= 0 && age <= 7 * 86400000 ? (obs.sale ?? obs.regular) : null;
})();
if (freshObs !== null && entry.pb_url) {
  productLD.offers = {
    "@type": "Offer",
    "price": freshObs,
    "priceCurrency": "USD",
    "url": pbLink(entry.pb_url),
    "availability": "https://schema.org/InStock",
  };
}

const faqLD = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
		{pdAttr({ title: name, extra: entry.category ?? '' }) && <meta name="pd-interests" content={pdAttr({ title: name, extra: entry.category ?? '' })} />}
    <script type="application/ld+json" set:html={JSON.stringify(productLD)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLD)} />
    <style>
      main { max-width: 960px; margin: 0 auto; padding: 2rem 1rem 3rem; }

      .breadcrumb { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.5rem; }
      .breadcrumb a { color: var(--text-muted); text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .breadcrumb .sep { margin: 0 0.4rem; }

      /* Above the fold */
      .product-header { margin-bottom: 2.5rem; }
      .category-tag {
        display: inline-block; padding: 0.25rem 0.65rem; border-radius: 4px;
        background: var(--tag-bg); color: var(--tag-text);
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.06em; margin-bottom: 0.85rem;
      }
      .product-header h1 {
        font-size: clamp(1.8rem, 5vw, 2.6rem); font-weight: 800; margin: 0 0 1rem;
        line-height: 1.15; color: var(--text-primary);
      }
      .price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.85rem; margin-bottom: 0.5rem; }
      .price-current {
        font-size: 2rem; font-weight: 800; color: var(--text-primary);
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }
      .price-current.on-sale { color: var(--sale-text); }
      .price-regular-strike {
        text-decoration: line-through; color: var(--text-muted); font-weight: 500;
        font-size: 1.2rem; font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }
      .off-badge {
        display: inline-block; padding: 0.2rem 0.6rem; border-radius: 4px;
        background: var(--sale-bg); color: var(--sale-text);
        font-weight: 700; font-size: 0.8rem; white-space: nowrap;
      }
      .last-checked { font-size: 0.78rem; color: var(--text-muted); margin: 0 0 1.5rem; }

      .verdict-box {
        display: flex; gap: 0.75rem; align-items: flex-start;
        background: var(--bg-card); border-left: 3px solid var(--accent);
        border-radius: var(--radius); padding: 1rem 1.25rem; margin-bottom: 1.75rem;
      }
      .verdict-icon { flex-shrink: 0; font-size: 1.1rem; line-height: 1.4; }
      .verdict-label {
        font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--text-muted); font-weight: 700; margin: 0 0 0.35rem;
      }
      .verdict-text { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.55; margin: 0; }
      .score-badge {
        display: inline-flex; min-width: 2rem; align-items: center; justify-content: center;
        padding: 0.18rem 0.4rem; border-radius: var(--radius-sm); color: var(--bg-base);
        font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700;
      }
      .score-badge.good { background: var(--verdict-good); }
      .score-badge.ok { background: var(--verdict-ok); }
      .score-badge.bad { background: var(--verdict-bad); }
      .score-none { color: var(--text-muted); font-family: var(--font-mono); }

      .cta-row { display: flex; flex-wrap: wrap; gap: 0.85rem; }
      .cta-primary, .cta-secondary {
        display: inline-block; padding: 0.75rem 1.5rem; border-radius: 8px;
        font-weight: 700; font-size: 0.9rem; text-decoration: none; text-align: center;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
      }
      .cta-primary { background: var(--accent); color: #0b0e0d; }
      .cta-primary:hover { background: var(--accent-light); }
      .cta-secondary { border: 1px solid var(--border); color: var(--text-secondary); }
      .cta-secondary:hover { border-color: var(--accent); color: var(--accent); }

      /* Section titles */
      h2.section-title {
        font-size: 1.25rem; font-weight: 800; margin: 0 0 0.4rem; color: var(--text-primary);
      }
      .section-sub { font-size: 0.82rem; color: var(--text-muted); margin: 0 0 1.25rem; }
      section.page-section { margin: 3rem 0; }

      /* Chart */
      .chart-card {
        position: relative;
        background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 1.5rem; overflow-x: auto; -webkit-overflow-scrolling: touch;
      }
      .price-chart { display: block; width: 100%; min-width: 480px; height: auto; }
      .chart-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.1rem;
        align-items: center;
        margin: 0.55rem 0 0;
        font-size: 0.72rem;
        color: var(--text-muted);
      }
      .legend-item { display: inline-flex; align-items: center; gap: 0.35rem; }
      .legend-dot {
        width: 9px; height: 9px; border-radius: 50%; display: inline-block;
        border: 1.5px solid var(--bg-card);
      }
      .legend-dot-normal { background: var(--accent); }
      .legend-dot-sale { background: var(--sale-text); }
      .legend-dash {
        width: 18px; height: 0; display: inline-block;
        border-top: 2px dashed var(--text-muted); opacity: 0.7;
      }
      .legend-note { opacity: 0.8; }
      .video-embed iframe {
        aspect-ratio: 16 / 9;
        width: 100%;
        max-width: 100%;
        border: 0;
        border-radius: var(--radius);
        display: block;
      }
      .video-caption { font-size: 0.78rem; color: var(--text-muted); margin: 0.45rem 0 0; }
      .price-chart .grid-line { stroke: var(--bg-highest); stroke-width: 1; }
      .price-chart .axis-label {
        fill: var(--text-muted); font-size: 10px; font-family: var(--font-body, inherit);
      }
      .price-chart .y-label { text-anchor: end; }
      .price-chart .x-label { text-anchor: middle; }
      .price-chart .ref-line { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; opacity: 0.5; }
      .price-chart .ref-line.ref-lowest { stroke: var(--sale-text); opacity: 0.55; }
      .price-chart .ref-label { font-size: 10px; text-anchor: end; }
      .price-chart .ref-label.ref-regular-label { fill: var(--text-muted); }
      .price-chart .ref-label.ref-lowest-label { fill: var(--sale-text); }
      .price-chart .crosshair { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 3 3; pointer-events: none; }
      .price-chart .hover-dot { fill: var(--bg-card); stroke: var(--accent); stroke-width: 2; pointer-events: none; }
      .price-chart .price-point { stroke: var(--bg-card); stroke-width: 1.5; }
      .price-chart .overlay-rect { fill: transparent; cursor: crosshair; }

      .chart-tooltip {
        position: absolute; top: 0; left: 0; opacity: 0; pointer-events: none;
        background: var(--bg-highest); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 0.5rem 0.7rem; font-size: 0.78rem; color: var(--text-primary);
        white-space: nowrap; z-index: 5; transition: opacity 0.1s ease;
      }
      .chart-tooltip .tt-date { color: var(--text-muted); font-size: 0.7rem; margin-bottom: 0.15rem; }
      .chart-tooltip .tt-price {
        font-weight: 800; font-size: 0.95rem;
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }
      .chart-tooltip .tt-label { font-size: 0.7rem; color: var(--accent); margin-top: 0.15rem; }
      .chart-tooltip .tt-label.tt-sale { color: var(--sale-text); }

      .chart-empty {
        color: var(--text-muted); font-size: 0.9rem; text-align: left; line-height: 1.6;
        padding: 1.25rem 1.5rem; background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius); margin: 0;
      }
      .chart-empty .chart-empty-price {
        display: block; font-size: 1.4rem; font-weight: 800; color: var(--text-primary);
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        margin-bottom: 0.5rem;
      }

      /* Lowest tracked / notes */
      .lowest-card {
        background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
      }
      .lowest-price-row { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.75rem; }
      .lowest-price {
        font-size: 1.5rem; font-weight: 800; color: var(--text-primary);
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }
      .lowest-date { font-size: 0.8rem; color: var(--text-muted); }
      .lowest-none { color: var(--text-muted); font-size: 0.9rem; margin: 0; }
      .sale-notes { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin: 0; }

      /* FAQ */
      .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
      .faq-item {
        background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 0 1.25rem; overflow: hidden;
      }
      .faq-item summary {
        cursor: pointer; list-style: none; padding: 1rem 0;
        font-weight: 700; font-size: 0.95rem; color: var(--text-primary);
        display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary::after {
        content: '+'; color: var(--accent); font-size: 1.3rem; font-weight: 400; flex-shrink: 0;
        transition: transform 0.15s;
      }
      .faq-item[open] summary::after { content: '−'; }
      .faq-item p { color: var(--text-secondary); font-size: 0.88rem; line-height: 1.6; margin: 0 0 1rem; }

      /* Alternatives */
      .alt-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
      .alt-card {
        display: block; background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.1rem 1.25rem; text-decoration: none;
        transition: border-color 0.15s, background 0.15s;
      }
      .alt-card:hover { border-color: var(--accent); background: var(--bg-card-hover); }
      .alt-name { color: var(--text-primary); font-weight: 700; font-size: 0.92rem; margin: 0 0 0.5rem; }
      .alt-price {
        color: var(--accent); font-weight: 800; font-size: 1.05rem;
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }
      .alt-empty { color: var(--text-muted); font-size: 0.9rem; }

      .guide-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .guide-link {
        color: var(--accent);
        font-size: 0.875rem;
        text-decoration: none;
        line-height: 1.5;
      }
      .guide-link:hover {
        text-decoration: underline;
      }

      .watch-alert-wrap {
        display: inline-flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-start;
      }
      .watch-form {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
      }
      .watch-email-input {
        background: #1a1a1a;
        border: 1px solid #3a3a3a;
        border-radius: 6px;
        color: #f0f0f0;
        font-size: 0.875rem;
        padding: 0.45rem 0.75rem;
        outline: none;
        width: 200px;
      }
      .watch-email-input:focus {
        border-color: var(--accent);
      }
      .watch-submit-btn {
        background: #1e1e1e;
        border: 1px solid #3a3a3a;
        border-radius: 6px;
        color: #f0f0f0;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.45rem 1rem;
      }
      .watch-submit-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
      .watch-msg {
        font-size: 0.82rem;
        color: #aaa;
      }
      .watch-msg.ok {
        color: #2ecc71;
      }
      .watch-msg.err {
        color: #e44;
      }

      .trust-line {
        margin-top: 2.5rem; padding: 1rem 1.25rem; border-left: 3px solid var(--accent-muted);
        color: var(--text-muted); font-size: 0.82rem; line-height: 1.6;
      }

      @media (max-width: 480px) {
        .price-current { font-size: 1.6rem; }
        .cta-primary, .cta-secondary { flex: 1 1 100%; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="sr-only">Skip to content</a>
    <Header />
    <main id="main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/plugin-prices">Price Tracker</a><span class="sep">/</span>
        <span>{name}</span>
      </nav>

      <section class="product-header">
        <span class="category-tag">{category}</span>
        <h1>{name}</h1>

        <div class="price-row">
          <span class={onSale ? 'price-current on-sale' : 'price-current'}>{formatPrice(current)}</span>
          {onSale && regular !== null && (
            <span class="price-regular-strike">{formatPrice(regular)}</span>
          )}
          {onSale && off > 0 && <span class="off-badge">-{off}%</span>}
        </div>
        <p class="last-checked">{checkedLabel}</p>

        <div class="verdict-box">
          <div>
            <p class="verdict-label">Market verdict</p>
            <p class="verdict-text">{verdict}</p>
            {dealScore.verdict === 'none' ? (
              <span class="score-none" title="No discount history — price is stable">—</span>
            ) : (
              <span class={`score-badge ${dealScore.verdict}`}>{dealScore.score}</span>
            )}
          </div>
        </div>

        <div class="cta-row">
          <a
            href={pbLink(entry.pb_url)}
            class="cta-primary"
            target="_blank"
            rel="noopener sponsored"
          >
            Check price at Plugin Boutique
          </a>
          <div class="watch-alert-wrap" id="watch-alert-wrap">
            <button type="button" class="cta-secondary" id="watch-toggle-btn">Alert me when it drops</button>
            <form id="watch-form" class="watch-form" style="display:none" data-plugin={slug}>
              <input
                type="email"
                id="watch-email-input"
                class="watch-email-input"
                placeholder="your@email.com"
                required
                autocomplete="email"
              />
              <button type="submit" class="watch-submit-btn">Notify me</button>
            </form>
            <p id="watch-msg" class="watch-msg" style="display:none"></p>
          </div>
        </div>
      </section>

      <section class="page-section">
        <h2 class="section-title">Price History</h2>
        <p class="section-sub">Every price point we've logged for {name} since we started tracking.</p>
        {chartGeom ? (
          <div class="chart-card" id="price-chart-card">
            <svg
              viewBox={`0 0 ${chartGeom.width} ${chartGeom.height}`}
              class="price-chart"
              id="price-chart-svg"
              role="img"
              aria-label={`Price history chart for ${name}`}
            >
              <defs>
                <linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.28" />
                  <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
                </linearGradient>
              </defs>

              {chartGeom.yTicks.map((t) => (
                <>
                  <line x1={chartGeom.padX} x2={chartGeom.width - chartGeom.padX} y1={t.pos} y2={t.pos} class="grid-line" />
                  <text x={chartGeom.padX - 8} y={t.pos + 3} class="axis-label y-label">{t.label}</text>
                </>
              ))}

              {chartGeom.xTicks.map((t) => (
                <text x={t.pos} y={chartGeom.height - chartGeom.padBottom + 18} class="axis-label x-label">{t.label}</text>
              ))}

              {chartGeom.regularY !== null && (
                <>
                  <line
                    x1={chartGeom.padX} x2={chartGeom.width - chartGeom.padX}
                    y1={chartGeom.regularY} y2={chartGeom.regularY}
                    class="ref-line ref-regular"
                  />
                  <text x={chartGeom.width - chartGeom.padX} y={chartGeom.regularY - 6} class="ref-label ref-regular-label">
                    Regular ${entry.typical_regular}
                  </text>
                </>
              )}
              {chartGeom.lowestY !== null && (
                <>
                  <line
                    x1={chartGeom.padX} x2={chartGeom.width - chartGeom.padX}
                    y1={chartGeom.lowestY} y2={chartGeom.lowestY}
                    class="ref-line ref-lowest"
                  />
                  <text x={chartGeom.width - chartGeom.padX} y={chartGeom.lowestY + 14} class="ref-label ref-lowest-label">
                    Lowest tracked ${entry.all_time_low}
                  </text>
                </>
              )}

              <path d={chartGeom.areaPath} fill="url(#chartFill)" stroke="none" />
              <path
                d={chartGeom.stepPath} fill="none" stroke="var(--accent)"
                stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"
              />

              {chartGeom.points.map((p) => (
                <circle
                  cx={p.x} cy={p.y} r="4.5" class="price-point"
                  fill={p.isSale || p.isLowest ? 'var(--sale-text)' : 'var(--accent)'}
                />
              ))}

              <line
                id="price-chart-crosshair"
                x1="0" x2="0" y1={chartGeom.padTop} y2={chartGeom.height - chartGeom.padBottom}
                class="crosshair" style="opacity:0"
              />
              <circle id="price-chart-hoverdot" r="5.5" class="hover-dot" style="opacity:0" />

              <rect
                id="price-chart-overlay"
                class="overlay-rect"
                x={chartGeom.padX} y="0"
                width={chartGeom.width - chartGeom.padX * 2}
                height={chartGeom.height}
              />
            </svg>
            <div id="price-chart-tooltip" class="chart-tooltip" role="status" aria-live="polite"></div>
            <p class="chart-legend">
              <span class="legend-item"><span class="legend-dot legend-dot-normal"></span>logged price (USD)</span>
              <span class="legend-item"><span class="legend-dot legend-dot-sale"></span>sale / lowest</span>
              <span class="legend-item"><span class="legend-dash"></span>typical regular &amp; lowest tracked</span>
              <span class="legend-item legend-note">Dates are month + year (e.g. Jul 2026)</span>
            </p>
          </div>
        ) : (
          <p class="chart-empty">
            <span class="chart-empty-price">{formatPrice(current)}</span>
            {emptyStateText(entry)}
          </p>
        )}

        <script
          define:vars={{
            chartPoints: chartGeom ? chartGeom.points : [],
            chartWidth: chartGeom ? chartGeom.width : 0,
            chartHeight: chartGeom ? chartGeom.height : 0,
          }}
        >
          if (chartPoints && chartPoints.length >= 2) {
            const svg = document.getElementById('price-chart-svg');
            const overlay = document.getElementById('price-chart-overlay');
            const crosshair = document.getElementById('price-chart-crosshair');
            const hoverDot = document.getElementById('price-chart-hoverdot');
            const tooltip = document.getElementById('price-chart-tooltip');
            const card = document.getElementById('price-chart-card');

            if (svg && overlay && crosshair && hoverDot && tooltip && card) {
              const nearestPoint = (localX) => {
                let nearest = chartPoints[0];
                let bestDist = Infinity;
                for (const p of chartPoints) {
                  const dist = Math.abs(p.x - localX);
                  if (dist < bestDist) {
                    bestDist = dist;
                    nearest = p;
                  }
                }
                return nearest;
              };

              const labelFor = (p) => {
                if (p.isLowest) return 'Lowest tracked';
                if (p.isSale) return 'On sale';
                return 'Regular price';
              };

              const formatDate = (d) =>
                new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                  timeZone: 'UTC',
                });

              const showAt = (clientX, clientY) => {
                const svgRect = svg.getBoundingClientRect();
                const scaleX = chartWidth / svgRect.width;
                const scaleY = chartHeight / svgRect.height;
                const localX = (clientX - svgRect.left) * scaleX;
                const p = nearestPoint(localX);

                crosshair.setAttribute('x1', String(p.x));
                crosshair.setAttribute('x2', String(p.x));
                crosshair.style.opacity = '1';

                hoverDot.setAttribute('cx', String(p.x));
                hoverDot.setAttribute('cy', String(p.y));
                hoverDot.style.opacity = '1';

                const saleClass = (p.isLowest || p.isSale) ? 'tt-label tt-sale' : 'tt-label';
                tooltip.innerHTML =
                  '<div class="tt-date">' + formatDate(p.date) + '</div>' +
                  '<div class="tt-price">$' + p.value + '</div>' +
                  '<div class="' + saleClass + '">' + labelFor(p) + '</div>';
                tooltip.style.opacity = '1';

                const cardRect = card.getBoundingClientRect();
                const pxOnScreen = svgRect.left - cardRect.left + p.x / scaleX;
                const pyOnScreen = svgRect.top - cardRect.top + p.y / scaleY;

                const tw = tooltip.offsetWidth || 140;
                let left = pxOnScreen - tw / 2;
                left = Math.max(4, Math.min(left, cardRect.width - tw - 4));
                tooltip.style.left = left + 'px';

                const th = tooltip.offsetHeight || 50;
                let top = pyOnScreen - th - 14;
                if (top < 0) top = pyOnScreen + 14;
                tooltip.style.top = top + 'px';
              };

              const hide = () => {
                crosshair.style.opacity = '0';
                hoverDot.style.opacity = '0';
                tooltip.style.opacity = '0';
              };

              overlay.addEventListener('mousemove', (e) => showAt(e.clientX, e.clientY));
              overlay.addEventListener('mouseleave', hide);
              overlay.addEventListener(
                'touchstart',
                (e) => {
                  if (e.touches[0]) showAt(e.touches[0].clientX, e.touches[0].clientY);
                },
                { passive: true }
              );
              overlay.addEventListener(
                'touchmove',
                (e) => {
                  if (e.touches[0]) showAt(e.touches[0].clientX, e.touches[0].clientY);
                },
                { passive: true }
              );
              overlay.addEventListener('touchend', hide);
            }
          }
        </script>
      </section>

      {demoVideo && (
        <section class="page-section">
          <h2 class="section-title">Watch It In Action</h2>
          <div class="video-embed">
            <iframe
              loading="lazy"
              src={`https://www.youtube-nocookie.com/embed/${demoVideo.video_id}`}
              title={demoVideo.title}
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <p class="video-caption">{demoVideo.title} — {demoVideo.channel} (YouTube)</p>
        </section>
      )}

      <section class="page-section">
        <h2 class="section-title">Past Sales &amp; Lowest Tracked Price</h2>
        <div class="lowest-card">
          {entry.all_time_low !== null ? (
            <div class="lowest-price-row">
              <span class="lowest-price">{formatPrice(entry.all_time_low)}</span>
              <span class="lowest-date">Lowest tracked{lowestDate ? ` — ${lowestDate}` : ''}</span>
            </div>
          ) : (
            <p class="lowest-none">No discount recorded for {name} yet — we're watching for sales.</p>
          )}
          {entry.notes && <p class="sale-notes">{entry.notes}</p>}
        </div>
      </section>

      <section class="page-section">
        <h2 class="section-title">Pricing FAQ</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="page-section">
        <h2 class="section-title">Cheaper Alternatives</h2>
        {alternatives.length > 0 ? (
          <div class="alt-grid">
            {alternatives.map((alt) => (
              <a href={`/plugin-prices/${slugify(alt.name)}/`} class="alt-card">
                <p class="alt-name">{alt.name}</p>
                <span class="alt-price">{formatPrice(alt.price)}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="alt-empty">No other tracked products to compare yet.</p>
        )}
      </section>

      {guides.length > 0 && (
        <section class="page-section">
          <h2 class="section-title">Guides featuring {name}</h2>
          <ul class="guide-list">
            {guides.map((g) => (
              <li class="guide-item">
                <a href={`/posts/${g.slug}/`} class="guide-link">{g.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="trust-line">Prices checked daily. Data since Apr 2026.</p>
    </main>
    <Footer />
    <script is:inline>
      // Watch alert toggle + submit
      (function () {
        const wrap = document.getElementById('watch-alert-wrap');
        if (!wrap) return;
        const toggleBtn = document.getElementById('watch-toggle-btn');
        const form = document.getElementById('watch-form');
        const input = document.getElementById('watch-email-input');
        const msg = document.getElementById('watch-msg');

        toggleBtn.addEventListener('click', () => {
          toggleBtn.style.display = 'none';
          form.style.display = 'flex';
          input.focus();
        });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = input.value.trim();
          const plugin = form.dataset.plugin;
          if (!email || !plugin) return;

          const submitBtn = form.querySelector('button[type="submit"]');
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending…';
          msg.style.display = 'none';

          try {
            const res = await fetch('https://plugindrop-subscribe.plugindrop.workers.dev/watch', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, plugin }),
            });
            const data = await res.json();
            if (res.ok && data.ok) {
              form.style.display = 'none';
              msg.textContent = data.already
                ? 'You\'re already on the list for this plugin.'
                : 'Done! We\'ll email you when the price drops.';
              msg.className = 'watch-msg ok';
              msg.style.display = 'block';
            } else {
              throw new Error(data.error || 'Failed');
            }
          } catch (err) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Notify me';
            msg.textContent = 'Something went wrong. Please try again.';
            msg.className = 'watch-msg err';
            msg.style.display = 'block';
          }
        });
      })();
    </script>
  </body>
</html>
