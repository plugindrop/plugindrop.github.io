---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function getStoreName(url: string | undefined): string {
	if (!url) return '';
	if (url.includes('pluginboutique.com')) return 'Plugin Boutique';
	if (url.includes('kvraudio.com')) return 'KVR Audio';
	if (url.includes('adsrsounds.com')) return 'ADSR Sounds';
	if (url.includes('loopmasters.com')) return 'Loopmasters';
	if (url.includes('splice.com')) return 'Splice';
	if (url.includes('sweetwater.com')) return 'Sweetwater';
	if (url.includes('thomann.de')) return 'Thomann';
	if (url.includes('waves.com')) return 'Waves';
	if (url.includes('native-instruments.com')) return 'Native Instruments';
	if (url.includes('arturia.com')) return 'Arturia';
	if (url.includes('izotope.com')) return 'iZotope';
	if (url.includes('plugin-alliance.com')) return 'Plugin Alliance';
	try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`All Deals | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-intro {
				padding: 2rem 0 1.5rem;
				border-bottom: 1px solid var(--border);
				margin-bottom: 1.5rem;
			}
			.page-intro h1 {
				font-family: var(--font-display);
				font-size: 1.75rem;
				font-weight: 500;
				margin-bottom: 0.2rem;
			}
			.page-intro p {
				color: var(--text-muted);
				font-size: 0.9rem;
				margin: 0;
			}

			/* Filter tabs */
			.filter-bar {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
				margin-bottom: 1.5rem;
			}
			.filter-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				padding: 0.4rem 0.9rem;
				border: 1px solid var(--border);
				border-radius: var(--radius-sm);
				background: var(--bg-card);
				color: var(--text-muted);
				font-size: 0.8rem;
				font-weight: 600;
				cursor: pointer;
				transition: border-color 0.15s, color 0.15s, background 0.15s;
				font-family: inherit;
			}
			.filter-btn:hover {
				border-color: var(--accent-border-hover);
				color: var(--text-primary);
				background: var(--bg-card-hover);
			}
			.filter-btn.active {
				border-color: var(--accent-dark);
				background: rgba(148, 211, 196, 0.1);
				color: var(--accent);
			}
			.filter-btn .dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: currentColor;
				flex-shrink: 0;
			}
			.filter-count {
				font-size: 0.7rem;
				opacity: 0.75;
			}

			/* Results info */
			.results-info {
				font-size: 0.8rem;
				color: var(--text-muted);
				margin-bottom: 1rem;
			}

			/* Post list */
			.post-list {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
			.post-item {
				display: flex;
				gap: 1.25rem;
				padding: 1rem 1.25rem;
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				text-decoration: none;
				transition: border-color 0.15s, box-shadow 0.2s, transform 0.1s;
				align-items: center;
				box-shadow: var(--box-shadow);
			}
			.post-item:hover {
				border-color: var(--accent-border-hover);
				background: var(--bg-card-hover);
			}
			.post-item.hidden { display: none; }
			.post-thumb-wrap {
				flex-shrink: 0;
				width: 130px;
				height: 82px;
				border-radius: var(--radius-sm);
				border: 1px solid var(--border);
				overflow: hidden;
				background: var(--bg-low);
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.post-thumb {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.post-thumb-placeholder {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--text-muted);
				font-size: 1.5rem;
			}
			.post-info {
				flex: 1;
				min-width: 0;
			}
			.post-info h3 {
				font-size: 1rem;
				margin-bottom: 0.25rem;
				color: var(--text-primary);
				line-height: 1.35;
			}
			.post-info .desc {
				color: var(--text-secondary);
				font-size: 0.825rem;
				margin: 0 0 0.4rem;
				line-height: 1.4;
				display: -webkit-box;
				-webkit-line-clamp: 1;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.post-meta .date {
				color: var(--text-muted);
				font-size: 0.75rem;
			}
			.post-meta .store {
				color: var(--text-muted);
				font-size: 0.75rem;
			}
			/* Price column */
			.post-price {
				flex-shrink: 0;
				text-align: right;
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: 0.2rem;
			}
			.price-current {
				font-size: 1.15rem;
				font-weight: 800;
				color: var(--text-primary);
				white-space: nowrap;
			}
			.price-current.is-free { color: var(--free-text); }
			.price-original {
				font-size: 0.75rem;
				color: var(--text-muted);
				text-decoration: line-through;
				white-space: nowrap;
			}
			.price-discount {
				font-size: 0.65rem;
				font-weight: 800;
				color: var(--sale-text);
				background: var(--sale-bg);
				padding: 0.15em 0.4em;
				border-radius: 3px;
				white-space: nowrap;
			}

			/* Empty state */
			.empty-state {
				text-align: center;
				padding: 3rem 1rem;
				color: var(--text-muted);
				display: none;
			}
			.empty-state.visible { display: block; }

			@media (max-width: 600px) {
				.post-item { flex-wrap: wrap; }
				.post-thumb-wrap { width: 100%; height: 140px; }
				.post-price { flex-direction: row; align-items: baseline; gap: 0.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-intro">
				<h1>All Deals</h1>
				<p>{posts.length} plugin deals, free downloads &amp; flash sales</p>
			</div>

			<!-- Filter bar -->
			<div class="filter-bar" role="group" aria-label="Filter deals">
				<button class="filter-btn active" data-filter="all">All Deals</button>
				<button class="filter-btn" data-filter="free">
					<span class="dot" style="background: var(--free-text)"></span> Free
				</button>
				<button class="filter-btn" data-filter="sale">
					<span class="dot" style="background: var(--sale-text)"></span> Sale
				</button>
				<button class="filter-btn" data-filter="daw">DAW</button>
				<button class="filter-btn" data-filter="roundup">Bundles</button>
				<button class="filter-btn" data-filter="plugin">Plugins</button>
			</div>

			<p class="results-info" id="results-info">{posts.length} deals found</p>

			<div class="post-list" id="post-list">
				{posts.map((post) => {
					const store = getStoreName(post.data.affiliate);
					const tagsStr = (post.data.tags ?? []).join(',');
					return (
						<a
							href={`/posts/${post.id}/`}
							class="post-item"
							data-tags={tagsStr}
							data-has-price={(post.data.dealPrice || post.data.discount) ? '1' : '0'}
							data-has-affiliate={post.data.affiliate ? '1' : '0'}
						>
							<div class="post-thumb-wrap">
								{typeof post.data.heroImage === 'string'
									? <img
											class="post-thumb"
											src={post.data.heroImage}
											alt={post.data.title}
											loading="lazy"
											onerror="this.style.display='none'; this.parentElement.querySelector('.post-thumb-placeholder').style.display='flex'"
										/>
									: null
								}
								<div class="post-thumb-placeholder" style={typeof post.data.heroImage === 'string' ? 'display:none' : 'display:flex'}>
									&#9834;
								</div>
							</div>
							<div class="post-info">
								<h3>{post.data.title}</h3>
								<p class="desc">{post.data.description}</p>
								<div class="post-meta">
									<span class="date"><FormattedDate date={post.data.pubDate} /></span>
									{store && <span class="store">via {store}</span>}
									{post.data.tags?.slice(0, 3).map((tag: string) => (
										<span class={`tag ${tag === 'free' ? 'free' : tag === 'sale' ? 'sale' : ''}`}>{tag}</span>
									))}
								</div>
							</div>
							{(post.data.dealPrice || post.data.originalPrice) && (
								<div class="post-price">
									{post.data.dealPrice && (
										<span class={`price-current ${post.data.dealPrice?.trim().toUpperCase() === 'FREE' ? 'is-free' : ''}`}>
											{post.data.dealPrice}
										</span>
									)}
									{post.data.originalPrice && (
										<span class="price-original">{post.data.originalPrice}</span>
									)}
									{post.data.discount && (
										<span class="price-discount">{post.data.discount}</span>
									)}
								</div>
							)}
						</a>
					);
				})}
			</div>
			<p class="empty-state" id="empty-state">No deals found for this filter.</p>
		</main>
		<Footer />

		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
			const items = document.querySelectorAll<HTMLElement>('.post-item');
			const resultsInfo = document.getElementById('results-info')!;
			const emptyState = document.getElementById('empty-state')!;

			// Read ?filter= from URL on page load
			const urlParams = new URLSearchParams(window.location.search);
			const initialFilter = urlParams.get('filter') || 'all';

			const SALE_TAGS = new Set(['sale', 'deal', 'deals', 'newplugindeals', 'plugindeals', 'flash-sale']);

			function applyFilter(filter: string) {
				let count = 0;
				items.forEach((item) => {
					const tags = (item.dataset.tags || '').split(',').map(t => t.trim());
					let matches: boolean;
					if (filter === 'all') {
						matches = true;
					} else if (filter === 'sale') {
						matches = tags.some(t => SALE_TAGS.has(t)) || item.dataset.hasPrice === '1' || item.dataset.hasAffiliate === '1';
					} else {
						matches = tags.includes(filter);
					}
					item.classList.toggle('hidden', !matches);
					if (matches) count++;
				});
				resultsInfo.textContent = `${count} deal${count !== 1 ? 's' : ''} found`;
				emptyState.classList.toggle('visible', count === 0);
				buttons.forEach((btn) => {
					btn.classList.toggle('active', btn.dataset.filter === filter);
				});
			}

			// Apply URL filter on load
			applyFilter(initialFilter);

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const filter = btn.dataset.filter || 'all';
					applyFilter(filter);
					// Update URL without reload
					const url = new URL(window.location.href);
					if (filter === 'all') {
						url.searchParams.delete('filter');
					} else {
						url.searchParams.set('filter', filter);
					}
					window.history.replaceState({}, '', url.toString());
				});
			});
		</script>
	</body>
</html>
