---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');

function isFree(post: any): boolean {
	const price = (post.data.dealPrice ?? '').trim().toUpperCase();
	return price === 'FREE' || price === '$0' || price === '0' ||
		(post.data.tags ?? []).includes('free');
}

const freePosts = allPosts
	.filter(p => !p.data.draft && isFree(p))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const vstFree = freePosts.filter(p => (p.data.tags ?? []).some((t: string) => ['synth', 'vst-plugin', 'effects', 'reverb', 'eq', 'compressor', 'mixing', 'mastering'].includes(t)));
const sampleFree = freePosts.filter(p => (p.data.tags ?? []).includes('sample-pack'));
const presetFree = freePosts.filter(p => (p.data.tags ?? []).includes('preset-pack'));
const otherFree = freePosts.filter(p =>
	!vstFree.includes(p) && !sampleFree.includes(p) && !presetFree.includes(p)
);

const breadcrumbLD = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).href },
		{ "@type": "ListItem", "position": 2, "name": "Free VST Plugins & Sample Packs" },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Free VST Plugins & Sample Packs | ${SITE_TITLE}`}
			description="Download free VST plugins, sample packs, and presets — all verified and updated daily. Synths, effects, drums, reverbs, and more, completely free."
		/>
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />
		<style>
			main { max-width: 960px; margin: 0 auto; padding: 2rem 1rem; }
			.page-header { margin-bottom: 2.5rem; }
			.page-header h1 { font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem; }
			.page-header p { color: var(--text-muted); font-size: 1rem; margin: 0; }
			.section-title { font-size: 1.2rem; font-weight: 700; margin: 2rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--accent); }
			.post-list { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; }
			.post-card {
				display: flex; gap: 1rem; align-items: flex-start;
				padding: 0.875rem; border: 1px solid var(--border);
				border-radius: var(--radius); background: var(--bg-card);
				text-decoration: none; color: inherit;
				transition: border-color 0.15s;
			}
			.post-card:hover { border-color: var(--accent); }
			.post-thumb { width: 100px; height: 56px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }
			.post-info { flex: 1; }
			.post-title { font-size: 0.9rem; font-weight: 600; margin: 0 0 0.25rem; line-height: 1.3; }
			.post-meta { font-size: 0.78rem; color: var(--text-muted); }
			.free-badge { display: inline-block; background: var(--accent); color: #fff; font-size: 0.7rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 3px; margin-left: 0.4rem; }
			.breadcrumb { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.5rem; }
			.breadcrumb a { color: var(--text-muted); text-decoration: none; }
			.breadcrumb a:hover { text-decoration: underline; }
			.sep { margin: 0 0.4rem; }
			.count { color: var(--text-muted); font-size: 0.85rem; margin-left: 0.5rem; font-weight: 400; }
			.cta-banner {
				background: linear-gradient(135deg, var(--accent) 0%, #7c3aed 100%);
				color: #fff; border-radius: var(--radius); padding: 1.5rem;
				text-align: center; margin: 2rem 0;
			}
			.cta-banner h2 { margin: 0 0 0.5rem; font-size: 1.2rem; }
			.cta-banner p { margin: 0; font-size: 0.9rem; opacity: 0.9; }
		</style>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a><span class="sep">/</span>
				<span>Free Downloads</span>
			</nav>
			<div class="page-header">
				<h1>Free VST Plugins & Sample Packs</h1>
				<p>{freePosts.length} free music production tools — updated daily</p>
			</div>

			<div class="cta-banner">
				<h2>New free plugins every day</h2>
				<p>Bookmark this page or check <a href="/tags/free" style="color:#fff;font-weight:700">/tags/free</a> for the latest additions.</p>
			</div>

			{vstFree.length > 0 && (
				<>
					<h2 class="section-title">Free VST Plugins <span class="count">({vstFree.length})</span></h2>
					<ul class="post-list" role="list">
						{vstFree.slice(0, 12).map(post => (
							<li>
								<a href={`/posts/${post.id.replace(/\.mdx?$/, '')}/`} class="post-card">
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt="" loading="lazy" width="100" height="56" class="post-thumb" />
									)}
									<div class="post-info">
										<p class="post-title">{post.data.title} <span class="free-badge">FREE</span></p>
										<span class="post-meta"><FormattedDate date={post.data.pubDate} /></span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</>
			)}

			{sampleFree.length > 0 && (
				<>
					<h2 class="section-title">Free Sample Packs <span class="count">({sampleFree.length})</span></h2>
					<ul class="post-list" role="list">
						{sampleFree.slice(0, 8).map(post => (
							<li>
								<a href={`/posts/${post.id.replace(/\.mdx?$/, '')}/`} class="post-card">
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt="" loading="lazy" width="100" height="56" class="post-thumb" />
									)}
									<div class="post-info">
										<p class="post-title">{post.data.title} <span class="free-badge">FREE</span></p>
										<span class="post-meta"><FormattedDate date={post.data.pubDate} /></span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</>
			)}

			{presetFree.length > 0 && (
				<>
					<h2 class="section-title">Free Preset Packs <span class="count">({presetFree.length})</span></h2>
					<ul class="post-list" role="list">
						{presetFree.slice(0, 8).map(post => (
							<li>
								<a href={`/posts/${post.id.replace(/\.mdx?$/, '')}/`} class="post-card">
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt="" loading="lazy" width="100" height="56" class="post-thumb" />
									)}
									<div class="post-info">
										<p class="post-title">{post.data.title} <span class="free-badge">FREE</span></p>
										<span class="post-meta"><FormattedDate date={post.data.pubDate} /></span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</>
			)}

			{otherFree.length > 0 && (
				<>
					<h2 class="section-title">More Free Tools <span class="count">({otherFree.length})</span></h2>
					<ul class="post-list" role="list">
						{otherFree.slice(0, 6).map(post => (
							<li>
								<a href={`/posts/${post.id.replace(/\.mdx?$/, '')}/`} class="post-card">
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt="" loading="lazy" width="100" height="56" class="post-thumb" />
									)}
									<div class="post-info">
										<p class="post-title">{post.data.title} <span class="free-badge">FREE</span></p>
										<span class="post-meta"><FormattedDate date={post.data.pubDate} /></span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</>
			)}
		</main>
		<Footer />
	</body>
</html>
