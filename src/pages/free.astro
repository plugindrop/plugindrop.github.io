---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const GUIDE_ARTICLES = [
	{
		slug: 'best-free-vst-plugins-2026',
		title: 'Best Free VST Plugins 2026',
		description: 'Top free plugins across every category — synths, effects, drums, and more.',
		emoji: '🎛️',
	},
	{
		slug: 'best-free-synth-plugins',
		title: 'Best Free Synth Plugins',
		description: '14 professional-grade synths you can download right now for free.',
		emoji: '🎹',
	},
	{
		slug: 'best-free-daw-software-2026',
		title: 'Best Free DAW 2026',
		description: 'GarageBand, REAPER, LMMS — 8 full DAWs with no cost, ranked.',
		emoji: '💻',
	},
	{
		slug: 'best-free-drum-plugins',
		title: 'Best Free Drum Plugins',
		description: 'Free drum machines and samplers for any genre.',
		emoji: '🥁',
	},
	{
		slug: 'best-free-reverb-vst-plugins',
		title: 'Best Free Reverb Plugins 2026',
		description: '15 free reverb VSTs — from lush halls to classic plates.',
		emoji: '🌊',
	},
	{
		slug: 'vital-synthesizer-review-2026',
		title: 'Vital Synth Review 2026',
		description: 'Is the free wavetable synth really that good? Full breakdown.',
		emoji: '⚡',
	},
	{
		slug: 'best-free-tape-saturation-vst',
		title: 'Best Free Tape Saturation VST 2026',
		description: '8 free saturation & warmth plugins — from subtle glue to full-on tape crunch.',
		emoji: '🎚️',
	},
	{
		slug: 'best-free-choir-vst-plugins',
		title: 'Best Free Choir VST Plugins 2026',
		description: '8 free choir & vocal ensemble plugins — from realistic choirs to ethereal pads.',
		emoji: '🎵',
	},
];

const allPosts = await getCollection('blog');

function isFree(post: any): boolean {
	const price = (post.data.dealPrice ?? '').trim().toUpperCase();
	return price === 'FREE' || price === '$0' || price === '0' ||
		(post.data.tags ?? []).includes('free');
}

const freePosts = allPosts
	.filter(p => !p.data.draft && isFree(p))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbLD = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).href },
		{ "@type": "ListItem", "position": 2, "name": "Free VST Plugins & Sample Packs" },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Free VST Plugins & Sample Packs | ${SITE_TITLE}`}
			description="Download free VST plugins, sample packs, and presets — all verified and updated daily. Synths, effects, drums, reverbs, and more, completely free."
		/>
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />
		<style>
			main { max-width: 960px; margin: 0 auto; padding: 2rem 1rem; }
			.page-header { margin-bottom: 2.5rem; }
			.page-header h1 { font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem; }
			.page-header p { color: var(--text-muted); font-size: 1rem; margin: 0; }
			.post-list { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; }
			.post-card {
				display: flex; gap: 1rem; align-items: flex-start;
				padding: 0.875rem; border: 1px solid var(--border);
				border-radius: var(--radius); background: var(--bg-card);
				text-decoration: none; color: inherit;
				transition: border-color 0.15s;
			}
			.post-card:hover { border-color: var(--accent); }
			.post-thumb { width: 100px; height: 56px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }
			.post-info { flex: 1; }
			.post-title { font-size: 0.9rem; font-weight: 600; margin: 0 0 0.25rem; line-height: 1.3; }
			.post-meta { font-size: 0.78rem; color: var(--text-muted); }
			.free-badge { display: inline-block; background: var(--accent); color: #fff; font-size: 0.7rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 3px; margin-left: 0.4rem; }
			.deal-price { display: inline-block; font-size: 0.78rem; font-weight: 700; color: var(--accent); margin-left: 0.5rem; }
			.breadcrumb { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.5rem; }
			.breadcrumb a { color: var(--text-muted); text-decoration: none; }
			.breadcrumb a:hover { text-decoration: underline; }
			.sep { margin: 0 0.4rem; }
			.cta-banner {
				background: linear-gradient(135deg, var(--accent) 0%, #7c3aed 100%);
				color: #fff; border-radius: var(--radius); padding: 1.5rem;
				text-align: center; margin: 2rem 0;
			}
			.cta-banner h2 { margin: 0 0 0.5rem; font-size: 1.2rem; }
			.cta-banner p { margin: 0; font-size: 0.9rem; opacity: 0.9; }
			.guide-section { margin-bottom: 2.5rem; }
			.guide-section h2 { font-size: 1.2rem; font-weight: 700; margin: 0 0 1rem; }
			.guide-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
				gap: 0.75rem;
			}
			.guide-card {
				display: flex; flex-direction: column; gap: 0.25rem;
				padding: 1rem; border: 1px solid var(--border);
				border-radius: var(--radius); background: var(--bg-card);
				text-decoration: none; color: inherit;
				transition: border-color 0.15s;
			}
			.guide-card:hover { border-color: var(--accent); }
			.guide-emoji { font-size: 1.5rem; }
			.guide-title { font-size: 0.88rem; font-weight: 700; margin: 0; }
			.guide-desc { font-size: 0.78rem; color: var(--text-muted); margin: 0; }
			.section-divider { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }
		</style>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a><span class="sep">/</span>
				<span>Free Downloads</span>
			</nav>
			<div class="page-header">
				<h1>Free VST Plugins & Sample Packs</h1>
				<p>{freePosts.length} free music production tools — updated daily</p>
			</div>

			<div class="guide-section">
				<h2>📖 Free Plugin Guides</h2>
				<div class="guide-grid">
					{GUIDE_ARTICLES.map(g => (
						<a href={`/posts/${g.slug}/`} class="guide-card">
							<span class="guide-emoji">{g.emoji}</span>
							<p class="guide-title">{g.title}</p>
							<p class="guide-desc">{g.description}</p>
						</a>
					))}
				</div>
			</div>

			<hr class="section-divider" />

			<div class="cta-banner">
				<h2>New free plugins every day</h2>
				<p>Bookmark this page or check <a href="/tags/free/" style="color:#fff;font-weight:700">/tags/free</a> for the latest additions.</p>
			</div>

			<ul class="post-list" role="list">
				{freePosts.map(post => (
					<li>
						<a href={`/posts/${post.id.replace(/\.mdx?$/, '')}/`} class="post-card">
							{post.data.heroImage && (
								<img src={post.data.heroImage} alt="" loading="lazy" width="100" height="56" class="post-thumb" />
							)}
							<div class="post-info">
								<p class="post-title">
									{post.data.title}
									<span class="free-badge">FREE</span>
									{post.data.dealPrice && !['FREE', '$0', '0'].includes(post.data.dealPrice.trim().toUpperCase()) && (
										<span class="deal-price">{post.data.dealPrice}</span>
									)}
								</p>
								<span class="post-meta"><FormattedDate date={post.data.pubDate} /></span>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
