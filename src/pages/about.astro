---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About PluginDrop | Plugin Deals for Music Producers`} description="PluginDrop is operated by SignalDrop — a team of music producers tracking 26+ plugin deal sources to surface the best VST deals every week." />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"@id": "https://plugindrop.net/#organization",
			"name": "PluginDrop",
			"alternateName": "SignalDrop",
			"url": "https://plugindrop.net",
			"logo": { "@type": "ImageObject", "url": "https://plugindrop.net/favicon.png" },
			"description": "PluginDrop (by SignalDrop) curates the best VST plugin deals, honest reviews, and free downloads for music producers — updated daily since 2024.",
			"email": "signaldrop.biz@gmail.com",
			"foundingDate": "2024",
			"knowsAbout": ["VST plugins", "audio plugins", "music production", "DAW software", "mixing", "mastering", "synthesizers", "sample packs", "FabFilter", "iZotope", "Native Instruments", "Valhalla DSP"],
			"publishingPrinciples": "https://plugindrop.net/about/",
			"sameAs": ["https://plugindrop.net"]
		})} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"@id": "https://plugindrop.net/about/#editorial-team",
			"name": "PluginDrop Editorial Team",
			"url": "https://plugindrop.net/about/",
			"worksFor": { "@id": "https://plugindrop.net/#organization" },
			"jobTitle": "Plugin Reviewer & Deal Curator",
			"knowsAbout": ["VST plugins", "music production", "DAW software", "audio effects", "virtual instruments", "mixing", "mastering", "FabFilter", "iZotope", "Native Instruments"],
			"description": "Music producers reviewing VST plugins and curating deals since 2024. Testing environment: Steinberg Cubase on Windows 11 + Mac mini M4, RME Babyface Pro interface, ADAM Audio A3X monitors."
		})} />
		<style>
			.about {
				max-width: 640px;
				margin: 0 auto;
				padding: 3rem 1rem;
			}
			.about h1 {
				font-size: 2rem;
				margin-bottom: 1.5rem;
			}
			.about p {
				color: var(--text-secondary);
				margin-bottom: 1.25rem;
				line-height: 1.7;
			}
			.about strong {
				color: var(--text-primary);
			}
			.about h2 {
				font-size: 1.25rem;
				margin-top: 2rem;
				margin-bottom: 0.75rem;
			}
			.about ul {
				padding-left: 1.5rem;
				color: var(--text-secondary);
			}
			.about li {
				margin-bottom: 0.5rem;
			}
		</style>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">
			<div class="about">
				<h1>About PluginDrop</h1>
				<p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.5rem;">
					Last updated: June 2026
				</p>
				<p>
					We're music producers who got tired of missing plugin deals. So we started
					tracking <strong>26+ sources</strong> — RSS feeds, Reddit communities, deal sites,
					and manufacturer pages — so you don't have to.
				</p>
				<p>
					We curate the best deals based on brand reputation, discount depth,
					product quality, and relevance to producers.
					Only deals worth your time make it to the site.
				</p>

				<h2>Who We Are</h2>
				<p>
					PluginDrop is operated by <strong>SignalDrop</strong>, a small team of working music producers and audio engineers based in Japan. Our lead reviewer has been producing across genres — electronic, ambient, hip-hop, and cinematic — since 2010, and has spent the past two years systematically testing and documenting VST plugins professionally.
				</p>
				<p>
					We built this site because we couldn't find a resource that combined honest plugin assessments with real-time deal tracking. Most review sites are written by people who haven't opened a DAW session in years. We write from the session.
				</p>

				<h2>Our Expertise</h2>
				<p>
					Our editorial team has been producing music since 2010 and testing VST plugins professionally since 2024.
					We have tested over <strong>300 plugins</strong> across every major category — synthesizers, compressors,
					EQ, reverb, mastering limiters, and sample libraries — in real production sessions, not just demos.
				</p>
				<p>
					When we say FabFilter Pro-L 2 is the best mastering limiter, or that Vital's free tier
					rivals paid synths at $100–$200, those conclusions come from direct comparison in the same
					signal chain, on the same monitors, across multiple genres.
				</p>
				<p>
					Every guide on PluginDrop is reviewed annually and updated when plugin pricing, versions, or competitive alternatives change significantly. You'll see a <strong>last reviewed date</strong> at the top of each guide.
				</p>

				<h2>What We Cover</h2>
				<ul>
					<li>Free VST plugins and sample libraries (tested, not just listed)</li>
					<li>Limited-time sales and flash deals (Plugin Boutique, ADSR, Loopmasters)</li>
					<li>In-depth comparisons: X vs Y with clear, reasoned verdicts</li>
					<li>How-to guides for mixing, mastering, and synthesis</li>
					<li>Genre-specific plugin recommendations (techno, lo-fi, film scoring, hip-hop)</li>
				</ul>

				<h2>Our Test Setup</h2>
				<p>All plugins on this site are installed, launched, and verified for audio output in the following environment before publication:</p>
				<ul>
					<li><strong>DAW:</strong> Steinberg Cubase Pro 13</li>
					<li><strong>Audio Interface:</strong> RME Babyface Pro FS</li>
					<li><strong>Monitors:</strong> ADAM Audio A3X (nearfield)</li>
					<li><strong>Headphones:</strong> AKG K712 Pro</li>
					<li><strong>Primary Machine:</strong> Mac mini M4 16GB (macOS 15)</li>
					<li><strong>Secondary Machine:</strong> Windows 11 (for VST2/VST3 compatibility checks)</li>
					<li><strong>Formats tested:</strong> VST3, AU, AAX (via Pro Tools trial)</li>
				</ul>

				<h2>Methodology</h2>
				<p>
					Each plugin listed on PluginDrop is verified for installation, compatibility, and
					basic audio functionality before publication. For guide articles, we test at minimum 3–5 competing plugins in the same session before assigning rankings.
					Deal articles include the date pricing was confirmed —
					we update or remove listings when deals expire. Evergreen guides are reviewed at least every 6 months.
				</p>

				<h2>Editorial Policy</h2>
				<ul>
					<li>Affiliate links are disclosed on every article that contains them</li>
					<li>Pricing data is confirmed on the date shown in each article</li>
					<li>Errors are corrected within 24 hours of being reported</li>
					<li>Commission rates have <strong>no influence</strong> on our rankings or recommendations</li>
					<li>We do not accept sponsored placements or paid reviews</li>
					<li>Free plugins are included in every ranked guide — not just paid options</li>
				</ul>

				<h2>Contact</h2>
				<p>
					PluginDrop is operated by <strong>SignalDrop</strong>. For corrections, partnership inquiries, or feedback, reach us at
					<a href="mailto:signaldrop.biz@gmail.com">signaldrop.biz@gmail.com</a>.
					We respond within 48 hours on business days.
				</p>

				<h2 id="affiliate">Affiliate Disclosure</h2>
				<p>
					Some links on this site are affiliate links. This means we may earn a small commission
					if you make a purchase — at <strong>no extra cost to you</strong>. This helps us keep
					the site running and the deals flowing.
				</p>
				<p>
					We only recommend products and deals we'd genuinely use ourselves. Our scoring
					algorithm doesn't factor in commission rates — it's purely based on deal quality
					and relevance to music producers.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
