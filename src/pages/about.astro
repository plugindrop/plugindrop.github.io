---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About PluginDrop | Plugin Deals for Music Producers`} description="PluginDrop is operated by SignalDrop — a music producer tracking 26+ plugin deal sources to surface the best VST deals every week." />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "SignalDrop",
			"url": "https://plugindrop.net",
			"logo": "https://plugindrop.net/images/logo-512.png",
			"description": "SignalDrop operates PluginDrop, a curated VST plugin deal aggregator for music producers.",
			"email": "signaldrop.biz@gmail.com",
			"sameAs": ["https://plugindrop.net"]
		})} />
		<style>
			.about {
				max-width: 640px;
				margin: 0 auto;
				padding: 3rem 1rem;
			}
			.about h1 {
				font-size: 2rem;
				margin-bottom: 1.5rem;
			}
			.about p {
				color: var(--text-secondary);
				margin-bottom: 1.25rem;
				line-height: 1.7;
			}
			.about strong {
				color: var(--text-primary);
			}
			.about h2 {
				font-size: 1.25rem;
				margin-top: 2rem;
				margin-bottom: 0.75rem;
			}
			.about ul {
				padding-left: 1.5rem;
				color: var(--text-secondary);
			}
			.about li {
				margin-bottom: 0.5rem;
			}
		</style>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">
			<div class="about">
				<h1>About PluginDrop</h1>
				<p>
					I'm a music producer who got tired of missing plugin deals. So I started
					tracking <strong>26+ sources</strong> — RSS feeds, Reddit communities, deal sites,
					and manufacturer pages — so you don't have to.
				</p>
				<p>
					I curate the best deals based on brand reputation, discount depth,
					product quality, and relevance to producers.
					Only deals worth your time make it to the site.
				</p>

				<h2>What I Cover</h2>
				<ul>
					<li>Free VST plugins and sample libraries</li>
					<li>Limited-time sales and flash deals</li>
					<li>In-depth comparisons and roundups</li>
					<li>New releases worth watching</li>
				</ul>

				<h2>My Setup</h2>
				<p>PluginDrop's data pipeline runs alongside a real studio setup:</p>
				<ul>
					<li><strong>DAW:</strong> Steinberg Cubase</li>
					<li><strong>Audio Interface:</strong> RME Babyface Pro</li>
					<li><strong>Monitors:</strong> ADAM Audio A3X</li>
					<li><strong>Headphones:</strong> AKG K812</li>
					<li><strong>Machines:</strong> Windows 11 / Mac mini M4</li>
				</ul>
				<p>
					This is disclosed for transparency, not as a claim that every plugin listed has been
					personally installed and tested on it — with hundreds of products tracked, that
					wouldn't be true.
				</p>

				<h2>Methodology</h2>
				<p>
					PluginDrop doesn't publish hands-on reviews claiming every plugin has been tested.
					Deal quality is judged from tracked price history, discount depth against prices
					I've actually observed over time, and public specs and vendor documentation.
					Deal articles include the date pricing was confirmed —
					I update or remove listings when deals expire.
					See <a href="/how-we-track-prices/">how we track prices</a> for the full methodology.
				</p>

				<h2>Editorial Policy</h2>
				<ul>
					<li>Affiliate links are marked with [Ad] where required by law</li>
					<li>Pricing data is confirmed on the date shown in each article</li>
					<li>Errors are corrected within 24 hours of being reported</li>
					<li>Commission rates have no influence on my deal scoring or recommendations</li>
				</ul>

				<h2>Contact</h2>
				<p>
					PluginDrop is operated by <strong>SignalDrop</strong>. For inquiries, reach me at
					signaldrop.biz@gmail.com.
				</p>

				<h2 id="personalization">Local Personalization</h2>
				<p>
					Some sections (deals, article lists) may be re-ordered based on what you've been
					reading — this happens entirely in your browser (localStorage). Your reading
					profile never leaves your device. Click "reset" next to any "Sorted for you"
					label to clear it.
				</p>

				<h2 id="affiliate">Affiliate Disclosure</h2>
				<p>
					Some links on this site are affiliate links. This means I may earn a small commission
					if you make a purchase — at <strong>no extra cost to you</strong>. This helps me keep
					the site running and the deals flowing.
				</p>
				<p>
					My scoring algorithm doesn't factor in commission rates — it's purely based on
					deal quality and relevance to music producers.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
