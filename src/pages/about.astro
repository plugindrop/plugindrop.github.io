---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="About PluginDrop — curated plugin deals for music producers." />
		<style>
			.about {
				max-width: 640px;
				margin: 0 auto;
				padding: 3rem 1rem;
			}
			.about h1 {
				font-size: 2rem;
				margin-bottom: 1.5rem;
			}
			.about p {
				color: var(--text-secondary);
				margin-bottom: 1.25rem;
				line-height: 1.7;
			}
			.about strong {
				color: var(--text-primary);
			}
			.about h2 {
				font-size: 1.25rem;
				margin-top: 2rem;
				margin-bottom: 0.75rem;
			}
			.about ul {
				padding-left: 1.5rem;
				color: var(--text-secondary);
			}
			.about li {
				margin-bottom: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about">
				<h1>About PluginDrop</h1>
				<p>
					We're music producers who got tired of missing plugin deals. So we started
					tracking <strong>26+ sources</strong> — RSS feeds, Reddit communities, deal sites,
					and manufacturer pages — so you don't have to.
				</p>
				<p>
					We curate the best deals based on brand reputation, discount depth,
					product quality, and relevance to producers.
					Only deals worth your time make it to the site.
				</p>

				<h2>What We Cover</h2>
				<ul>
					<li>Free VST plugins and sample libraries</li>
					<li>Limited-time sales and flash deals</li>
					<li>In-depth comparisons and roundups</li>
					<li>New releases worth watching</li>
				</ul>

				<h2>Contact</h2>
				<p>
					PluginDrop is operated by <strong>SignalDrop</strong>. For inquiries, reach us at
					signaldrop.biz@gmail.com.
				</p>

				<h2 id="affiliate">Affiliate Disclosure</h2>
				<p>
					Some links on this site are affiliate links. This means we may earn a small commission
					if you make a purchase — at <strong>no extra cost to you</strong>. This helps us keep
					the site running and the deals flowing.
				</p>
				<p>
					We only recommend products and deals we'd genuinely use ourselves. Our scoring
					algorithm doesn't factor in commission rates — it's purely based on deal quality
					and relevance to music producers.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
