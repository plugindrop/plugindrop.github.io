---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About PluginDrop | Plugin Deals for Music Producers`} description="PluginDrop is operated by SignalDrop — a team of music producers tracking 26+ plugin deal sources to surface the best VST deals every week." />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "SignalDrop",
			"url": "https://plugindrop.net",
			"logo": "https://plugindrop.net/images/logo-512.png",
			"description": "SignalDrop operates PluginDrop, a curated VST plugin deal aggregator for music producers.",
			"email": "signaldrop.biz@gmail.com",
			"sameAs": ["https://plugindrop.net"],
			"founder": {
				"@type": "Person",
				"name": "PluginDrop Editorial Team",
				"url": "https://plugindrop.net/about/"
			}
		})} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "PluginDrop Editorial Team",
			"url": "https://plugindrop.net/about/",
			"worksFor": { "@type": "Organization", "name": "SignalDrop", "url": "https://plugindrop.net" },
			"knowsAbout": ["VST plugins", "music production", "DAW software", "audio effects", "virtual instruments"],
			"description": "A team of music producers reviewing and curating plugin deals since 2024. Tested on Windows 11 and Mac mini M4 with Steinberg Cubase and RME Babyface Pro."
		})} />
		<style>
			.about {
				max-width: 640px;
				margin: 0 auto;
				padding: 3rem 1rem;
			}
			.about h1 {
				font-size: 2rem;
				margin-bottom: 1.5rem;
			}
			.about p {
				color: var(--text-secondary);
				margin-bottom: 1.25rem;
				line-height: 1.7;
			}
			.about strong {
				color: var(--text-primary);
			}
			.about h2 {
				font-size: 1.25rem;
				margin-top: 2rem;
				margin-bottom: 0.75rem;
			}
			.about ul {
				padding-left: 1.5rem;
				color: var(--text-secondary);
			}
			.about li {
				margin-bottom: 0.5rem;
			}
		</style>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">
			<div class="about">
				<h1>About PluginDrop</h1>
				<p>
					We're music producers who got tired of missing plugin deals. So we started
					tracking <strong>26+ sources</strong> — RSS feeds, Reddit communities, deal sites,
					and manufacturer pages — so you don't have to.
				</p>
				<p>
					We curate the best deals based on brand reputation, discount depth,
					product quality, and relevance to producers.
					Only deals worth your time make it to the site.
				</p>

				<h2>What We Cover</h2>
				<ul>
					<li>Free VST plugins and sample libraries</li>
					<li>Limited-time sales and flash deals</li>
					<li>In-depth comparisons and roundups</li>
					<li>New releases worth watching</li>
				</ul>

				<h2>Our Setup</h2>
				<p>All plugins on this site are tested and verified in the following environment:</p>
				<ul>
					<li><strong>DAW:</strong> Steinberg Cubase</li>
					<li><strong>Audio Interface:</strong> RME Babyface Pro</li>
					<li><strong>Monitors:</strong> ADAM Audio A3X</li>
					<li><strong>Headphones:</strong> AKG K712 Pro</li>
					<li><strong>Test Machine:</strong> Windows 11 / Mac mini M4</li>
				</ul>

				<h2>Methodology</h2>
				<p>
					Each plugin listed on PluginDrop is verified for installation, compatibility, and
					basic functionality in the setup above before publication.
					Deal articles include the date pricing was confirmed —
					we update or remove listings when deals expire.
				</p>

				<h2>Editorial Policy</h2>
				<ul>
					<li>Affiliate links are marked with [Ad] where required by law</li>
					<li>Pricing data is confirmed on the date shown in each article</li>
					<li>Errors are corrected within 24 hours of being reported</li>
					<li>Commission rates have no influence on our deal scoring or recommendations</li>
				</ul>

				<h2>Contact</h2>
				<p>
					PluginDrop is operated by <strong>SignalDrop</strong>. For inquiries, reach us at
					signaldrop.biz@gmail.com.
				</p>

				<h2 id="affiliate">Affiliate Disclosure</h2>
				<p>
					Some links on this site are affiliate links. This means we may earn a small commission
					if you make a purchase — at <strong>no extra cost to you</strong>. This helps us keep
					the site running and the deals flowing.
				</p>
				<p>
					We only recommend products and deals we'd genuinely use ourselves. Our scoring
					algorithm doesn't factor in commission rates — it's purely based on deal quality
					and relevance to music producers.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
