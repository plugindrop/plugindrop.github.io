---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import priceData from '../data/price_history.json';
import { dealScoreNumeric, sparklinePoints } from '../lib/priceUtils';

function fableVerdictLabel(verdict: 'good' | 'ok' | 'bad' | 'none', onSale: boolean): string {
  if (verdict === 'none') return 'WAIT';
  if (verdict === 'good') return 'BUY NOW';
  if (verdict === 'ok') return 'FAIR SALE';
  return onSale ? 'AVERAGE' : 'WAIT';
}

const AFF = "a_aid=69cb95abe1763";
const pbLink = (path: string) =>
  !path ? '#' : path.startsWith('http') ? path : `https://www.pluginboutique.com${path}?${AFF}`;

interface HistoryEntry {
  date: string;
  regular: number | null;
  sale: number | null;
  source: string;
}

interface BundleData {
  pb_url: string;
  typical_regular: number | null;
  typical_sale: number | null;
  all_time_low: number | null;
  notes?: string;
  category?: string;
  history: HistoryEntry[];
}

interface PriceData {
  last_updated: string;
  bundles: Record<string, BundleData>;
  plugins?: Record<string, BundleData>;
}

const data = priceData as PriceData;
const { last_updated, bundles } = data;
const plugins = data.plugins ?? {};

function formatPrice(val: number | null): string {
  if (val === null) return "—";
  return `$${val}`;
}

function formatDate(iso: string): string {
  return iso; // Already YYYY-MM-DD
}

function pctOff(sale: number | null, regular: number | null): number {
  if (sale === null || regular === null || regular <= 0 || sale >= regular) return 0;
  return Math.round((1 - sale / regular) * 100);
}

// Slug used for per-product pages: /plugin-prices/{slug}/
function slugify(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

const CATEGORIES = [
  'All', 'Synth', 'EQ', 'Compressor', 'Reverb', 'Saturation', 'Mastering',
  'Limiter', 'Instrument', 'Drums', 'Vocal', 'Bundle', 'Effects', 'Utility',
];

// Same brand-detection rules as /brands/index.astro. Keep this list in sync so
// the tracker facets never disagree with the site's canonical brand pages.
const BRAND_ALIASES: Array<{ canonical: string; prefixes: string[] }> = [
  { canonical: 'FabFilter', prefixes: ['FabFilter'] },
  { canonical: 'u-he', prefixes: ['u-he'] },
  { canonical: 'Native Instruments', prefixes: ['Native Instruments', 'NI Komplete'] },
  { canonical: 'Arturia', prefixes: ['Arturia'] },
  { canonical: 'iZotope', prefixes: ['iZotope'] },
  { canonical: 'Waves', prefixes: ['Waves'] },
  { canonical: 'Soundtoys', prefixes: ['Soundtoys'] },
  { canonical: 'Softube', prefixes: ['Softube'] },
  { canonical: 'Plugin Alliance', prefixes: ['Plugin Alliance'] },
  { canonical: 'Universal Audio', prefixes: ['UAD', 'Universal Audio'] },
  { canonical: 'Spitfire Audio', prefixes: ['Spitfire Audio', 'Spitfire'] },
  { canonical: 'Output', prefixes: ['Output'] },
  { canonical: 'Baby Audio', prefixes: ['Baby Audio'] },
  { canonical: 'Cherry Audio', prefixes: ['Cherry Audio'] },
  { canonical: 'Kilohearts', prefixes: ['Kilohearts'] },
  { canonical: 'Xfer', prefixes: ['Xfer'] },
  { canonical: 'Spectrasonics', prefixes: ['Spectrasonics'] },
  { canonical: 'UVI', prefixes: ['UVI'] },
  { canonical: 'Toontrack', prefixes: ['Toontrack'] },
  { canonical: 'XLN Audio', prefixes: ['XLN Audio'] },
  { canonical: 'Slate Digital', prefixes: ['Slate Digital'] },
  { canonical: 'Valhalla', prefixes: ['Valhalla'] },
  { canonical: 'Eventide', prefixes: ['Eventide'] },
  { canonical: 'Sonnox', prefixes: ['Sonnox'] },
  { canonical: 'Cableguys', prefixes: ['Cableguys'] },
  { canonical: 'Newfangled Audio', prefixes: ['Newfangled Audio', 'Newfangled'] },
  { canonical: 'GForce', prefixes: ['GForce'] },
  { canonical: 'Sonible', prefixes: ['Sonible'] },
  { canonical: 'oeksound', prefixes: ['oeksound'] },
  { canonical: 'Wavesfactory', prefixes: ['Wavesfactory'] },
  { canonical: 'Klanghelm', prefixes: ['Klanghelm'] },
  { canonical: 'AudioThing', prefixes: ['AudioThing'] },
  { canonical: 'Denise Audio', prefixes: ['Denise Audio'] },
  { canonical: 'Minimal Audio', prefixes: ['Minimal Audio'] },
  { canonical: 'Excite Audio', prefixes: ['Excite Audio'] },
  { canonical: 'Heavyocity', prefixes: ['Heavyocity'] },
  { canonical: 'ProjectSAM', prefixes: ['ProjectSAM'] },
  { canonical: 'EastWest', prefixes: ['EastWest'] },
  { canonical: 'Vengeance', prefixes: ['Vengeance Sound', 'Vengeance'] },
  { canonical: 'reFX', prefixes: ['reFX'] },
  { canonical: 'Reveal Sound', prefixes: ['Reveal Sound'] },
  { canonical: 'KV331', prefixes: ['KV331 Audio', 'KV331'] },
  { canonical: 'LennarDigital', prefixes: ['LennarDigital'] },
  { canonical: 'Celemony', prefixes: ['Celemony'] },
  { canonical: 'Antares', prefixes: ['Antares'] },
  { canonical: 'Relab', prefixes: ['Relab Development', 'Relab'] },
  { canonical: 'LiquidSonics', prefixes: ['LiquidSonics'] },
  { canonical: 'DMG Audio', prefixes: ['DMG Audio'] },
  { canonical: 'GetGood Drums', prefixes: ['GetGood Drums'] },
];

function escapeRegExp(s: string): string {
  return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

const brandPrefixes = BRAND_ALIASES
  .flatMap(({ canonical, prefixes }) => prefixes.map((prefix) => ({ prefix, canonical })))
  .sort((a, b) => b.prefix.length - a.prefix.length);

function detectDeveloper(name: string, notes: string | undefined): string | null {
  for (const { prefix, canonical } of brandPrefixes) {
    if (name === prefix || name.startsWith(`${prefix} `)) return canonical;
  }
  if (notes) {
    for (const { prefix, canonical } of brandPrefixes) {
      if (new RegExp(`\\b${escapeRegExp(prefix)}\\b`).test(notes)) return canonical;
    }
  }
  return null;
}

// Infers a category tag from the entry's own `category` field when present,
// otherwise from keyword matches against its name, notes and PB catalog URL
// (which often carries a real category segment, e.g. "/16-EQ/", "/4-Synth/").
// Falls back to "Bundle" for bundle-section rows or "Effects" otherwise —
// never guesses more specifically than the data supports.
function inferCategory(name: string, notes: string | undefined, pbUrl: string, isBundleSection: boolean): string {
  const haystack = `${name} ${notes ?? ''} ${pbUrl}`.toLowerCase();

  // A handful of well-known naming conventions in this niche (FabFilter's
  // Pro-X product codes, well-known synth names) that plain keywords miss.
  if (/\bpro-r\b/.test(haystack)) return 'Reverb';
  if (/\bpro-c\b/.test(haystack)) return 'Compressor';
  if (/\bpro-l\b/.test(haystack)) return 'Limiter';
  if (/\bpro-mb\b/.test(haystack)) return 'Compressor';
  if (/\bpro-ds\b/.test(haystack)) return 'Vocal';
  if (/\b(serum|omnisphere|nexus|sylenth1?|vital)\b/.test(haystack)) return 'Synth';

  if (/\breverb\b/.test(haystack)) return 'Reverb';
  if (/\beq\b/.test(haystack)) return 'EQ';
  if (/\bcomp(?:ressor)?\b/.test(haystack)) return 'Compressor';
  if (/synth/.test(haystack)) return 'Synth';
  if (/tape|saturat/.test(haystack)) return 'Saturation';
  if (/master|ozone/.test(haystack)) return 'Mastering';
  if (/\blimit(?:er)?\b/.test(haystack)) return 'Limiter';
  if (/drum/.test(haystack)) return 'Drums';
  if (/tune|vocal|melodyne/.test(haystack)) return 'Vocal';
  if (/bundle|collection/.test(haystack)) return 'Bundle';
  if (/instrument|orchestral|piano|guitar|\borgan\b|strings|choir|brass/.test(haystack)) return 'Instrument';
  if (/utility|\bmeter\b|analy[sz]|loudness/.test(haystack)) return 'Utility';

  return isBundleSection ? 'Bundle' : 'Effects';
}

// Finds the date a bundle's recorded all_time_low actually happened, when it
// matches a logged history entry. Returns null rather than guessing.
function findLowestDate(bundle: BundleData): string | null {
  if (bundle.all_time_low === null) return null;
  const match = bundle.history.find((h) => (h.sale ?? h.regular) === bundle.all_time_low);
  return match ? match.date : null;
}

interface Row {
  name: string;
  slug: string;
  category: string;
  developer: string | null;
  bundle: BundleData;
  current: number | null;
  regular: number | null;
  currentIsSale: boolean;
  off: number;
  dealScore: ReturnType<typeof dealScoreNumeric>;
  pts: string | null;
  lowestDate: string | null;
  searchText: string;
}

function buildRow(name: string, bundle: BundleData, isBundleSection: boolean): Row {
  const latest = bundle.history.at(-1);
  const regular = latest?.regular ?? null;
  const sale = latest?.sale ?? null;
  const developer = detectDeveloper(name, bundle.notes);
  return {
    name,
    slug: slugify(name),
    category: bundle.category ?? inferCategory(name, bundle.notes, bundle.pb_url, isBundleSection),
    developer,
    bundle,
    current: sale ?? regular,
    regular,
    currentIsSale: sale !== null,
    off: pctOff(sale, regular),
    dealScore: dealScoreNumeric(bundle),
    pts: sparklinePoints(bundle.history),
    lowestDate: findLowestDate(bundle),
    searchText: `${name} ${developer ?? ''} ${bundle.notes ?? ''}`.toLowerCase(),
  };
}

const pluginRows = Object.entries(plugins)
  .map(([name, b]) => buildRow(name, b, false))
  .sort((a, b) => b.off - a.off);

const bundleRows = Object.entries(bundles)
  .map(([name, b]) => buildRow(name, b, true))
  .sort((a, b) => b.off - a.off);

const allRows = [...pluginRows, ...bundleRows];
const totalTracked = allRows.length;
const categoryCounts = new Map<string, number>();
const developerCounts = new Map<string, number>();
for (const row of allRows) {
  categoryCounts.set(row.category, (categoryCounts.get(row.category) ?? 0) + 1);
  if (row.developer) developerCounts.set(row.developer, (developerCounts.get(row.developer) ?? 0) + 1);
}
const developers = [...developerCounts.entries()]
  .filter(([, count]) => count >= 2)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name));
const onSaleCount = allRows.filter(
  (r) => r.currentIsSale && r.bundle.typical_regular !== null && r.current !== null && r.current < r.bundle.typical_regular
).length;

const pageLD = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "VST Plugin Price Tracker — Bundles & Individual Plugins",
  "description": "Track current and historical prices for major VST plugins and bundles at Plugin Boutique. FabFilter, Kilohearts, iZotope, Waves, Serum 2 and more. Updated regularly.",
  "url": "https://plugindrop.net/plugin-prices/",
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Plugin Bundle Price Tracker — VST Bundle Price History | ${SITE_TITLE}`}
      description="Track current and historical prices for major VST plugin bundles at Plugin Boutique: FabFilter, NI Komplete, iZotope, Arturia, Waves, Soundtoys. Updated weekly."
    />
    <script type="application/ld+json" set:html={JSON.stringify(pageLD)} />
    <style>
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; }

      .page-header { margin-bottom: 1.5rem; max-width: 720px; }
      .page-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0 0 0.6rem; line-height: 1.2; }
      .page-header .subtitle { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0 0 0.4rem; }
      .page-header .meta { font-size: 0.78rem; color: var(--text-muted); }
      .page-header .meta a { color: var(--accent); }

      /* Stat chips */
      .stats-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.25rem 0 2.25rem; }
      .stat-chip {
        display: flex; align-items: center; gap: 0.65rem;
        background: var(--bg-card); border: 1px solid var(--border);
        padding: 0.6rem 1rem; border-radius: 8px;
      }
      .stat-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
      .stat-dot.sale { background: var(--sale-text); }
      .stat-label { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); margin: 0 0 0.15rem; }
      .stat-value {
        font-size: 0.95rem; font-weight: 800; color: var(--text-primary);
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
      }

      h2.section-title {
        font-size: 1.1rem; font-weight: 800; margin: 0 0 1rem; color: var(--text-primary);
        padding-top: 0.5rem;
      }

      /* Toolbar: search + active filters */
      .tracker-toolbar {
        position: sticky;
        top: 0;
        z-index: 5;
        background: var(--bg-base);
        padding: 0.85rem 0 1rem;
        margin: 0 0 1.75rem;
        border-bottom: 1px solid var(--border);
      }
      .search-wrap {
        display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;
        margin-bottom: 0.85rem;
      }
      .search-input {
        flex: 1 1 260px; min-width: 200px;
        background: var(--bg-card); border: 1px solid var(--border); color: var(--text-primary);
        padding: 0.55rem 0.9rem; border-radius: 8px; font-size: 0.9rem; font-family: inherit;
      }
      .search-input::placeholder { color: var(--text-muted); }
      .search-input:focus { outline: none; border-color: var(--accent-border-hover); }
      .search-count { font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; }
      .search-updated { font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; }

      .active-filter-row { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
      .active-filter-row[hidden] { display: none; }
      .active-filter-label {
        color: var(--text-muted); font-size: 0.68rem; font-weight: 700;
        letter-spacing: 0.06em; text-transform: uppercase;
      }
      :global(.active-filter-chip) {
        padding: 0.3rem 0.65rem; border-radius: 999px;
        border: 1px solid var(--border); background: var(--bg-card);
        color: var(--text-secondary); font-size: 0.72rem; font-weight: 600;
        cursor: pointer; transition: background 0.15s, border-color 0.15s, color 0.15s;
        white-space: nowrap; font-family: inherit;
      }
      :global(.active-filter-chip:hover) { border-color: var(--accent); color: var(--text-primary); }
      .clear-filters {
        border: 0; background: none; color: var(--accent); padding: 0.3rem;
        font: inherit; font-size: 0.72rem; cursor: pointer;
      }
      .clear-filters:hover { color: var(--accent-light); }

      /* Faceted tracker layout */
      .tracker-layout {
        display: grid; grid-template-columns: 220px minmax(0, 1fr);
        gap: 1.5rem; align-items: start;
      }
      .tracker-sidebar {
        position: sticky; top: 6rem; max-height: calc(100vh - 7rem); overflow-y: auto;
        border: 1px solid var(--border); background: var(--bg-low); border-radius: var(--radius);
      }
      .facet-panel summary {
        padding: 0.8rem 1rem; color: var(--text-primary); cursor: pointer;
        font-size: 0.8rem; font-weight: 700; border-bottom: 1px solid var(--border);
      }
      .facet-panel:not([open]) summary { border-bottom: 0; }
      .facet-body { padding: 0 1rem; }
      .facet-section { padding: 1rem 0; border-bottom: 1px solid var(--border); }
      .facet-section:last-child { border-bottom: 0; }
      .facet-heading {
        margin: 0 0 0.65rem; color: var(--text-muted); font-size: 0.68rem;
        font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      }
      .facet-options { display: grid; gap: 0.25rem; }
      .facet-options.developers { max-height: 13rem; overflow-y: auto; padding-right: 0.2rem; }
      .tracker-sidebar::-webkit-scrollbar,
      .facet-options.developers::-webkit-scrollbar { width: 4px; }
      .tracker-sidebar::-webkit-scrollbar-track,
      .facet-options.developers::-webkit-scrollbar-track { background: transparent; }
      .tracker-sidebar::-webkit-scrollbar-thumb,
      .facet-options.developers::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
      .tracker-sidebar::-webkit-scrollbar-thumb:hover,
      .facet-options.developers::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }
      .tracker-sidebar { scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
      .facet-options.developers { scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
      .facet-option {
        display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
        min-width: 0; padding: 0.2rem 0; color: var(--text-secondary); cursor: pointer;
        font-size: 0.78rem;
      }
      .facet-option-main { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
      .facet-option-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .facet-option input { accent-color: var(--accent); flex: 0 0 auto; }
      .facet-count { color: var(--text-muted); font-size: 0.68rem; }
      .score-control-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
      .score-control-head .facet-heading { margin-bottom: 0; }
      .score-value { color: var(--accent); font-size: 0.72rem; }
      .score-range { width: 100%; margin-top: 0.75rem; accent-color: var(--accent); }
      .tracker-results { min-width: 0; }

      @media (max-width: 800px) {
        .tracker-toolbar { position: static; }
        .tracker-layout { grid-template-columns: 1fr; gap: 1rem; }
        .tracker-sidebar { position: static; max-height: none; overflow: visible; }
        .facet-body { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.5rem; }
        .facet-section { min-width: 0; }
        .facet-section:last-child { border-bottom: 1px solid var(--border); }
      }

      /* Ledger table */
      .ledger-wrap {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--bg-card);
        margin-bottom: 3rem;
        -webkit-overflow-scrolling: touch;
      }
      .ledger-table { width: 100%; min-width: 700px; border-collapse: collapse; font-size: 0.85rem; }
      .ledger-table thead th {
        text-align: left; padding: 0.65rem 1rem; background: var(--bg-low);
        color: var(--text-muted); font-size: 0.68rem; text-transform: uppercase;
        letter-spacing: 0.06em; font-weight: 700; white-space: nowrap;
        border-bottom: 1px solid var(--border);
      }
      .ledger-table thead th[data-sort] { cursor: pointer; user-select: none; }
      .ledger-table thead th[data-sort]:hover { color: var(--text-secondary); }
      .ledger-table thead th[data-sort]::after {
        content: '\2195'; display: inline-block; margin-left: 0.35em; opacity: 0.35; font-size: 0.85em;
      }
      .ledger-table thead th[data-sort].sorted-asc::after { content: '\2191'; opacity: 1; color: var(--accent); }
      .ledger-table thead th[data-sort].sorted-desc::after { content: '\2193'; opacity: 1; color: var(--accent); }

      .no-results-row td {
        text-align: center; padding: 2rem 1rem; color: var(--text-muted);
        font-size: 0.9rem; font-style: italic;
      }
      .ledger-table tbody tr { border-bottom: 1px solid var(--border-light); transition: background 0.15s; }
      .ledger-table tbody tr:last-child { border-bottom: none; }
      .ledger-table tbody tr:nth-child(even) { background: rgba(255, 255, 255, 0.015); }
      .ledger-table tbody tr:hover { background: var(--bg-card-hover); }
      .ledger-table tbody tr.is-sale td:first-child { box-shadow: inset 3px 0 0 var(--sale-text); }
      .ledger-table td { padding: 0.75rem 1rem; vertical-align: middle; color: var(--text-secondary); }

      .mono {
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
        font-variant-numeric: tabular-nums;
      }

      .plugin-name-link { font-weight: 700; color: var(--text-primary); font-size: 0.95rem; text-decoration: none; }
      .plugin-name-link:hover { color: var(--accent); }
      .plugin-notes {
        font-size: 0.72rem; color: var(--text-muted); margin-top: 0.2rem;
        line-height: 1.4; max-width: 300px;
      }
      .cat-tag {
        display: inline-block; margin-top: 0.35rem; padding: 0.1rem 0.5rem; border-radius: 4px;
        background: var(--tag-bg); color: var(--tag-text); font-size: 0.64rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.05em;
      }

      .price-current { font-size: 1rem; font-weight: 800; color: var(--text-primary); }
      .price-current.on-sale { color: var(--sale-text); }
      .price-regular-strike { text-decoration: line-through; color: var(--text-muted); font-weight: 400; }

      .off-badge {
        display: inline-block; padding: 0.15rem 0.55rem; border-radius: 4px;
        background: var(--sale-bg); color: var(--sale-text);
        font-weight: 700; font-size: 0.78rem; white-space: nowrap;
      }
      .off-none { color: var(--text-muted); }

      .score-badge {
        display: inline-block; min-width: 2.25rem; padding: 0.15rem 0.45rem;
        border-radius: var(--radius-sm); text-align: center; font-weight: 700; font-size: 0.78rem;
      }
      .score-badge.good { background: var(--verdict-good); color: var(--bg-base); }
      .score-badge.ok { background: var(--verdict-ok); color: var(--bg-base); }
      .score-badge.bad { background: var(--verdict-bad); color: var(--text-primary); }
      .verdict-chip-card {
        display: inline-block;
        font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.07em; padding: 0.15rem 0.45rem;
        border-radius: 4px; border: 1px solid currentColor;
        background: color-mix(in srgb, currentColor 10%, transparent);
        white-space: nowrap; margin-left: 0.35rem; vertical-align: middle;
      }
      .vchip-buy  { color: #4ade80; }
      .vchip-fair { color: #facc15; }
      .vchip-avg  { color: var(--text-muted); }
      .score-none { color: var(--text-muted); }
      .score-legend {
        margin: 0.75rem 0; color: var(--text-muted); font-size: 0.7rem;
      }

      .spark-svg { display: block; }
      .spark-placeholder { color: var(--text-muted); font-size: 0.85rem; }

      .low-price { font-weight: 700; color: var(--text-primary); }
      .low-date { font-size: 0.68rem; color: var(--text-muted); margin-top: 0.15rem; }
      .low-none { font-size: 0.75rem; color: var(--text-muted); font-style: italic; white-space: nowrap; }

      .cta-btn-sm {
        display: inline-block; padding: 0.4rem 0.85rem; border-radius: 6px;
        background: var(--accent-muted); color: var(--accent-light);
        text-decoration: none; font-size: 0.78rem; font-weight: 700; white-space: nowrap;
        transition: background 0.15s, color 0.15s;
      }
      .cta-btn-sm:hover { background: var(--accent); color: #0b0e0d; }

      /* Footer note */
      .footer-note {
        margin-top: 1rem; padding: 1.25rem 1.5rem;
        border-left: 3px solid var(--accent-muted);
        color: var(--text-secondary); font-size: 0.875rem; line-height: 1.7;
      }
      .footer-note p { margin: 0 0 0.4rem; }
      .footer-note p:last-child { margin: 0; }

      @media (max-width: 480px) {
        .page-header h1 { font-size: 1.5rem; }
        .stats-row { gap: 0.5rem; }
        .stat-chip { padding: 0.5rem 0.75rem; }
        .facet-body { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="sr-only">Skip to content</a>
    <Header />
    <main id="main-content">
      <div class="page-header">
        <h1>VST Plugin Price Tracker</h1>
        <p class="subtitle">
          Historical prices for major VST plugins and bundles — like CamelCamelCamel, but for music software.
          Know the real value before you buy: see typical sale prices, lowest tracked prices, and when to wait.
        </p>
        <p class="meta">
          <a href="#individual">Individual Plugins</a> &nbsp;·&nbsp;
          <a href="#bundles">Plugin Bundles</a>
        </p>
      </div>

      <div class="stats-row">
        <div class="stat-chip">
          <span class="stat-dot"></span>
          <div>
            <p class="stat-label">Plugins Tracked</p>
            <p class="stat-value">{totalTracked}</p>
          </div>
        </div>
        <div class="stat-chip">
          <span class="stat-dot sale"></span>
          <div>
            <p class="stat-label">On Sale Now</p>
            <p class="stat-value">{onSaleCount}</p>
          </div>
        </div>
        <div class="stat-chip">
          <span class="stat-dot"></span>
          <div>
            <p class="stat-label">Last Checked</p>
            <p class="stat-value">{last_updated}</p>
          </div>
        </div>
      </div>

      <div class="tracker-toolbar">
        <div class="search-wrap">
          <input
            type="search"
            id="plugin-search"
            class="search-input"
            placeholder="Search plugins, developers, notes…"
            aria-label="Search tracked plugins"
            autocomplete="off"
          />
          <span class="search-count" id="search-count">Showing {totalTracked} of {totalTracked}</span>
          <span class="search-updated">Last updated {last_updated}</span>
        </div>
        <div class="active-filter-row" id="active-filters" aria-label="Active filters" hidden>
          <span class="active-filter-label">Active</span>
          <div class="active-filter-row" id="active-filter-chips"></div>
          <button type="button" class="clear-filters" id="clear-filters">Clear all</button>
        </div>
      </div>

      <div class="tracker-layout">
        <aside class="tracker-sidebar" aria-label="Price tracker filters">
          <details class="facet-panel" id="facet-panel" open>
            <summary>Filters <span class="mono" id="filter-summary-count"></span></summary>
            <div class="facet-body">
              <section class="facet-section" aria-labelledby="category-filter-heading">
                <h2 class="facet-heading" id="category-filter-heading">Categories</h2>
                <div class="facet-options" id="category-filters">
                  {CATEGORIES.map((cat) => (
                    <label class="facet-option">
                      <span class="facet-option-main">
                        <input
                          type="checkbox"
                          name="tracker-category"
                          value={cat}
                          data-cat={cat}
                          checked={cat === 'All'}
                        />
                        <span class="facet-option-name">{cat}</span>
                      </span>
                      <span class="facet-count mono">{cat === 'All' ? totalTracked : (categoryCounts.get(cat) ?? 0)}</span>
                    </label>
                  ))}
                </div>
              </section>

              <section class="facet-section" aria-labelledby="developer-filter-heading">
                <h2 class="facet-heading" id="developer-filter-heading">Developers</h2>
                <div class="facet-options developers" id="developer-filters">
                  {developers.map((developer) => (
                    <label class="facet-option">
                      <span class="facet-option-main">
                        <input type="checkbox" value={developer.name} />
                        <span class="facet-option-name">{developer.name}</span>
                      </span>
                      <span class="facet-count mono">{developer.count}</span>
                    </label>
                  ))}
                </div>
              </section>

              <section class="facet-section" aria-labelledby="score-filter-heading">
                <div class="score-control-head">
                  <h2 class="facet-heading" id="score-filter-heading">Min Score</h2>
                  <output class="score-value mono" id="score-filter-value" for="score-filter">0</output>
                </div>
                <input
                  class="score-range"
                  type="range"
                  id="score-filter"
                  min="0"
                  max="100"
                  step="1"
                  value="0"
                  aria-label="Minimum deal score"
                />
              </section>
            </div>
          </details>
        </aside>

        <div class="tracker-results">
          <p class="score-legend mono">Deal Score: 100 = at all-time low · 0 = regular price · — = no discount history. Green ≥70 · Amber ≥40 · Red &lt;40</p>

          <h2 id="individual" class="section-title">Individual Plugins</h2>
          <div class="ledger-wrap">
        <table class="ledger-table">
          <thead>
            <tr>
              <th data-sort="name">Plugin</th>
              <th data-sort="price">Current</th>
              <th>Regular</th>
              <th data-sort="off" data-dir="desc" class="sorted-desc">% Off</th>
              <th data-sort="score">Score</th>
              <th>Trend</th>
              <th data-sort="low">Lowest Tracked</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {pluginRows.map((row) => (
              <tr
                class={row.currentIsSale ? 'ledger-row is-sale' : 'ledger-row'}
                data-category={row.category}
                data-developer={row.developer ?? ''}
                data-search={row.searchText}
                data-name={row.name.toLowerCase()}
                data-price={row.current ?? ''}
                data-off={row.off}
                data-score={row.dealScore.verdict === 'none' ? '' : row.dealScore.score}
                data-low={row.bundle.all_time_low ?? ''}
              >
                <td>
                  <a
                    href={`/plugin-prices/${row.slug}/`}
                    class="plugin-name-link"
                  >
                    {row.name}
                  </a>
                  {row.bundle.notes && <div class="plugin-notes">{row.bundle.notes}</div>}
                  <div class="cat-tag">{row.category}</div>
                </td>
                <td class="mono">
                  <span class={row.currentIsSale ? 'price-current on-sale' : 'price-current'}>
                    {formatPrice(row.current)}
                  </span>
                </td>
                <td class="mono">
                  {row.currentIsSale ? (
                    <span class="price-regular-strike">{formatPrice(row.regular)}</span>
                  ) : (
                    <span>{formatPrice(row.regular)}</span>
                  )}
                </td>
                <td>
                  {row.off > 0 ? <span class="off-badge">-{row.off}%</span> : <span class="off-none">—</span>}
                </td>
                <td class="mono">
                  {row.dealScore.verdict === 'none' ? (
                    <span class="score-none" title="No discount history — price is stable">—</span>
                  ) : (() => {
                    const onSale = row.current !== null && row.regular !== null && (row.current < row.regular);
                    const label = fableVerdictLabel(row.dealScore.verdict, onSale);
                    const chipCls = row.dealScore.verdict === 'good' ? 'vchip-buy' : row.dealScore.verdict === 'ok' ? 'vchip-fair' : 'vchip-avg';
                    return (
                      <>
                        <span class={`score-badge ${row.dealScore.verdict}`}>{row.dealScore.score}</span>
                        <span class={`verdict-chip-card ${chipCls}`}>{label}</span>
                      </>
                    );
                  })()}
                </td>
                <td>
                  {row.pts ? (
                    <svg
                      class="spark-svg"
                      width="72"
                      height="26"
                      viewBox="0 0 100 28"
                      preserveAspectRatio="none"
                      aria-hidden="true"
                    >
                      <polyline
                        points={row.pts}
                        fill="none"
                        stroke={row.currentIsSale ? 'var(--sale-text)' : 'var(--accent)'}
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  ) : (
                    <span class="spark-placeholder">—</span>
                  )}
                </td>
                <td>
                  {row.bundle.all_time_low !== null ? (
                    <>
                      <div class="mono low-price">{formatPrice(row.bundle.all_time_low)}</div>
                      {row.lowestDate && <div class="low-date">{formatDate(row.lowestDate)}</div>}
                    </>
                  ) : (
                    <span class="low-none">tracking since 2026</span>
                  )}
                </td>
                <td>
                  <a
                    href={pbLink(row.bundle.pb_url)}
                    class="cta-btn-sm"
                    target="_blank"
                    rel="noopener sponsored"
                  >
                    Get deal
                  </a>
                </td>
              </tr>
            ))}
            <tr class="no-results-row" style="display: none;">
              <td colspan="8">No plugins match — try another search or category.</td>
            </tr>
          </tbody>
        </table>
          </div>

          <h2 id="bundles" class="section-title">Plugin Bundles</h2>
          <div class="ledger-wrap">
        <table class="ledger-table">
          <thead>
            <tr>
              <th data-sort="name">Bundle</th>
              <th data-sort="price">Current</th>
              <th>Regular</th>
              <th data-sort="off" data-dir="desc" class="sorted-desc">% Off</th>
              <th data-sort="score">Score</th>
              <th>Trend</th>
              <th data-sort="low">Lowest Tracked</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {bundleRows.map((row) => (
              <tr
                class={row.currentIsSale ? 'ledger-row is-sale' : 'ledger-row'}
                data-category={row.category}
                data-developer={row.developer ?? ''}
                data-search={row.searchText}
                data-name={row.name.toLowerCase()}
                data-price={row.current ?? ''}
                data-off={row.off}
                data-score={row.dealScore.verdict === 'none' ? '' : row.dealScore.score}
                data-low={row.bundle.all_time_low ?? ''}
              >
                <td>
                  <a
                    href={`/plugin-prices/${row.slug}/`}
                    class="plugin-name-link"
                  >
                    {row.name}
                  </a>
                  {row.bundle.notes && <div class="plugin-notes">{row.bundle.notes}</div>}
                  <div class="cat-tag">{row.category}</div>
                </td>
                <td class="mono">
                  <span class={row.currentIsSale ? 'price-current on-sale' : 'price-current'}>
                    {formatPrice(row.current)}
                  </span>
                </td>
                <td class="mono">
                  {row.currentIsSale ? (
                    <span class="price-regular-strike">{formatPrice(row.regular)}</span>
                  ) : (
                    <span>{formatPrice(row.regular)}</span>
                  )}
                </td>
                <td>
                  {row.off > 0 ? <span class="off-badge">-{row.off}%</span> : <span class="off-none">—</span>}
                </td>
                <td class="mono">
                  {row.dealScore.verdict === 'none' ? (
                    <span class="score-none" title="No discount history — price is stable">—</span>
                  ) : (() => {
                    const onSale = row.current !== null && row.regular !== null && (row.current < row.regular);
                    const label = fableVerdictLabel(row.dealScore.verdict, onSale);
                    const chipCls = row.dealScore.verdict === 'good' ? 'vchip-buy' : row.dealScore.verdict === 'ok' ? 'vchip-fair' : 'vchip-avg';
                    return (
                      <>
                        <span class={`score-badge ${row.dealScore.verdict}`}>{row.dealScore.score}</span>
                        <span class={`verdict-chip-card ${chipCls}`}>{label}</span>
                      </>
                    );
                  })()}
                </td>
                <td>
                  {row.pts ? (
                    <svg
                      class="spark-svg"
                      width="72"
                      height="26"
                      viewBox="0 0 100 28"
                      preserveAspectRatio="none"
                      aria-hidden="true"
                    >
                      <polyline
                        points={row.pts}
                        fill="none"
                        stroke={row.currentIsSale ? 'var(--sale-text)' : 'var(--accent)'}
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  ) : (
                    <span class="spark-placeholder">—</span>
                  )}
                </td>
                <td>
                  {row.bundle.all_time_low !== null ? (
                    <>
                      <div class="mono low-price">{formatPrice(row.bundle.all_time_low)}</div>
                      {row.lowestDate && <div class="low-date">{formatDate(row.lowestDate)}</div>}
                    </>
                  ) : (
                    <span class="low-none">tracking since 2026</span>
                  )}
                </td>
                <td>
                  <a
                    href={pbLink(row.bundle.pb_url)}
                    class="cta-btn-sm"
                    target="_blank"
                    rel="noopener sponsored"
                  >
                    Get deal
                  </a>
                </td>
              </tr>
            ))}
            <tr class="no-results-row" style="display: none;">
              <td colspan="8">No plugins match — try another search or category.</td>
            </tr>
          </tbody>
        </table>
          </div>
        </div>
      </div>

      <div class="footer-note">
        <p>
          <strong>How this works:</strong> Prices are checked weekly via Plugin Boutique and logged automatically.
          "Regular" and "Current" reflect the most recent check. "Lowest tracked" is the lowest price we have
          recorded since we began tracking in 2026 — not a guaranteed historical minimum. Rows sorted by biggest
          current discount first.
        </p>
        <p>
          Prices change frequently — Plugin Boutique runs flash sales, anniversary promotions, and manufacturer-specific events throughout the year.
          Use this tracker to decide when to buy, not just whether to buy.
        </p>
        <p>
          Last checked: {last_updated} &nbsp;|&nbsp;
          <a href="/about#affiliate" style="color: var(--accent);">Affiliate disclosure</a> &nbsp;|&nbsp;
          <a href="/bundle-comparison/" style="color: var(--accent);">Compare bundles by $/plugin</a>
        </p>
      </div>
    </main>
    <Footer />
    <script>
      (function () {
        const searchInput = document.getElementById('plugin-search');
        const countLabel = document.getElementById('search-count');
        const categoryFilters = document.getElementById('category-filters');
        const developerFilters = document.getElementById('developer-filters');
        const scoreFilter = document.getElementById('score-filter');
        const scoreValue = document.getElementById('score-filter-value');
        const activeFilters = document.getElementById('active-filters');
        const activeFilterChips = document.getElementById('active-filter-chips');
        const clearFilters = document.getElementById('clear-filters');
        const filterSummaryCount = document.getElementById('filter-summary-count');
        const tables = Array.from(document.querySelectorAll('.ledger-table'));
        let activeCategory = 'all';
        const activeDevelopers = new Set();
        let minScore = 0;

        function parseNum(str) {
          if (str === null || str === undefined || str === '') return null;
          const n = parseFloat(str);
          return Number.isNaN(n) ? null : n;
        }

        function getDataRows(table) {
          return Array.from(table.querySelectorAll('tbody > tr.ledger-row'));
        }

        function categoryInputs() {
          return categoryFilters ? Array.from(categoryFilters.querySelectorAll('input[data-cat]')) : [];
        }

        function setCategory(category) {
          const requested = (category || 'all').toLowerCase();
          const matchingInput = categoryInputs().find(
            (input) => (input.getAttribute('data-cat') || '').toLowerCase() === requested
          );
          activeCategory = matchingInput ? requested : 'all';
          categoryInputs().forEach((input) => {
            const value = (input.getAttribute('data-cat') || '').toLowerCase();
            input.checked = value === activeCategory;
          });
        }

        function addActiveChip(label, type, value) {
          if (!activeFilterChips) return;
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'active-filter-chip';
          chip.setAttribute('data-filter-type', type);
          chip.setAttribute('data-filter-value', value);
          chip.setAttribute('aria-label', `Remove ${label} filter`);
          chip.textContent = `${label} ×`;
          activeFilterChips.appendChild(chip);
        }

        function renderActiveFilters() {
          if (!activeFilterChips || !activeFilters) return;
          activeFilterChips.replaceChildren();
          let count = 0;
          if (activeCategory !== 'all') {
            const categoryLabel = categoryInputs().find(
              (input) => (input.getAttribute('data-cat') || '').toLowerCase() === activeCategory
            )?.getAttribute('data-cat') || activeCategory;
            addActiveChip(`Category: ${categoryLabel}`, 'category', activeCategory);
            count++;
          }
          activeDevelopers.forEach((developer) => {
            addActiveChip(`Developer: ${developer}`, 'developer', developer);
            count++;
          });
          if (minScore > 0) {
            addActiveChip(`Score: ${minScore}+`, 'score', String(minScore));
            count++;
          }
          activeFilters.hidden = count === 0;
          if (filterSummaryCount) filterSummaryCount.textContent = count > 0 ? `(${count})` : '';
        }

        function applyFilters() {
          const q = ((searchInput && searchInput.value) || '').trim().toLowerCase();
          let totalVisible = 0;
          let totalAll = 0;

          tables.forEach((table) => {
            const rows = getDataRows(table);
            let visibleInTable = 0;
            rows.forEach((row) => {
              totalAll++;
              const cat = (row.getAttribute('data-category') || '').toLowerCase();
              const developer = row.getAttribute('data-developer') || '';
              const search = row.getAttribute('data-search') || '';
              const score = parseNum(row.getAttribute('data-score'));
              const matchesCategory = activeCategory === 'all' || cat === activeCategory;
              const matchesDevelopers = Array.from(activeDevelopers).every((selected) => developer === selected);
              const matchesScore = minScore === 0 || (score !== null && score >= minScore);
              const matchesSearch = q === '' || search.indexOf(q) !== -1;
              const visible = matchesCategory && matchesDevelopers && matchesScore && matchesSearch;
              row.style.display = visible ? '' : 'none';
              if (visible) {
                visibleInTable++;
                totalVisible++;
              }
            });
            const noResultsRow = table.querySelector('.no-results-row');
            if (noResultsRow) {
              noResultsRow.style.display = visibleInTable === 0 ? '' : 'none';
            }
          });

          if (countLabel) {
            countLabel.textContent = `Showing ${totalVisible} of ${totalAll}`;
          }
          renderActiveFilters();
        }

        if (searchInput) {
          searchInput.addEventListener('input', applyFilters);
          const initialQ = new URLSearchParams(window.location.search).get('q');
          if (initialQ) {
            searchInput.value = initialQ;
            searchInput.focus();
          }
        }

        if (categoryFilters) {
          const initialCategory = new URLSearchParams(window.location.search).get('category');
          if (initialCategory) setCategory(initialCategory);

          categoryFilters.addEventListener('change', (e) => {
            const target = e.target.closest('input[data-cat]');
            if (!target || !categoryFilters.contains(target)) return;
            const category = target.checked ? (target.getAttribute('data-cat') || 'all') : 'all';
            setCategory(category);
            applyFilters();
          });
        }

        if (developerFilters) {
          developerFilters.addEventListener('change', (e) => {
            const target = e.target.closest('input[type="checkbox"]');
            if (!target || !developerFilters.contains(target)) return;
            if (target.checked) activeDevelopers.add(target.value);
            else activeDevelopers.delete(target.value);
            applyFilters();
          });
        }

        if (scoreFilter) {
          scoreFilter.addEventListener('input', () => {
            minScore = Number(scoreFilter.value) || 0;
            if (scoreValue) scoreValue.textContent = String(minScore);
            applyFilters();
          });
        }

        if (activeFilterChips) {
          activeFilterChips.addEventListener('click', (e) => {
            const chip = e.target.closest('.active-filter-chip');
            if (!chip || !activeFilterChips.contains(chip)) return;
            const type = chip.getAttribute('data-filter-type');
            const value = chip.getAttribute('data-filter-value') || '';
            if (type === 'category') setCategory('all');
            if (type === 'developer') {
              activeDevelopers.delete(value);
              if (developerFilters) {
                const input = Array.from(developerFilters.querySelectorAll('input')).find((item) => item.value === value);
                if (input) input.checked = false;
              }
            }
            if (type === 'score') {
              minScore = 0;
              if (scoreFilter) scoreFilter.value = '0';
              if (scoreValue) scoreValue.textContent = '0';
            }
            applyFilters();
          });
        }

        function resetFacetFilters() {
          setCategory('all');
          activeDevelopers.clear();
          if (developerFilters) {
            developerFilters.querySelectorAll('input[type="checkbox"]').forEach((input) => { input.checked = false; });
          }
          minScore = 0;
          if (scoreFilter) scoreFilter.value = '0';
          if (scoreValue) scoreValue.textContent = '0';
          applyFilters();
          const badge = document.querySelector('.tracker-toolbar .pd-badge');
          if (badge) badge.remove();
        }

        if (clearFilters) clearFilters.addEventListener('click', resetFacetFilters);

        // P2: トラッカー初期フィルタ — URLに?q=が無く、pd_profile_v1/pd_session_v1
        // の合成スコア最上位カテゴリが確定している（合計シグナル>=2）場合、対応する
        // カテゴリチップを初期activeにしてapplyFilters()する。マッピングが無い
        // カテゴリ（一致するものだけ）は何もしない。
        (function personalizeInitialFilter() {
          try {
            if (!categoryFilters || !searchInput) return;
            const searchParams = new URLSearchParams(window.location.search);
            if (searchParams.get('q') || searchParams.get('category')) return;

            // NW-H CATS（PersonalizationScript.astroと同一の10カテゴリ）
            const CATS = ['synth', 'guitar-bass', 'drums', 'vocals', 'orchestral', 'mixing', 'effects', 'sampling', 'daw', 'free'];
            // data-cat（トラッカーのチップ値）と一致するものだけをマッピング
            const CAT_MAP = { synth: 'Synth', drums: 'Drums', vocals: 'Vocal', effects: 'Effects' };

            function loadJSON(storage, key) {
              try { return JSON.parse(storage.getItem(key)); } catch (e) { return null; }
            }
            const profileRaw = loadJSON(window.localStorage, 'pd_profile_v1');
            const session = loadJSON(window.sessionStorage, 'pd_session_v1') || {};
            const long = (profileRaw && profileRaw.long && typeof profileRaw.long === 'object') ? profileRaw.long : {};

            let bestCat = '';
            let bestScore = 0;
            let total = 0;
            CATS.forEach((cat) => {
              const sess = (typeof session[cat] === 'number' && isFinite(session[cat])) ? session[cat] : 0;
              const lng = (typeof long[cat] === 'number' && isFinite(long[cat])) ? long[cat] : 0;
              const score = 2 * sess + lng;
              total += sess + lng;
              if (score > bestScore) { bestScore = score; bestCat = cat; }
            });
            if (total < 2 || !bestCat || !CAT_MAP[bestCat]) return;

            const chipValue = CAT_MAP[bestCat];
            const categoryInput = categoryInputs().find(
              (input) => (input.getAttribute('data-cat') || '') === chipValue
            );
            if (!categoryInput) return;

            setCategory(chipValue);
            applyFilters();

            // "Sorted for you · reset" バッジ（PersonalizationScript.astroと同じ枠を流用）
            const toolbar = categoryFilters.closest('main')?.querySelector('.tracker-toolbar');
            if (toolbar && !toolbar.querySelector('.pd-badge')) {
              const badge = document.createElement('span');
              badge.className = 'pd-badge';
              badge.style.cssText = 'font-size:.68rem;color:var(--text-muted);margin-left:.6rem;white-space:nowrap';
              badge.innerHTML = 'Sorted for you · <a href="#" class="pd-reset-filter" style="color:inherit;text-decoration:underline">reset</a>';
              toolbar.appendChild(badge);
              const resetLink = badge.querySelector('.pd-reset-filter');
              if (resetLink) {
                resetLink.addEventListener('click', (e) => {
                  e.preventDefault();
                  resetFacetFilters();
                });
              }
            }
          } catch (e) { /* noop */ }
        })();

        // Column sorting: click a sortable header to toggle asc/desc.
        // Values missing (empty string, e.g. "—" prices) always sort last.
        function sortTable(table, key, dir) {
          const tbody = table.querySelector('tbody');
          const rows = getDataRows(table);
          const noResultsRow = table.querySelector('.no-results-row');

          function getValue(row) {
            if (key === 'name') return row.getAttribute('data-name') || '';
            return parseNum(row.getAttribute('data-' + key));
          }

          rows.sort((a, b) => {
            const va = getValue(a);
            const vb = getValue(b);

            if (key === 'name') {
              return dir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
            }

            const aNull = va === null;
            const bNull = vb === null;
            if (aNull && bNull) return 0;
            if (aNull) return 1; // nulls/"—" always last, regardless of direction
            if (bNull) return -1;
            return dir === 'asc' ? va - vb : vb - va;
          });

          rows.forEach((row) => tbody.insertBefore(row, noResultsRow || null));
        }

        document.querySelectorAll('.ledger-table thead th[data-sort]').forEach((th) => {
          th.addEventListener('click', () => {
            const table = th.closest('table');
            const key = th.getAttribute('data-sort');
            const currentDir = th.getAttribute('data-dir') || '';
            const nextDir = currentDir === 'asc' ? 'desc' : 'asc';

            table.querySelectorAll('th[data-sort]').forEach((h) => {
              h.removeAttribute('data-dir');
              h.classList.remove('sorted-asc', 'sorted-desc');
            });
            th.setAttribute('data-dir', nextDir);
            th.classList.add(nextDir === 'asc' ? 'sorted-asc' : 'sorted-desc');

            sortTable(table, key, nextDir);
          });
        });

        applyFilters();
      })();
    </script>
  </body>
</html>
