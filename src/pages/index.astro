---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import priceDataRaw from '../data/price_history.json';
import { pdAttr } from '../lib/interestTaxonomy.mjs';
import {
	type PriceEntry,
	formatPrice,
	liveDropOf,
	pctOff,
	latestCheckedDate,
	formatCheckedDate,
	pbLink,
} from '../lib/priceUtils';

const priceData = priceDataRaw as { last_updated: string; bundles: Record<string, PriceEntry>; plugins?: Record<string, PriceEntry> };
const trackerEntries: Record<string, PriceEntry> = {
	...(priceData.bundles ?? {}),
	...(priceData.plugins ?? {}),
};
const trackedCount = Object.keys(trackerEntries).length;
const pricePointCount = Object.values(trackerEntries).reduce(
	(n, e) => n + (e.history?.length ?? 0),
	0,
);

const liveDrops = Object.entries(trackerEntries)
	.map(([name, entry]) => {
		const live = liveDropOf(entry);
		const checked = latestCheckedDate(entry);
		return {
			name,
			pbHref: pbLink(entry.pb_url),
			current: live?.current ?? null,
			regular: live?.regular ?? null,
			off: live ? pctOff(live.current, live.regular) : 0,
			checkedLabel: checked ? formatCheckedDate(checked) : null,
		};
	})
	.filter((d) => d.off > 0 && d.current !== null && d.regular !== null)
	.sort((a, b) => b.off - a.off)
	.slice(0, 4);

const allPosts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.filter((p) => p.data.pubDate.valueOf() <= Date.now())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function hasHeroImage(post: any): boolean {
	if (post.data.aiImage === true) return false;
	return (
		typeof post.data.heroImage === 'string' &&
		post.data.heroImage.startsWith('/images/') &&
		post.data.heroImage !== '/images/default-placeholder.jpg'
	);
}

function getStoreName(url: string | undefined): string {
	if (!url) return '';
	if (url.includes('pluginboutique.com')) return 'Plugin Boutique';
	if (url.includes('kvraudio.com')) return 'KVR Audio';
	if (url.includes('adsrsounds.com')) return 'ADSR Sounds';
	if (url.includes('loopmasters.com')) return 'Loopmasters';
	if (url.includes('splice.com')) return 'Splice';
	if (url.includes('sweetwater.com')) return 'Sweetwater';
	if (url.includes('thomann.de')) return 'Thomann';
	if (url.includes('waves.com')) return 'Waves';
	if (url.includes('native-instruments.com')) return 'Native Instruments';
	if (url.includes('arturia.com')) return 'Arturia';
	if (url.includes('izotope.com')) return 'iZotope';
	if (url.includes('plugin-alliance.com')) return 'Plugin Alliance';
	try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}

function isExpired(post: any): boolean {
	if (!post.data.saleExpiry) return false;
	return new Date(post.data.saleExpiry) < new Date();
}

function isFreePrice(price: string | undefined): boolean {
	if (!price) return false;
	const p = price.trim().toUpperCase().replace(/[$€£¥]/g, '');
	return p === 'FREE' || p === '0' || p === '0.00';
}

function isRealDeal(post: any): boolean {
	return !!(post.data.discount || (post.data.dealPrice && post.data.originalPrice) || isFreePrice(post.data.dealPrice));
}

function isSamplePackDeal(post: any): boolean {
	return post.data.tags?.includes('sample-pack-deal') ?? false;
}

const heroPosts = allPosts.filter(hasHeroImage);
const topDeals = heroPosts
	.filter(p => p.data.affiliate && !isExpired(p) && isRealDeal(p) && !isFreePrice(p.data.dealPrice) && !isSamplePackDeal(p))
	.sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0))
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "PluginDrop",
			"url": "https://plugindrop.net",
			"description": SITE_DESCRIPTION,
			"potentialAction": {
				"@type": "SearchAction",
				"target": { "@type": "EntryPoint", "urlTemplate": "https://plugindrop.net/posts/?q={search_term_string}" },
				"query-input": "required name=search_term_string",
			},
		})} />
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">
			<section class="hero-strip">
				<div class="hero-copy">
					<h1>Know what a plugin really costs.</h1>
					<p>Independent price tracking and honest deal curation for music producers.</p>
				</div>
				<form class="hero-search" action="/posts/" method="get" role="search">
					<input type="search" name="q" placeholder="Search plugins and deals&hellip;" aria-label="Search plugins and deals" />
					<button type="submit">Search</button>
				</form>
				<div class="hero-actions">
					<a class="primary-cta" href="/plugin-prices/">Open Price Tracker &rarr;</a>
					<a class="text-link" href="/posts">Browse today&apos;s deals &rarr;</a>
				</div>
				<p class="hero-trust">{trackedCount} plugins tracked &middot; updated daily &middot; no fake reviews</p>
			</section>

			<section class="task-gateways" aria-label="Explore PluginDrop">
				<a href="/posts"><strong>All Deals</strong><span>Every verified discount, updated daily</span></a>
				<a href="/plugin-prices/"><strong>Price Tracker</strong><span>Full price history for {trackedCount} plugins</span></a>
				<a href="/free/"><strong>Free Plugins</strong><span>Genuinely free, tested picks</span></a>
				<a href="/posts?filter=guide"><strong>Guides</strong><span>Buying advice without the hype</span></a>
			</section>

			{liveDrops.length > 0 && (
				<section class="section live-drops-section">
					<header class="section-hd">
						<div class="section-title"><h2>Live Drops</h2><span>Checked daily &middot; via Plugin Boutique</span></div>
						<a href="/plugin-prices/">See all live drops &rarr;</a>
					</header>
					<div class="live-drop-grid">
						{liveDrops.map((d) => {
							const entry = trackerEntries[d.name];
							const atAllTimeLow = entry.all_time_low != null && !(d.current > entry.all_time_low);
							return (
								<a class="live-drop-card" href={d.pbHref} target="_blank" rel="noopener sponsored">
									<strong class="drop-name">{d.name}</strong>
									<div class="drop-prices">
										<span class="drop-price-current">{formatPrice(d.current)}</span>
										<s class="drop-price-regular">{formatPrice(d.regular)}</s>
										<span class:list={['drop-off-chip', { 'is-low': atAllTimeLow }]}>&minus;{d.off}% OFF</span>
									</div>
									<span class="drop-checked-date">Checked {d.checkedLabel ?? '&mdash;'} &middot; PB</span>
								</a>
							);
						})}
					</div>
				</section>
			)}

			{topDeals.length > 0 && (
				<section class="section editors-picks">
					<header class="section-hd">
						<div class="section-title"><h2>Editor&apos;s picks</h2><span>From the blog</span></div>
						<a href="/posts/">All deals &rarr;</a>
					</header>
					<div class="deal-grid">
						{topDeals.map(post => (
							<a href={`/posts/${post.id}/`} class="deal-card" data-pd={pdAttr({ title: post.data.title, tags: post.data.tags ?? [] })}>
								<img src={post.data.heroImage} alt="" loading="lazy" />
								<div class="deal-copy">
									<h3>{post.data.title}</h3>
									{post.data.dealPrice && <strong>{post.data.dealPrice}</strong>}
									{post.data.affiliate && <span>{getStoreName(post.data.affiliate)}</span>}
								</div>
							</a>
						))}
					</div>
				</section>
			)}

			<section class="method-note">
				<p>Prices are checked by our own tracker, not copied from press releases. <a href="/how-we-track-prices/">How we track &rarr;</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero-strip { max-width: 780px; padding: 5rem 0 3.5rem; }
	.hero-copy { max-width: 760px; }
	.hero-copy h1, .section-hd h2 { font-family: var(--font-display); font-weight: 400; color: var(--text-primary); }
	.hero-copy h1 { margin: 0 0 1rem; font-size: clamp(2.75rem, 6vw, 4.5rem); line-height: 1.05; letter-spacing: -0.025em; }
	.hero-copy p { margin: 0; color: var(--text-secondary); font-size: 1.1rem; }
	.hero-search { display: flex; max-width: 620px; gap: 0.5rem; margin: 2rem 0 1rem; }
	.hero-search input { flex: 1; min-width: 0; padding: 0.85rem 1rem; color: var(--text-primary); background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); }
	.hero-search input:focus { outline: none; border-color: var(--accent); }
	.hero-search button { padding: 0.85rem 1.25rem; font-weight: 700; color: var(--bg-base); background: var(--accent); border: 0; border-radius: var(--radius); cursor: pointer; }
	.hero-search button:hover { background: var(--accent-light); }
	.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
	.primary-cta { padding: 0.75rem 1rem; font-weight: 700; color: var(--bg-base); background: var(--accent); border-radius: var(--radius); text-decoration: none; }
	.primary-cta:hover { background: var(--accent-light); }
	.text-link, .section-hd a, .method-note a { color: var(--accent); text-decoration: none; }
	.text-link:hover, .section-hd a:hover, .method-note a:hover { text-decoration: underline; }
	.hero-trust { margin: 1.25rem 0 0; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); }
	.task-gateways { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-bottom: 3.5rem; border: 1px solid var(--border); border-radius: var(--radius); }
	.task-gateways a { display: flex; min-width: 0; flex-direction: column; gap: 1.5rem; padding: 1.5rem; color: inherit; background: var(--bg-card); text-decoration: none; }
	.task-gateways a + a { border-left: 1px solid var(--border); }
	.task-gateways a:hover { background: var(--bg-card-hover); }
	.task-gateways strong { font-family: var(--font-display); font-size: 1.35rem; font-weight: 400; color: var(--text-primary); }
	.task-gateways a:hover strong { color: var(--accent); }
	.task-gateways span { color: var(--text-muted); font-size: 0.78rem; line-height: 1.4; }
	.section { margin-bottom: 3.5rem; }
	.section-hd { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.section-hd h2 { margin: 0; font-size: 1.35rem; }
	.section-title { display: flex; align-items: baseline; gap: 1rem; }
	.section-title span { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); }
	.section-hd a { font-size: 0.8rem; white-space: nowrap; }
	.live-drop-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--border); border-radius: var(--radius); }
	.live-drop-card { display: flex; min-width: 0; min-height: 145px; flex-direction: column; gap: 1rem; padding: 1.25rem; color: inherit; background: var(--bg-card); text-decoration: none; }
	.live-drop-card + .live-drop-card { border-left: 1px solid var(--border); }
	.live-drop-card:hover { background: var(--bg-card-hover); }
	.drop-name { color: var(--text-primary); font-size: 0.92rem; }
	.live-drop-card:hover .drop-name { color: var(--accent); }
	.drop-prices { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
	.drop-price-current, .drop-price-regular, .drop-checked-date, .drop-off-chip { font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
	.drop-price-current { font-size: 1.05rem; font-weight: 700; color: var(--text-primary); }
	.drop-price-regular { font-size: 0.78rem; color: var(--text-muted); }
	.drop-checked-date { margin-top: auto; font-size: 0.66rem; color: var(--text-muted); }
	.drop-off-chip { display: inline-block; padding: 0.2rem 0.45rem; border-radius: var(--radius-sm); background: var(--sale-bg); color: var(--sale-text); font-size: 0.7rem; font-weight: 700; }
	.drop-off-chip.is-low { background: var(--verdict-good); color: var(--bg-base); }
	.editors-picks { padding-top: 0.5rem; border-top: 1px solid var(--border); }
	.editors-picks .section-hd { padding-top: 1rem; }
	.deal-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; }
	.deal-card { display: flex; min-width: 0; height: 92px; overflow: hidden; color: inherit; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; }
	.deal-card:hover { border-color: var(--accent-border-hover); background: var(--bg-card-hover); }
	.deal-card > img { width: 92px; flex: 0 0 92px; object-fit: cover; }
	.deal-copy { display: flex; min-width: 0; flex-direction: column; padding: 0.65rem 0.7rem; }
	.deal-copy h3 { display: -webkit-box; overflow: hidden; margin: 0 0 auto; color: var(--text-primary); font-size: 0.78rem; line-height: 1.25; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.deal-copy strong { font-family: var(--font-mono); color: var(--text-primary); font-size: 0.78rem; }
	.deal-copy span { overflow: hidden; color: var(--text-muted); font-size: 0.65rem; text-overflow: ellipsis; white-space: nowrap; }
	.method-note { padding: 3rem 0; border-top: 1px solid var(--border); text-align: center; }
	.method-note p { margin: 0; font-family: var(--font-display); font-size: 1.05rem; font-style: italic; color: var(--text-muted); }
	@media (max-width: 900px) {
		.task-gateways, .live-drop-grid, .deal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.task-gateways a:nth-child(3), .live-drop-card:nth-child(3) { border-left: 0; border-top: 1px solid var(--border); }
		.task-gateways a:nth-child(4), .live-drop-card:nth-child(4) { border-top: 1px solid var(--border); }
	}
	@media (max-width: 680px) {
		.hero-strip { padding: 3.5rem 0 3rem; }
		.hero-search { align-items: stretch; flex-direction: column; }
		.section-hd { align-items: flex-start; flex-direction: column; gap: 0.35rem; }
		.section-title { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
		.task-gateways, .live-drop-grid, .deal-grid { grid-template-columns: 1fr; }
		.task-gateways a + a, .live-drop-card + .live-drop-card { border-top: 1px solid var(--border); border-left: 0; }
	}
</style>
