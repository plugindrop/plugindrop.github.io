---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function hasHeroImage(post: any): boolean {
	if (post.data.aiImage === true) return false;
	return (
		typeof post.data.heroImage === 'string' &&
		post.data.heroImage.startsWith('/images/') &&
		post.data.heroImage !== '/images/default-placeholder.jpg'
	);
}

function getStoreName(url: string | undefined): string {
	if (!url) return '';
	if (url.includes('pluginboutique.com')) return 'Plugin Boutique';
	if (url.includes('kvraudio.com')) return 'KVR Audio';
	if (url.includes('adsrsounds.com')) return 'ADSR Sounds';
	if (url.includes('loopmasters.com')) return 'Loopmasters';
	if (url.includes('splice.com')) return 'Splice';
	if (url.includes('sweetwater.com')) return 'Sweetwater';
	if (url.includes('thomann.de')) return 'Thomann';
	if (url.includes('waves.com')) return 'Waves';
	if (url.includes('native-instruments.com')) return 'Native Instruments';
	if (url.includes('arturia.com')) return 'Arturia';
	if (url.includes('izotope.com')) return 'iZotope';
	if (url.includes('plugin-alliance.com')) return 'Plugin Alliance';
	try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}

function isNew(date: Date): boolean {
	return (Date.now() - date.getTime()) < 4 * 24 * 60 * 60 * 1000;
}

function isExpired(post: any): boolean {
	if (!post.data.saleExpiry) return false;
	return new Date(post.data.saleExpiry) < new Date();
}

function daysLeft(post: any): number | null {
	if (!post.data.saleExpiry) return null;
	const diff = new Date(post.data.saleExpiry).getTime() - Date.now();
	const days = Math.ceil(diff / (1000 * 60 * 60 * 24));
	return days > 0 ? days : null;
}

function isFreePrice(price: string | undefined): boolean {
	return !!price && price.trim().toUpperCase() === 'FREE';
}

function isRealDeal(post: any): boolean {
	return !!(post.data.discount || (post.data.dealPrice && post.data.originalPrice) || isFreePrice(post.data.dealPrice));
}

const heroPosts = allPosts.filter(hasHeroImage);

// Editor's Picks: scored real deals, non-expired, with affiliate + hero image
const topDeals = heroPosts
	.filter(p => p.data.affiliate && !isExpired(p) && isRealDeal(p))
	.sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0))
	.slice(0, 4);

const topIds = new Set(topDeals.map(p => p.id));

// Recent Deals: non-expired, not in Editor's Picks
const recentDeals = heroPosts
	.filter(p => !topIds.has(p.id) && !isExpired(p))
	.slice(0, 6);

// Free Deals: confirmed free, non-expired, not shown above (recentDeals excluded too)
const recentIds = new Set(recentDeals.map(p => p.id));
const freeDeals = allPosts
	.filter(p => hasHeroImage(p) && !topIds.has(p.id) && !recentIds.has(p.id) && !isExpired(p) && (
		isFreePrice(p.data.dealPrice) ||
		(p.data.tags?.includes('free') && p.data.affiliate)
	))
	.slice(0, 3);

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "PluginDrop",
			"url": "https://plugindrop.net",
			"description": SITE_DESCRIPTION,
			"potentialAction": {
				"@type": "SearchAction",
				"target": { "@type": "EntryPoint", "urlTemplate": "https://plugindrop.net/posts/?q={search_term_string}" },
				"query-input": "required name=search_term_string",
			},
		})} />
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">

			<!-- ── Hero Strip ─────────────────────────── -->
			<section class="hero-strip">
				<div class="hero-headline-wrap">
					<h1 class="hero-headline">Plugin deals, verified daily.</h1>
					<p class="hero-sub">
						Prices, specs &amp; community takes &mdash; no hype, no fake reviews.
					</p>
				</div>
			</section>

			<!-- ── Editor's Picks ─────────────────────── -->
			{topDeals.length > 0 && (
				<section class="section">
					<header class="section-hd">
						<span class="section-label">Editor&apos;s Picks</span>
						<a href="/posts" class="section-more">See all deals &rarr;</a>
					</header>
					<div class="deal-grid deal-grid--4">
						{topDeals.map(post => {
							const days = daysLeft(post);
							return (
								<a href={`/posts/${post.id}/`} class="deal-card">
									<div class="card-img-wrap">
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
										{post.data.discount && <span class="bdg-discount">{post.data.discount}</span>}
										{isNew(post.data.pubDate) && <span class="bdg-new">NEW</span>}
									</div>
									<div class="card-body">
										<h4 class="card-title">{post.data.title}</h4>
										{(post.data.dealPrice || post.data.originalPrice) && (
											<div class="price-cluster">
												{post.data.originalPrice && <s class="price-was">{post.data.originalPrice}</s>}
												{post.data.dealPrice && (
													<strong class={`price-now ${isFreePrice(post.data.dealPrice) ? 'is-free' : ''}`}>
														{post.data.dealPrice}
													</strong>
												)}
											</div>
										)}
										{days !== null && days <= 3 && (
											<span class="urgency-badge">⏰ {days === 1 ? 'Last day!' : `${days} days left`}</span>
										)}
										<div class="card-foot">
											{post.data.affiliate && <span class="via-store">{getStoreName(post.data.affiliate)}</span>}
											<span class="card-cta">Get deal &rarr;</span>
										</div>
									</div>
								</a>
							);
						})}
					</div>
				</section>
			)}

			<!-- ── Recent Deals ───────────────────────── -->
			{recentDeals.length > 0 && (
				<section class="section">
					<header class="section-hd">
						<span class="section-label">Recent Deals</span>
						<a href="/posts" class="section-more">See all &rarr;</a>
					</header>
					<div class="deal-grid deal-grid--3">
						{recentDeals.map(post => {
							const days = daysLeft(post);
							return (
								<a href={`/posts/${post.id}/`} class="deal-card">
									{post.data.heroImage && (
										<div class="card-img-wrap">
											<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
											{post.data.discount && <span class="bdg-discount">{post.data.discount}</span>}
											{isNew(post.data.pubDate) && <span class="bdg-new">NEW</span>}
										</div>
									)}
									<div class="card-body">
										<h4 class="card-title">{post.data.title}</h4>
										{(post.data.dealPrice || post.data.originalPrice) && (
											<div class="price-cluster">
												{post.data.originalPrice && <s class="price-was">{post.data.originalPrice}</s>}
												{post.data.dealPrice && (
													<strong class={`price-now ${isFreePrice(post.data.dealPrice) ? 'is-free' : ''}`}>
														{post.data.dealPrice}
													</strong>
												)}
											</div>
										)}
										{days !== null && days <= 3 && (
											<span class="urgency-badge">⏰ {days === 1 ? 'Last day!' : `${days} days left`}</span>
										)}
										<div class="card-foot">
											{post.data.affiliate && <span class="via-store">{getStoreName(post.data.affiliate)}</span>}
											<span class="card-cta">Read more &rarr;</span>
										</div>
									</div>
								</a>
							);
						})}
					</div>
					<div class="see-all">
						<a href="/posts">View all {allPosts.length} deals &rarr;</a>
					</div>
				</section>
			)}

			<!-- ── Free Deals ─────────────────────────── -->
			{freeDeals.length > 0 && (
				<section class="section section--free">
					<header class="section-hd">
						<span class="section-label section-label--free">Free Downloads</span>
					</header>
					<div class="deal-grid deal-grid--3">
						{freeDeals.map(post => (
							<a href={`/posts/${post.id}/`} class="deal-card deal-card--free">
								{post.data.heroImage && (
									<div class="card-img-wrap">
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
										<span class="bdg-free">FREE</span>
									</div>
								)}
								<div class="card-body">
									<h4 class="card-title">{post.data.title}</h4>
									<div class="price-cluster">
										<strong class="price-now is-free">FREE</strong>
									</div>
									<div class="card-foot">
										{post.data.affiliate && <span class="via-store">{getStoreName(post.data.affiliate)}</span>}
										<span class="card-cta">Get free &rarr;</span>
									</div>
								</div>
							</a>
						))}
					</div>
				</section>
			)}

		</main>

		<div class="disclosure">
			<div class="disclosure-inner">
				PluginDrop uses affiliate links. We may earn a small commission &mdash; at no extra cost to you.
				<a href="/about#affiliate">Learn more</a>
			</div>
		</div>

		<Footer />
	</body>
</html>

<style>
	/* ── Hero Strip ───────────────────────────────────────── */
	.hero-strip {
		padding: 2.25rem 0 1.75rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}
	.hero-headline-wrap { margin-bottom: 0.75rem; }
	.hero-headline {
		font-family: var(--font-display);
		font-size: 2.75rem;
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.1;
		color: var(--text-primary);
		margin: 0 0 0.5rem;
	}
	.hero-sub {
		color: var(--text-secondary);
		font-size: 0.95rem;
		margin: 0;
		line-height: 1.5;
	}

	/* ── Sections ─────────────────────────────────────────── */
	.section { margin-bottom: 3rem; }
	.section--free {
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
	.section-hd {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1rem;
		gap: 1rem;
	}
	.section-label {
		font-size: 0.68rem;
		font-weight: 800;
		color: var(--text-muted);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.section-label--free { color: var(--free-text, #4caf50); }
	.section-more {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.15s;
	}
	.section-more:hover { color: var(--accent-dark); }

	/* ── Price atoms ──────────────────────────────────────── */
	.price-cluster {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		flex-wrap: wrap;
	}
	.price-was {
		font-size: 0.8rem;
		color: var(--text-muted);
		text-decoration: line-through;
		font-weight: 400;
	}
	.price-now {
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--text-primary);
		letter-spacing: -0.02em;
	}
	.price-now.is-free { color: var(--free-text); font-family: var(--font-body); letter-spacing: 0; }
	.via-store {
		font-size: 0.72rem;
		color: var(--text-muted);
		font-weight: 500;
	}

	/* ── Urgency badge ────────────────────────────────────── */
	.urgency-badge {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 700;
		color: #c0392b;
		background: rgba(192, 57, 43, 0.08);
		border: 1px solid rgba(192, 57, 43, 0.2);
		padding: 0.18em 0.5em;
		border-radius: 3px;
		letter-spacing: 0.02em;
	}

	/* ── Badges ───────────────────────────────────────────── */
	.bdg-discount {
		position: absolute;
		top: 0.5rem; right: 0.5rem;
		background: var(--sale-bg);
		color: var(--sale-text);
		font-size: 0.62rem; font-weight: 800;
		padding: 0.22em 0.5em;
		border-radius: 2px;
		letter-spacing: 0.04em;
	}
	.bdg-new {
		position: absolute;
		top: 0.5rem; left: 0.5rem;
		background: rgba(148, 211, 196, 0.12);
		color: var(--accent);
		font-size: 0.58rem; font-weight: 700;
		padding: 0.2em 0.5em;
		border-radius: 2px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		font-family: var(--font-body);
	}
	.bdg-free {
		position: absolute;
		top: 0.5rem; right: 0.5rem;
		background: rgba(76, 175, 80, 0.15);
		color: #2e7d32;
		font-size: 0.62rem; font-weight: 800;
		padding: 0.22em 0.5em;
		border-radius: 2px;
		letter-spacing: 0.04em;
	}

	/* ── Deal Cards ───────────────────────────────────────── */
	.deal-grid { display: grid; gap: 1rem; }
	.deal-grid--4 { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
	.deal-grid--3 { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }

	.deal-card {
		display: flex; flex-direction: column;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		text-decoration: none;
		box-shadow: var(--box-shadow);
		transition: border-color 0.15s, background 0.2s;
	}
	.deal-card:hover {
		border-color: var(--accent-border-hover);
		background: var(--bg-card-hover);
	}
	.deal-card--free { border-color: rgba(76, 175, 80, 0.2); }
	.deal-card--free:hover { border-color: rgba(76, 175, 80, 0.5); }

	.card-img-wrap { position: relative; overflow: hidden; }
	.card-img-wrap img {
		width: 100%; height: 160px;
		object-fit: cover; display: block;
		transition: transform 0.3s ease;
	}
	.deal-card:hover .card-img-wrap img { transform: scale(1.04); }

	.card-body {
		padding: 0.875rem 1rem 1rem;
		flex: 1;
		display: flex; flex-direction: column; gap: 0.4rem;
	}
	.card-title {
		color: var(--text-primary);
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.4;
		margin: 0;
	}
	.card-foot {
		display: flex; align-items: center;
		justify-content: space-between;
		margin-top: auto; padding-top: 0.5rem;
	}
	.card-cta {
		font-size: 0.72rem; font-weight: 600;
		color: var(--accent);
		transition: color 0.15s;
		white-space: nowrap;
	}
	.deal-card:hover .card-cta { color: var(--accent-light); }

	/* ── See All ──────────────────────────────────────────── */
	.see-all { text-align: center; margin-top: 1.75rem; }
	.see-all a {
		display: inline-block;
		padding: 0.65rem 1.75rem;
		border: 1.5px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--text-secondary); font-weight: 600; font-size: 0.875rem;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}
	.see-all a:hover {
		border-color: var(--accent);
		color: var(--accent-dark);
		background: var(--tag-bg);
	}

	/* ── Disclosure ───────────────────────────────────────── */
	.disclosure {
		border-top: 1px solid var(--border);
		background: var(--bg-low);
		padding: 0.65rem 1.5rem;
	}
	.disclosure-inner {
		max-width: 960px;
		margin: 0 auto;
		font-size: 0.72rem;
		color: var(--text-muted);
		text-align: center;
	}
	.disclosure-inner a { color: var(--text-muted); text-decoration: underline; }

	/* ── Responsive ───────────────────────────────────────── */
	@media (max-width: 720px) {
		.hero-headline { font-size: 2rem; }
		.deal-grid--4 { grid-template-columns: repeat(2, 1fr); }
		.deal-grid--3 { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 480px) {
		.hero-headline { font-size: 1.75rem; }
		.deal-grid--4 { grid-template-columns: 1fr; }
		.deal-grid--3 { grid-template-columns: 1fr; }
	}
</style>
