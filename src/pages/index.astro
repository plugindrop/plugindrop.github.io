    .section-heading{padding-bottom:.65rem;margin-bottom:1rem;align-items:end}
    .section-heading .eyebrow{font-size:.72rem}
    .section-heading h2{font:600 1.8rem/1.1 var(--font-display)}
    .desktop-all-title{display:inline;font:inherit!important;color:inherit!important}
    .mobile-all-title{display:none}
    .section-heading>a{font:.8rem var(--font-mono);color:var(--accent);text-decoration:none}
    .section-heading>a:hover{text-decoration:underline}
    .brand-cluster .brand-meta{font-size:.8rem}
    .desktop-sale-max{display:inline}
    .category-tiles--chips{display:flex;flex-wrap:nowrap;overflow-x:auto;gap:.5rem;padding-bottom:.2rem}
    .category-tiles--chips .category-tile{flex:none;border:1px solid var(--border);background:transparent;padding:.55rem .8rem}
    .category-tiles--chips .category-tile strong{font:600 .8rem var(--font-mono)}
    .category-tiles--chips .category-tile:hover{border-color:var(--accent);color:var(--accent)}
    .home-deal-rail:not(.brand-cluster){border:1px solid var(--border);border-left:3px solid #a45251;padding:1rem;background:linear-gradient(90deg,rgba(164,82,81,.07),transparent 30%)}
