    .feature-section{grid-template-columns:minmax(0,1.5fr) minmax(310px,1fr);gap:1rem}
    .hot-block{min-height:0}
    .hot-block h2{font:600 1.35rem var(--font-display);padding:0 0 .4rem;border-bottom:1px solid var(--border)}
    .hot-grid{grid-template-rows:repeat(4,minmax(0,1fr));gap:.45rem}
