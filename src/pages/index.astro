---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import priceDataRaw from '../data/price_history.json';
import { pdAttr } from '../lib/interestTaxonomy.mjs';
import {
	type PriceEntry,
	currentPriceOf,
	dealScoreNumeric,
	formatPrice,
	pctOff,
	pbLink,
	regularPriceOf,
	slugify,
} from '../lib/priceUtils';

const priceData = priceDataRaw as { last_updated: string; bundles: Record<string, PriceEntry>; plugins?: Record<string, PriceEntry> };
const trackerEntries: Record<string, PriceEntry> = {
	...(priceData.bundles ?? {}),
	...(priceData.plugins ?? {}),
};
const trackedCount = Object.keys(trackerEntries).length;

const trackerRows = Object.entries(trackerEntries)
	.map(([name, entry]) => {
		const current = currentPriceOf(entry);
		const regular = regularPriceOf(entry);
		return {
			name,
			entry,
			current,
			regular,
			off: pctOff(current, regular),
			dealScore: dealScoreNumeric(entry),
		};
	})
	.sort((a, b) => {
		const aHasScore = a.dealScore.verdict !== 'none';
		const bHasScore = b.dealScore.verdict !== 'none';
		if (aHasScore !== bHasScore) return aHasScore ? -1 : 1;
		return aHasScore
			? b.dealScore.score - a.dealScore.score || a.name.localeCompare(b.name)
			: a.name.localeCompare(b.name);
	});

const allPosts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.filter((p) => p.data.pubDate.valueOf() <= Date.now())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function hasHeroImage(post: any): boolean {
	if (post.data.aiImage === true) return false;
	return (
		typeof post.data.heroImage === 'string' &&
		post.data.heroImage.startsWith('/images/') &&
		post.data.heroImage !== '/images/default-placeholder.jpg'
	);
}

function getStoreName(url: string | undefined): string {
	if (!url) return '';
	if (url.includes('pluginboutique.com')) return 'Plugin Boutique';
	if (url.includes('kvraudio.com')) return 'KVR Audio';
	if (url.includes('adsrsounds.com')) return 'ADSR Sounds';
	if (url.includes('loopmasters.com')) return 'Loopmasters';
	if (url.includes('splice.com')) return 'Splice';
	if (url.includes('sweetwater.com')) return 'Sweetwater';
	if (url.includes('thomann.de')) return 'Thomann';
	if (url.includes('waves.com')) return 'Waves';
	if (url.includes('native-instruments.com')) return 'Native Instruments';
	if (url.includes('arturia.com')) return 'Arturia';
	if (url.includes('izotope.com')) return 'iZotope';
	if (url.includes('plugin-alliance.com')) return 'Plugin Alliance';
	try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}

function isExpired(post: any): boolean {
	if (!post.data.saleExpiry) return false;
	return new Date(post.data.saleExpiry) < new Date();
}

function isFreePrice(price: string | undefined): boolean {
	if (!price) return false;
	const p = price.trim().toUpperCase().replace(/[$€£¥]/g, '');
	return p === 'FREE' || p === '0' || p === '0.00';
}

function isRealDeal(post: any): boolean {
	return !!(post.data.discount || (post.data.dealPrice && post.data.originalPrice) || isFreePrice(post.data.dealPrice));
}

function isSamplePackDeal(post: any): boolean {
	return post.data.tags?.includes('sample-pack-deal') ?? false;
}

const heroPosts = allPosts.filter(hasHeroImage);
const topDeals = heroPosts
	.filter(p => p.data.affiliate && !isExpired(p) && isRealDeal(p) && !isFreePrice(p.data.dealPrice) && !isSamplePackDeal(p))
	.sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0))
	.slice(0, 9);
const topDealIds = new Set(topDeals.map(post => post.id));
const moreFreshDeals = allPosts
	.filter(p => !topDealIds.has(p.id) && p.data.affiliate && !isExpired(p) && isRealDeal(p))
	.slice(0, 10);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "PluginDrop",
			"url": "https://plugindrop.net",
			"description": SITE_DESCRIPTION,
			"potentialAction": {
				"@type": "SearchAction",
				"target": { "@type": "EntryPoint", "urlTemplate": "https://plugindrop.net/posts/?q={search_term_string}" },
				"query-input": "required name=search_term_string",
			},
		})} />
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">
			<section class="hero-strip">
				<div class="hero-copy">
					<h1>Today&apos;s plugin deals, verified.</h1>
					<p>Every discount checked against real price history &mdash; we don&apos;t list fake sales.</p>
				</div>
				<form class="hero-search" action="/posts/" method="get" role="search">
					<input type="search" name="q" placeholder="Search plugins and deals&hellip;" aria-label="Search plugins and deals" />
					<button type="submit">Search</button>
				</form>
				<p class="hero-trust">{trackedCount} plugins tracked daily &middot; no fake reviews</p>
			</section>

			{topDeals.length > 0 && (
				<section class="section top-deals">
					<header class="section-hd">
						<h2>Today&apos;s top deals</h2>
						<a href="/posts/">All deals &rarr;</a>
					</header>
					<div class="deal-grid">
						{topDeals.map(post => {
							const trackedName = post.data.priceTrack?.[0];
							const trackedEntry = trackedName ? trackerEntries[trackedName] : undefined;
							const score = trackedEntry ? dealScoreNumeric(trackedEntry) : null;
							return (
								<a href={`/posts/${post.id}/`} class="deal-card" data-pd={pdAttr({ title: post.data.title, tags: post.data.tags ?? [] })}>
									<div class="deal-image">
										<img src={post.data.heroImage} alt="" loading="lazy" />
										{score && <span class={`score-badge is-${score.verdict}`}>{score.score}</span>}
									</div>
									<div class="deal-copy">
										<h3>{post.data.title}</h3>
										<div class="deal-prices">
											{post.data.dealPrice && <strong>{post.data.dealPrice}</strong>}
											{post.data.originalPrice && <s>{post.data.originalPrice}</s>}
											{post.data.discount && <span class="discount-chip">{post.data.discount}</span>}
										</div>
										{post.data.affiliate && <span class="deal-store">{getStoreName(post.data.affiliate)}</span>}
									</div>
								</a>
							);
						})}
					</div>
					{moreFreshDeals.length > 0 && (
						<div class="more-deals">
							<header class="more-deals-hd">
								<h3>More fresh deals</h3>
								<a href="/posts/">All deals &rarr;</a>
							</header>
							<div class="more-deals-list">
								{moreFreshDeals.map(post => (
									<div class="more-deal-row" data-more-deal>
										<a href={`/posts/${post.id}/`}>{post.data.title}</a>
										{post.data.dealPrice && <strong>{post.data.dealPrice}</strong>}
										{post.data.discount && <span class="discount-chip">{post.data.discount}</span>}
									</div>
								))}
							</div>
						</div>
					)}
				</section>
			)}

			<section class="section tracker-panel" aria-labelledby="quick-price-check">
				<header class="section-hd">
					<div class="section-title">
						<h2 id="quick-price-check">Quick price check</h2>
						<span>our tracker &middot; {trackedCount} plugins</span>
					</div>
					<a href="/plugin-prices/">Open full tracker &rarr;</a>
				</header>
				<label class="sr-only" for="tracker-filter">Filter tracked plugins</label>
				<input id="tracker-filter" class="tracker-filter" type="search" placeholder={`Filter ${trackedCount} plugins…`} />
				<div class="tracker-table-wrap">
					<table class="tracker-table">
						<thead><tr><th>Plugin</th><th>Current</th><th>Regular</th><th>Off</th><th>Score</th><th><span class="sr-only">Store</span></th></tr></thead>
						<tbody>
							{trackerRows.map(row => (
								<tr data-name={row.name.toLowerCase()}>
									<td><a href={`/plugin-prices/${slugify(row.name)}/`}>{row.name}</a></td>
									<td class="price-current">{formatPrice(row.current)}</td>
									<td><s class="price-regular">{formatPrice(row.regular)}</s></td>
									<td>{row.off > 0 ? <span class="discount-chip">&minus;{row.off}%</span> : <span class="muted">&mdash;</span>}</td>
									<td>{row.dealScore.verdict === 'none' ? <span class="muted" title="No discount history — price is stable">&mdash;</span> : <span class={`score-badge is-${row.dealScore.verdict}`}>{row.dealScore.score}</span>}</td>
									<td><a class="pb-link" href={pbLink(row.entry.pb_url)} target="_blank" rel="noopener sponsored">PB &rarr;</a></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			<section class="method-note">
				<p>Prices are checked by our own tracker, not copied from press releases. <a href="/how-we-track-prices/">How we track &rarr;</a></p>
			</section>
		</main>
		<Footer />
		<script>
			const filter = document.querySelector<HTMLInputElement>('#tracker-filter');
			const rows = document.querySelectorAll<HTMLTableRowElement>('.tracker-table tbody tr');
			filter?.addEventListener('input', () => {
				const query = filter.value.trim().toLowerCase();
				rows.forEach((row) => { row.hidden = !row.dataset.name?.includes(query); });
			});
		</script>
	</body>
</html>

<style>
	.hero-strip { max-width: 780px; padding: 5rem 0 3.5rem; }
	.hero-copy { max-width: 760px; }
	.hero-copy h1, .section-hd h2 { font-family: var(--font-display); font-weight: 400; color: var(--text-primary); }
	.hero-copy h1 { margin: 0 0 1rem; font-size: clamp(2.75rem, 6vw, 4.5rem); line-height: 1.05; letter-spacing: -0.025em; }
	.hero-copy p { margin: 0; color: var(--text-secondary); font-size: 1.1rem; }
	.hero-search { display: flex; max-width: 620px; gap: 0.5rem; margin: 2rem 0 1rem; }
	.hero-search input { flex: 1; min-width: 0; padding: 0.85rem 1rem; color: var(--text-primary); background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); }
	.hero-search input:focus { outline: none; border-color: var(--accent); }
	.hero-search button { padding: 0.85rem 1.25rem; font-weight: 700; color: var(--bg-base); background: var(--accent); border: 0; border-radius: var(--radius); cursor: pointer; }
	.hero-search button:hover { background: var(--accent-light); }
	.section-hd a, .method-note a { color: var(--accent); text-decoration: none; }
	.section-hd a:hover, .method-note a:hover { text-decoration: underline; }
	.hero-trust { margin: 1.25rem 0 0; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); }
	.section { margin-bottom: 3.5rem; }
	.section-hd { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.section-hd h2 { margin: 0; font-size: 1.35rem; }
	.section-title { display: flex; align-items: baseline; gap: 1rem; }
	.section-title span { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); }
	.section-hd a { font-size: 0.8rem; white-space: nowrap; }
	.deal-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.deal-card { display: flex; min-width: 0; overflow: hidden; flex-direction: column; color: inherit; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; }
	.deal-card:hover { border-color: var(--accent-border-hover); background: var(--bg-card-hover); }
	.deal-image { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-low); }
	.deal-image img { width: 100%; height: 100%; border-radius: 0; object-fit: cover; }
	.deal-image .score-badge { position: absolute; top: 0.65rem; right: 0.65rem; }
	.deal-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; padding: 1rem; }
	.deal-copy h3 { display: -webkit-box; overflow: hidden; min-height: 2.5em; margin: 0 0 0.85rem; color: var(--text-primary); font-size: 1rem; line-height: 1.25; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.deal-prices { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }
	.deal-prices strong, .deal-prices s { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
	.deal-prices strong { color: var(--text-primary); font-size: 1rem; }
	.deal-prices s { color: var(--text-muted); font-size: 0.75rem; }
	.discount-chip { display: inline-block; padding: 0.15rem 0.4rem; border-radius: var(--radius-sm); background: var(--sale-bg); color: var(--sale-text); font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; white-space: nowrap; }
	.deal-store { overflow: hidden; margin-top: 0.65rem; color: var(--text-muted); font-size: 0.72rem; text-overflow: ellipsis; white-space: nowrap; }
	.more-deals { margin-top: 2rem; }
	.more-deals-hd { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.6rem; }
	.more-deals-hd h3 { margin: 0; color: var(--text-primary); font-family: var(--font-display); font-size: 1rem; font-weight: 400; }
	.more-deals-hd a { color: var(--accent); font-size: 0.8rem; text-decoration: none; white-space: nowrap; }
	.more-deals-hd a:hover { text-decoration: underline; }
	.more-deals-list { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); }
	.more-deal-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 0.65rem; padding: 0.65rem 0.8rem; background: var(--bg-card); }
	.more-deal-row + .more-deal-row { border-top: 1px solid var(--border); }
	.more-deal-row:hover { background: var(--bg-card-hover); }
	.more-deal-row > a { overflow: hidden; color: var(--text-primary); font-size: 0.82rem; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
	.more-deal-row > a:hover { color: var(--accent); }
	.more-deal-row > strong { color: var(--text-primary); font-family: var(--font-mono); font-size: 0.78rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
	.score-badge { display: inline-flex; min-width: 2rem; align-items: center; justify-content: center; padding: 0.18rem 0.4rem; border-radius: var(--radius-sm); color: var(--bg-base); background: var(--text-muted); font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; }
	.score-badge.is-good { background: var(--verdict-good); }
	.score-badge.is-ok { background: var(--verdict-ok); }
	.score-badge.is-bad { background: var(--verdict-bad); }
	.score-badge.is-none { color: var(--text-primary); background: var(--bg-highest); }
	.tracker-panel { padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); }
	.tracker-filter { width: 100%; margin-bottom: 0.75rem; padding: 0.65rem 0.8rem; color: var(--text-primary); background: var(--bg-low); border: 1px solid var(--border); border-radius: var(--radius); font-family: var(--font-mono); font-size: 0.75rem; }
	.tracker-filter:focus { outline: none; border-color: var(--accent); }
	.tracker-table-wrap { max-height: 360px; overflow: auto; border: 1px solid var(--border); }
	.tracker-table { min-width: 680px; margin: 0; font-size: 0.76rem; }
	.tracker-table th { position: sticky; top: 0; z-index: 1; padding: 0.55rem 0.7rem; background: var(--bg-highest); font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.04em; }
	.tracker-table td { padding: 0.5rem 0.7rem; }
	.tracker-table td:first-child { width: 100%; font-family: var(--font-body); }
	.tracker-table td:not(:first-child) { white-space: nowrap; }
	.price-current { color: var(--text-primary); font-weight: 700; }
	.price-regular, .muted { color: var(--text-muted); }
	.pb-link { font-size: 0.68rem; white-space: nowrap; }
	.method-note { padding: 3rem 0; border-top: 1px solid var(--border); text-align: center; }
	.method-note p { margin: 0; font-family: var(--font-display); font-size: 1.05rem; font-style: italic; color: var(--text-muted); }
	@media (max-width: 900px) {
		.deal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 680px) {
		.hero-strip { padding: 3.5rem 0 3rem; }
		.hero-search { align-items: stretch; flex-direction: column; }
		.section-hd { align-items: flex-start; flex-direction: column; gap: 0.35rem; }
		.section-title { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
		.deal-grid { grid-template-columns: 1fr; }
		.tracker-panel { padding: 0.75rem; }
	}
</style>
