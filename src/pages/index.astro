---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import priceData from '../data/price_history.json';
// Self-hosted v2 fonts (no third-party request → no external-latency CLS).
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/jetbrains-mono';

/* ────────────────────────────────────────────────────────────
   Design v2 — "Editorial Data Terminal" (Home = dual-split, C)
   Data-desk driven by REAL price_history.json (236 plugins /
   18 bundles). Sparklines, all-time-low, checked date, source
   and Deal Score are all computed from tracked data — no fabricated
   numbers. Editorial funnel (→ /posts/) is preserved in the left
   rail; the live table adds direct Plugin Boutique affiliate links
   (revenue exposure ≥ current). Scoped to this page only so the
   staged rollout doesn't change other templates.
   ──────────────────────────────────────────────────────────── */

const AFF = 'a_aid=69cb95abe1763';
const pbLink = (path: string) => `https://www.pluginboutique.com${path}?${AFF}`;

interface HistoryEntry { date: string; regular: number | null; sale: number | null; source: string; }
interface TrackedItem {
	pb_url: string;
	typical_regular: number | null;
	typical_sale: number | null;
	all_time_low: number | null;
	notes?: string;
	category?: string;
	history: HistoryEntry[];
}
interface PriceData {
	last_updated: string;
	bundles: Record<string, TrackedItem>;
	plugins?: Record<string, TrackedItem>;
}

const data = priceData as PriceData;
const lastUpdated = data.last_updated;

type Row = {
	name: string;
	category: string;
	href: string;
	current: number | null;
	regular: number | null;
	atl: number | null;
	offPct: number;
	score: number;
	verdict: 'good' | 'ok' | 'bad' | 'none';
	spark: string | null;
	checked: string;
	prevChangePct: number; // positive = price dropped since previous point
};

function currentOf(e: HistoryEntry | undefined): number | null {
	if (!e) return null;
	return e.sale ?? e.regular ?? null;
}

// Deal Score 0–100 from real data: position of current price between
// all-time-low (=100) and the typical "normal" regular price (=0).
// A big sticker OFF% whose price only reaches the normal band scores low
// (the "fake sale"); a genuine near-all-time-low scores high.
function dealScore(item: TrackedItem): { score: number; verdict: Row['verdict'] } {
	const latest = item.history.at(-1);
	const cur = currentOf(latest);
	const reg = latest?.regular ?? item.typical_regular;
	const atl = item.all_time_low;
	const hi = item.typical_regular ?? reg;
	if (cur === null || hi === null || atl === null) return { score: 0, verdict: 'none' };
	let position: number;
	if (hi <= atl) position = cur <= atl ? 1 : 0;
	else position = Math.min(1, Math.max(0, (hi - cur) / (hi - atl)));
	const score = Math.round(position * 100);
	const verdict: Row['verdict'] = score >= 70 ? 'good' : score >= 40 ? 'ok' : 'bad';
	return { score, verdict };
}

function offPercent(latest: HistoryEntry | undefined): number {
	if (!latest || latest.sale === null || latest.regular === null || latest.regular <= 0) return 0;
	const pct = Math.round((1 - latest.sale / latest.regular) * 100);
	return pct > 0 ? pct : 0;
}

// Tiny inline sparkline from actual tracked history points (min 2).
function sparkPoints(history: HistoryEntry[], w = 66, h = 18): string | null {
	const pts = history.map(currentOf).filter((v): v is number => v !== null);
	if (pts.length < 2) return null;
	const min = Math.min(...pts);
	const max = Math.max(...pts);
	const range = max - min || 1;
	const step = w / (pts.length - 1);
	return pts
		.map((v, i) => `${(i * step).toFixed(1)},${(h - ((v - min) / range) * h).toFixed(1)}`)
		.join(' ');
}

function buildRow(name: string, item: TrackedItem): Row {
	const latest = item.history.at(-1);
	const prev = item.history.length >= 2 ? item.history.at(-2) : undefined;
	const current = currentOf(latest);
	const prevPrice = currentOf(prev);
	const { score, verdict } = dealScore(item);
	const prevChangePct =
		prevPrice && current && prevPrice > 0 ? Math.round((1 - current / prevPrice) * 100) : 0;
	return {
		name,
		category: item.category ?? '—',
		href: pbLink(item.pb_url),
		current,
		regular: latest?.regular ?? item.typical_regular,
		atl: item.all_time_low,
		offPct: offPercent(latest),
		score,
		verdict,
		spark: sparkPoints(item.history),
		checked: latest?.date ?? lastUpdated,
		prevChangePct,
	};
}

const allTracked: Row[] = [
	...Object.entries(data.plugins ?? {}),
	...Object.entries(data.bundles),
].map(([name, item]) => buildRow(name, item));

// Main live-drops table: items on sale now, biggest advertised discount first.
// Sorting by sticker OFF% (not by score) deliberately surfaces the contrast the
// brief asks for — a big % with a low/red Deal Score (a "sale" that only reaches
// the normal price band) sits next to a genuine near-all-time-low green.
const onSaleRows = allTracked.filter((r) => r.offPct > 0 && r.current !== null && r.verdict !== 'none');
const liveDrops = [...onSaleRows].sort((a, b) => b.offPct - a.offPct || b.score - a.score).slice(0, 12);
if (liveDrops.length < 12) {
	const fill = allTracked
		.filter((r) => r.verdict !== 'none' && r.current !== null && !onSaleRows.includes(r))
		.sort((a, b) => b.score - a.score)
		.slice(0, 12 - liveDrops.length);
	liveDrops.push(...fill);
}

// Left rail — biggest real price drop between the two most recent tracked points.
// History is sparse (not daily), so this is labelled "recent", not "today".
const topMovers = allTracked
	.filter((r) => r.prevChangePct > 0 && r.current !== null)
	.sort((a, b) => b.prevChangePct - a.prevChangePct)
	.slice(0, 5);

function fmt(v: number | null): string {
	return v === null ? '—' : `$${v}`;
}

/* ── Editorial funnel (preserved): Editor's Picks from blog → /posts/ ── */
const allPosts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.filter((p) => p.data.pubDate.valueOf() <= Date.now())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function isFreePrice(price: string | undefined): boolean {
	if (!price) return false;
	const p = price.trim().toUpperCase().replace(/[$€£¥]/g, '');
	return p === 'FREE' || p === '0' || p === '0.00';
}
function isExpired(post: any): boolean {
	if (!post.data.saleExpiry) return false;
	return new Date(post.data.saleExpiry) < new Date();
}
function isRealDeal(post: any): boolean {
	return !!(post.data.discount || (post.data.dealPrice && post.data.originalPrice) || isFreePrice(post.data.dealPrice));
}
function getStoreName(url: string | undefined): string {
	if (!url) return '';
	if (url.includes('pluginboutique.com')) return 'Plugin Boutique';
	if (url.includes('splice.com')) return 'Splice';
	if (url.includes('adsrsounds.com')) return 'ADSR Sounds';
	if (url.includes('loopmasters.com')) return 'Loopmasters';
	if (url.includes('sweetwater.com')) return 'Sweetwater';
	if (url.includes('native-instruments.com')) return 'Native Instruments';
	if (url.includes('arturia.com')) return 'Arturia';
	if (url.includes('izotope.com')) return 'iZotope';
	try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}

const editorsPicks = allPosts
	.filter((p) => p.data.affiliate && !isExpired(p) && isRealDeal(p) && !isFreePrice(p.data.dealPrice))
	.sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0))
	.slice(0, 4);

// Free downloads (preserved funnel)
const freeDeals = allPosts
	.filter((p) => !isExpired(p) && (isFreePrice(p.data.dealPrice) || (p.data.tags?.includes('free') && p.data.affiliate)))
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<!-- v2 data-desk fonts are self-hosted via @fontsource (imported above). -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "PluginDrop",
			"url": "https://plugindrop.net",
			"description": SITE_DESCRIPTION,
			"potentialAction": {
				"@type": "SearchAction",
				"target": { "@type": "EntryPoint", "urlTemplate": "https://plugindrop.net/posts/?q={search_term_string}" },
				"query-input": "required name=search_term_string",
			},
		})} />
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content" class="v2">

			<!-- ── Sync line + search (search is the first action) ── -->
			<section class="desk-hd">
				<div class="desk-hd-top">
					<div>
						<h1 class="desk-title">Plugin deals, verified daily.</h1>
						<p class="desk-sub">Real prices, tracked hourly. Ranked by Deal Score, not sticker discounts.</p>
					</div>
					<div class="sync">
						<span class="sync-dot" aria-hidden="true"></span>
						<span class="mono">Last synced {lastUpdated}</span>
					</div>
				</div>
				<form class="search" action="/posts/" method="get" role="search">
					<input type="search" name="q" placeholder="Search 250+ plugins, brands, formats…" aria-label="Search plugins" />
					<button type="submit">Search</button>
				</form>
				<a class="method-link mono" href="/plugin-prices/#how">How we verify prices →</a>
			</section>

			<!-- ── Dual split: left rail + live drops table ── -->
			<div class="split">

				<!-- Left rail -->
				<aside class="rail">
					<section class="panel">
						<h2 class="panel-hd">Biggest recent drops</h2>
						{topMovers.length > 0 ? (
							<ul class="movers">
								{topMovers.map((r) => (
									<li>
										<a href={r.href} target="_blank" rel="sponsored noopener">
											<span class="mv-name">{r.name}</span>
											<span class="mv-meta mono">{fmt(r.current)} <span class="mv-drop">−{r.prevChangePct}%</span></span>
										</a>
									</li>
								))}
							</ul>
						) : (
							<p class="empty mono">No tracked drops since last sync.</p>
						)}
					</section>

					<section class="panel">
						<h2 class="panel-hd">Editor&apos;s picks</h2>
						<ul class="picks">
							{editorsPicks.map((post) => (
								<li>
									<a href={`/posts/${post.id}/`}>
										<span class="pk-title">{post.data.title}</span>
										<span class="pk-meta mono">
											{post.data.dealPrice && <strong>{post.data.dealPrice}</strong>}
											{post.data.affiliate && <span class="pk-src"> · {getStoreName(post.data.affiliate)}</span>}
										</span>
									</a>
								</li>
							))}
						</ul>
						<a class="panel-more mono" href="/posts/">All deals →</a>
					</section>
				</aside>

				<!-- Live drops table (data-desk hero) -->
				<section class="feed">
					<div class="feed-hd">
						<h2 class="feed-title">Live drops</h2>
						<span class="legend mono">
							<span class="lg good">● historic low</span>
							<span class="lg ok">● ordinary</span>
							<span class="lg bad">● normal-price “sale”</span>
						</span>
					</div>
					<div class="tbl-wrap">
						<table class="tbl">
							<thead>
								<tr>
									<th class="c-name">Plugin</th>
									<th class="c-hist">History</th>
									<th class="c-num">Current</th>
									<th class="c-num">All-time low</th>
									<th class="c-num">Off</th>
									<th class="c-score">Score</th>
									<th class="c-chk">Checked</th>
								</tr>
							</thead>
							<tbody>
								{liveDrops.map((r) => (
									<tr>
										<td class="c-name">
											<a href={r.href} target="_blank" rel="sponsored noopener" class="row-link">{r.name}</a>
											<span class="cat mono">{r.category}</span>
										</td>
										<td class="c-hist">
											{r.spark ? (
												<svg viewBox="0 0 66 18" width="66" height="18" class="spark" aria-hidden="true" preserveAspectRatio="none">
													<polyline points={r.spark} fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" />
												</svg>
											) : (
												<span class="spark-none" aria-hidden="true">—</span>
											)}
										</td>
										<td class="c-num mono price">{fmt(r.current)}</td>
										<td class="c-num mono dim">{fmt(r.atl)}</td>
										<td class="c-num mono">{r.offPct > 0 ? `${r.offPct}%` : '—'}</td>
										<td class="c-score">
											<span class={`badge ${r.verdict}`}>{r.score}</span>
										</td>
										<td class="c-chk mono dim">{r.checked} · PB</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					<a class="feed-more" href="/plugin-prices/">Open full price tracker →</a>
				</section>
			</div>

			<!-- ── Free downloads (preserved funnel) ── -->
			{freeDeals.length > 0 && (
				<section class="strip-sec">
					<h2 class="strip-hd">Free downloads</h2>
					<div class="strip">
						{freeDeals.map((post) => (
							<a href={`/posts/${post.id}/`} class="scard">
								<span class="sc-title">{post.data.title}</span>
								<span class="sc-tag mono">FREE{post.data.affiliate ? ` · ${getStoreName(post.data.affiliate)}` : ''}</span>
							</a>
						))}
					</div>
				</section>
			)}

			<!-- ── Production guides (preserved funnel, no emoji) ── -->
			<section class="strip-sec">
				<div class="strip-hd-row">
					<h2 class="strip-hd">Production guides</h2>
					<a class="panel-more mono" href="/free/">All guides →</a>
				</div>
				<div class="strip">
					<a href="/posts/best-free-synth-plugins/" class="scard"><span class="sc-title">14 Best Free Synths 2026</span></a>
					<a href="/posts/best-free-reverb-vst-plugins/" class="scard"><span class="sc-title">Best Free Reverb 2026</span></a>
					<a href="/posts/vital-synthesizer-review-2026/" class="scard"><span class="sc-title">Vital Synth Review</span></a>
					<a href="/posts/serum-vst-review/" class="scard"><span class="sc-title">Is Serum Worth It?</span></a>
					<a href="/posts/best-free-vst-plugins-beginners/" class="scard"><span class="sc-title">Free Plugins for Beginners</span></a>
					<a href="/posts/best-free-eq-vst-plugins/" class="scard"><span class="sc-title">Best Free EQ Plugins</span></a>
				</div>
			</section>

		</main>

		<div class="disclosure">
			<div class="disclosure-inner">
				PluginDrop uses affiliate links. We may earn a small commission &mdash; at no extra cost to you.
				<a href="/about#affiliate">Learn more</a>
			</div>
		</div>

		<Footer />
	</body>
</html>

<style>
	/* Metric-adjusted fallbacks (Arial-based) so the swap from fallback to the
	   self-hosted webfont causes minimal reflow (CLS). Approximate metrics; can
	   be fine-tuned against measured CLS later. */
	@font-face {
		font-family: "Source Sans 3 Fallback";
		src: local("Arial");
		ascent-override: 91.52%;
		descent-override: 25.42%;
		line-gap-override: 0%;
		size-adjust: 100.06%;
	}
	@font-face {
		font-family: "Space Grotesk Fallback";
		src: local("Arial");
		ascent-override: 95.7%;
		descent-override: 24.4%;
		line-gap-override: 0%;
		size-adjust: 104%;
	}

	/* ── v2 data-desk, page-scoped tokens (no global.css change) ── */
	main.v2 {
		--v2-bg: #1B1917;
		--v2-surface: #211F1C;
		--v2-surface-2: #272420;
		--v2-line: #332F2A;
		--v2-ink: #EDE6DD;
		--v2-ink-2: #B7ADA1;
		--v2-ink-dim: #8A8177;
		--v2-mint: #5FB49C;
		--v2-good: #3DBE74;
		--v2-ok: #E0A93B;
		--v2-bad: #D5584E;
		--v2-mono: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, monospace;
		--v2-head: "Space Grotesk Variable", "Space Grotesk Fallback", system-ui, sans-serif;
		--v2-body: "Source Sans 3 Variable", "Source Sans 3 Fallback", system-ui, sans-serif;

		width: 100%;
		max-width: 1180px;
		background: var(--v2-bg);
		color: var(--v2-ink);
		font-family: var(--v2-body);
	}
	main.v2 .mono { font-family: var(--v2-mono); font-variant-numeric: tabular-nums; }

	/* ── Header / sync / search ── */
	.desk-hd { padding: 0.5rem 0 1.75rem; border-bottom: 1px solid var(--v2-line); margin-bottom: 1.75rem; }
	.desk-hd-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
	.desk-title {
		font-family: var(--v2-head);
		font-weight: 600; font-size: 2rem; letter-spacing: -0.02em; line-height: 1.1;
		color: var(--v2-ink); margin: 0 0 0.35rem;
	}
	.desk-sub { color: var(--v2-ink-2); font-size: 0.95rem; margin: 0; }
	.sync { display: flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; color: var(--v2-ink-dim); white-space: nowrap; }
	.sync-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--v2-mint); display: inline-block; }

	.search { display: flex; gap: 0.5rem; margin: 1.25rem 0 0.6rem; }
	.search input {
		flex: 1; background: var(--v2-surface); border: 1px solid var(--v2-line);
		border-radius: 4px; padding: 0.7rem 0.9rem; color: var(--v2-ink);
		font-family: var(--v2-body); font-size: 0.95rem;
	}
	.search input::placeholder { color: var(--v2-ink-dim); }
	.search input:focus { outline: none; border-color: var(--v2-mint); box-shadow: 0 0 0 1px var(--v2-mint); }
	.search button {
		background: var(--v2-mint); color: #10201A; border: none; border-radius: 4px;
		padding: 0 1.1rem; font-weight: 700; font-size: 0.9rem; cursor: pointer;
		font-family: var(--v2-body);
	}
	.search button:hover { filter: brightness(1.08); }
	.method-link { font-size: 0.74rem; color: var(--v2-mint); }

	/* ── Split layout ── */
	.split { display: grid; grid-template-columns: 300px 1fr; gap: 1.5rem; align-items: start; margin-bottom: 2.5rem; }

	.panel { background: var(--v2-surface); border: 1px solid var(--v2-line); border-radius: 4px; padding: 0.9rem 1rem 1rem; margin-bottom: 1rem; }
	.panel-hd {
		font-family: var(--v2-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.09em;
		color: var(--v2-ink-dim); font-weight: 600; margin: 0 0 0.7rem;
	}
	.movers, .picks { list-style: none; margin: 0; padding: 0; }
	.movers li, .picks li { border-top: 1px solid var(--v2-line); }
	.movers li:first-child, .picks li:first-child { border-top: none; }
	.movers a, .picks a { display: block; padding: 0.55rem 0; text-decoration: none; }
	.mv-name, .pk-title { display: block; color: var(--v2-ink); font-size: 0.86rem; font-weight: 600; line-height: 1.3; }
	.mv-meta, .pk-meta { display: block; margin-top: 0.15rem; font-size: 0.76rem; color: var(--v2-ink-2); }
	.mv-drop { color: var(--v2-good); font-weight: 700; }
	.pk-meta strong { color: var(--v2-ink); font-weight: 700; }
	.pk-src { color: var(--v2-ink-dim); }
	.movers a:hover .mv-name, .picks a:hover .pk-title { color: var(--v2-mint); }
	.panel-more { display: inline-block; margin-top: 0.6rem; font-size: 0.74rem; color: var(--v2-mint); }
	.empty { color: var(--v2-ink-dim); font-size: 0.78rem; }

	/* ── Live drops table ── */
	.feed-hd { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
	.feed-title { font-family: var(--v2-head); font-size: 1.15rem; font-weight: 600; color: var(--v2-ink); margin: 0; }
	.legend { font-size: 0.68rem; color: var(--v2-ink-dim); display: flex; gap: 0.85rem; flex-wrap: wrap; }
	.legend .good { color: var(--v2-good); }
	.legend .ok { color: var(--v2-ok); }
	.legend .bad { color: var(--v2-bad); }

	.tbl-wrap { overflow-x: auto; border: 1px solid var(--v2-line); border-radius: 4px; }
	.tbl { width: 100%; border-collapse: collapse; min-width: 640px; }
	.tbl th {
		font-family: var(--v2-mono); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.07em;
		color: var(--v2-ink-dim); font-weight: 600; text-align: left; padding: 0.55rem 0.7rem;
		background: var(--v2-surface-2); border-bottom: 1px solid var(--v2-line); white-space: nowrap;
	}
	.tbl td { padding: 0.6rem 0.7rem; border-bottom: 1px solid var(--v2-line); vertical-align: middle; }
	.tbl tbody tr:last-child td { border-bottom: none; }
	.tbl tbody tr:nth-child(even) { background: rgba(255,255,255,0.014); }
	.tbl tbody tr:hover { background: var(--v2-surface); }

	.c-num, .c-score { text-align: right; white-space: nowrap; }
	.c-chk { white-space: nowrap; }
	.row-link { display: block; color: var(--v2-ink); font-weight: 600; font-size: 0.88rem; text-decoration: none; line-height: 1.25; }
	.row-link:hover { color: var(--v2-mint); }
	.cat { display: block; font-size: 0.66rem; color: var(--v2-ink-dim); margin-top: 0.1rem; }
	.price { color: var(--v2-ink); font-weight: 700; }
	.dim { color: var(--v2-ink-dim); }
	.spark { color: var(--v2-mint); display: block; }
	.spark-none { color: var(--v2-ink-dim); font-family: var(--v2-mono); }

	.badge {
		display: inline-block; min-width: 2.1em; text-align: center;
