    .home-deal-rail .variant-row .copy-attribution{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:.85rem}
    .home-deal-rail .variant-row .price{order:3;margin:auto 0 0;padding-top:.7rem}
    .home-deal-rail .variant-row .price strong{font-size:1.25rem}
