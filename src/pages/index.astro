  }
@media(max-width:680px){
  .brand-cluster .brand-title,.brand-cluster .brand-meta{display:none}.brand-cluster .brand-title-mobile{display:block}
  .home-intro{padding:.2rem 0 .55rem}.home-intro .eyebrow{display:none}.home-intro h1{font-size:1.6rem}.home-intro p{margin:.25rem 0 0;font-size:.78rem;white-space:nowrap}
  .home-section{margin-top:1.35rem}.section-heading{margin-bottom:.55rem;padding-bottom:.4rem}.section-heading h2{font-size:1.2rem}.section-heading .eyebrow{font-size:.58rem}
  .brand-cluster .section-heading h2{font-size:1rem;line-height:1.3}.brand-cluster .section-heading>a{align-self:end}
  .brand-cluster .compact-rail{gap:.35rem}.brand-cluster .compact-rail>.new-deal-card:nth-child(n+4){display:none}
  .brand-cluster .variant-row{min-height:64px;max-height:68px;overflow:hidden}.brand-cluster .variant-row .card-art{grid-row:1/2;height:64px}.brand-cluster .variant-row .card-copy{max-height:64px;overflow:hidden}.brand-cluster .variant-row .card-copy-line,.brand-cluster .variant-row .signal-row,.brand-cluster .variant-row .price s{display:none}.brand-cluster .variant-row h3{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
  .hot-block{margin-top:.65rem}.hot-grid{gap:.35rem}.hot-grid .variant-row{max-height:72px;overflow:hidden}.hot-grid .variant-row .card-copy-line,.hot-grid .variant-row .signal-row{display:none}
  .category-tiles--chips{gap:.35rem}
}
</style>

<style is:global>.sale-grid[data-view="list"]{grid-template-columns:1fr}.sale-grid[data-view="list"] .variant-grid{display:grid;grid-template-columns:64px minmax(0,1fr)}.sale-grid[data-view="list"] .variant-grid .card-main{display:contents}.sale-grid[data-view="list"] .variant-grid .card-art{grid-row:1/3;aspect-ratio:1}.sale-grid[data-view="list"] .variant-grid .card-copy{min-height:0;padding:.35rem .55rem}.sale-grid[data-view="list"] .variant-grid .card-copy-line{-webkit-line-clamp:1}.sale-grid[data-view="list"] .variant-grid .card-copy h3{font-size:.85rem}.sale-grid[data-view="list"] .variant-grid .price{margin:.2rem 0 0}.sale-grid[data-view="list"] .variant-grid .price strong{font-size:.9rem}.sale-grid[data-view="list"] .variant-grid .off-tag{font-size:.8rem}.sale-grid[data-view="list"] .variant-grid .category-tag,.sale-grid[data-view="list"] .variant-grid .support-chip,.sale-grid[data-view="list"] .variant-grid .card-cta,.sale-grid[data-view="list"] .variant-grid .signal-row .rarity{display:none}</style>
<style is:global>
  .desktop-sale-max{display:none}
  @media(min-width:681px){
    .home-main{padding-top:1rem}
    main.home-main .home-intro.home-intro{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:.2rem 0 1rem;margin-bottom:.45rem;border-bottom:1px solid var(--border)}
    main.home-main .home-intro.home-intro .eyebrow{font-size:.72rem}
