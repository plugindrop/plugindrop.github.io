---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import priceDataRaw from '../data/price_history.json';
import productVideosRaw from '../data/product_videos.json';
import {
	type PriceEntry,
	slugify,
	formatPrice,
	currentPriceOf,
	regularPriceOf,
	pctOff,
} from '../lib/priceUtils';

// --- Price-intelligence hero data (NW-D) -----------------------------------
const priceData = priceDataRaw as { last_updated: string; bundles: Record<string, PriceEntry>; plugins?: Record<string, PriceEntry> };
const trackerEntries: Record<string, PriceEntry> = {
	...(priceData.bundles ?? {}),
	...(priceData.plugins ?? {}),
};
const trackedCount = Object.keys(trackerEntries).length;
const pricePointCount = Object.values(trackerEntries).reduce(
	(n, e) => n + (e.history?.length ?? 0),
	0,
);
const demoVideoCount = Object.keys(productVideosRaw as Record<string, unknown>).length;

// Live drops: a genuine scraped observation below the regular price —
// same honesty rule as the TopDeals sidebar (never "typical" claims here).
const liveDrops = Object.entries(trackerEntries)
	.map(([name, entry]) => {
		const current = currentPriceOf(entry);
		const regular = regularPriceOf(entry);
		return { name, current, regular, off: pctOff(current, regular) };
	})
	.filter((d) => d.off > 0 && d.current !== null && d.regular !== null)
	.sort((a, b) => b.off - a.off)
	.slice(0, 6);

// Brand hub chips — slugs verified against built /brands/ pages
const brandChips = [
	{ label: 'FabFilter', slug: 'fabfilter' },
	{ label: 'iZotope', slug: 'izotope' },
	{ label: 'Native Instruments', slug: 'native-instruments' },
	{ label: 'Arturia', slug: 'arturia' },
	{ label: 'Waves', slug: 'waves' },
	{ label: 'Soundtoys', slug: 'soundtoys' },
	{ label: 'u-he', slug: 'u-he' },
	{ label: 'Valhalla', slug: 'valhalla' },
	{ label: 'Xfer', slug: 'xfer' },
	{ label: 'Spitfire Audio', slug: 'spitfire-audio' },
	{ label: 'Plugin Alliance', slug: 'plugin-alliance' },
	{ label: 'Universal Audio', slug: 'universal-audio' },
];

const allPosts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.filter((p) => p.data.pubDate.valueOf() <= Date.now())  // 未来日の予約投稿は非表示
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function hasHeroImage(post: any): boolean {
	if (post.data.aiImage === true) return false;
	return (
		typeof post.data.heroImage === 'string' &&
		post.data.heroImage.startsWith('/images/') &&
		post.data.heroImage !== '/images/default-placeholder.jpg'
	);
}

function getStoreName(url: string | undefined): string {
	if (!url) return '';
	if (url.includes('pluginboutique.com')) return 'Plugin Boutique';
	if (url.includes('kvraudio.com')) return 'KVR Audio';
	if (url.includes('adsrsounds.com')) return 'ADSR Sounds';
	if (url.includes('loopmasters.com')) return 'Loopmasters';
	if (url.includes('splice.com')) return 'Splice';
	if (url.includes('sweetwater.com')) return 'Sweetwater';
	if (url.includes('thomann.de')) return 'Thomann';
	if (url.includes('waves.com')) return 'Waves';
	if (url.includes('native-instruments.com')) return 'Native Instruments';
	if (url.includes('arturia.com')) return 'Arturia';
	if (url.includes('izotope.com')) return 'iZotope';
	if (url.includes('plugin-alliance.com')) return 'Plugin Alliance';
	try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}

function isNew(date: Date): boolean {
	return (Date.now() - date.getTime()) < 4 * 24 * 60 * 60 * 1000;
}

function isExpired(post: any): boolean {
	if (!post.data.saleExpiry) return false;
	return new Date(post.data.saleExpiry) < new Date();
}

function daysLeft(post: any): number | null {
	if (!post.data.saleExpiry) return null;
	const diff = new Date(post.data.saleExpiry).getTime() - Date.now();
	const days = Math.ceil(diff / (1000 * 60 * 60 * 24));
	return days > 0 ? days : null;
}

function isFreePrice(price: string | undefined): boolean {
	if (!price) return false;
	const p = price.trim().toUpperCase().replace(/[$€£¥]/g, '');
	return p === 'FREE' || p === '0' || p === '0.00';
}

function isRealDeal(post: any): boolean {
	return !!(post.data.discount || (post.data.dealPrice && post.data.originalPrice) || isFreePrice(post.data.dealPrice));
}

function parsePrice(s: string | undefined): number {
	if (!s) return 0;
	const m = s.replace(/,/g, '').match(/[\d]+(?:\.\d+)?/);
	return m ? parseFloat(m[0]) : 0;
}

function getDiscountBadge(post: any): string | null {
	if (post.data.discount) return post.data.discount;
	const dp = parsePrice(post.data.dealPrice);
	const op = parsePrice(post.data.originalPrice);
	if (dp > 0 && op > dp) {
		const pct = Math.round((1 - dp / op) * 100);
		return pct > 0 ? `${pct}% OFF` : null;
	}
	return null;
}

const heroPosts = allPosts.filter(hasHeroImage);

// sample-pack-deal タグ付きアイテムは /tags/sample-pack-deal/ のみに表示
// （無名ブランドのサンプルパック・プリセット等をメインフィードから除外）
function isSamplePackDeal(post: any): boolean {
	return post.data.tags?.includes('sample-pack-deal') ?? false;
}

// Editor's Picks: scored paid deals, non-expired, with affiliate + hero image (FREE excluded → shown in Free Deals section)
const topDeals = heroPosts
	.filter(p => p.data.affiliate && !isExpired(p) && isRealDeal(p) && !isFreePrice(p.data.dealPrice) && !isSamplePackDeal(p))
	.sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0))
	.slice(0, 4);

const topIds = new Set(topDeals.map(p => p.id));

// Recent Deals: 有料ディールのみ（isRealDeal + 非FREE）、Editor's Picks除外
const recentDeals = heroPosts
	.filter(p => !topIds.has(p.id) && !isExpired(p) && p.data.affiliate && isRealDeal(p) && !isFreePrice(p.data.dealPrice) && !isSamplePackDeal(p))
	.slice(0, 6);

// Free Deals: confirmed free, non-expired, not shown above (recentDeals excluded too)
const recentIds = new Set(recentDeals.map(p => p.id));
const freeDeals = allPosts
	.filter(p => hasHeroImage(p) && !topIds.has(p.id) && !recentIds.has(p.id) && !isExpired(p) && (
		isFreePrice(p.data.dealPrice) ||
		(p.data.tags?.includes('free') && p.data.affiliate)
	))
	.slice(0, 3);

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "PluginDrop",
			"url": "https://plugindrop.net",
			"description": SITE_DESCRIPTION,
			"potentialAction": {
				"@type": "SearchAction",
				"target": { "@type": "EntryPoint", "urlTemplate": "https://plugindrop.net/posts/?q={search_term_string}" },
				"query-input": "required name=search_term_string",
			},
		})} />
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Header />
		<main id="main-content">

			<!-- ── Hero Strip: price intelligence (NW-D) ── -->
			<section class="hero-strip">
				<div class="hero-headline-wrap">
					<h1 class="hero-headline">Know what a plugin really costs.</h1>
					<p class="hero-sub">
						Daily price tracking, sale history &amp; verified deals &mdash; no hype, no fake reviews.
					</p>
				</div>
				<form class="hero-search" action="/plugin-prices/" method="get" role="search">
					<input
						type="search"
						name="q"
						class="hero-search-input"
						placeholder={`Search ${trackedCount} tracked plugins — e.g. Serum 2, Pro-Q 4…`}
						aria-label="Search tracked plugin prices"
					/>
					<button type="submit" class="hero-search-btn">Check price</button>
				</form>
				<div class="hero-stats">
					<a href="/plugin-prices/" class="hero-stat"><strong>{trackedCount}</strong> plugins tracked</a>
					<span class="hero-stat"><strong>{pricePointCount.toLocaleString('en-US')}</strong> price points logged</span>
					<span class="hero-stat"><strong>{demoVideoCount}</strong> verified demos</span>
					<a href="/brands/" class="hero-stat hero-stat-link">Browse by brand &rarr;</a>
				</div>
			</section>

			<!-- ── Live Price Drops (scraped, not "typical") ── -->
			{liveDrops.length > 0 && (
				<section class="section">
					<header class="section-hd">
						<span class="section-label">📉 Live Price Drops</span>
						<a href="/plugin-prices/" class="section-more">All tracked prices &rarr;</a>
					</header>
					<p class="drops-sub">From our daily price checks &mdash; observed prices, not marketing claims.</p>
					<div class="drop-grid">
						{liveDrops.map((d) => (
							<a href={`/plugin-prices/${slugify(d.name)}/`} class="drop-card">
								<span class="drop-name">{d.name}</span>
								<span class="drop-prices">
									<span class="drop-off">-{d.off}%</span>
									<s class="drop-was">{formatPrice(d.regular)}</s>
									<strong class="drop-now">{formatPrice(d.current)}</strong>
								</span>
								<span class="drop-cta">Price history &rarr;</span>
							</a>
						))}
					</div>
				</section>
			)}

			<!-- ── Editor's Picks ─────────────────────── -->
			{topDeals.length > 0 && (
				<section class="section">
					<header class="section-hd">
						<span class="section-label">Editor&apos;s Picks</span>
						<a href="/posts" class="section-more">See all deals &rarr;</a>
					</header>
					<div class="deal-grid deal-grid--4">
						{topDeals.map(post => {
							const days = daysLeft(post);
							return (
								<a href={`/posts/${post.id}/`} class="deal-card">
									<div class="card-img-wrap">
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
										{getDiscountBadge(post) && <span class="bdg-discount">{getDiscountBadge(post)}</span>}
										{isNew(post.data.pubDate) && <span class="bdg-new">NEW</span>}
									</div>
									<div class="card-body">
										<h4 class="card-title">{post.data.title}</h4>
										{(post.data.dealPrice || post.data.originalPrice) && (
											<div class="price-cluster">
												{post.data.originalPrice && <s class="price-was">{post.data.originalPrice}</s>}
												{post.data.dealPrice && (
													<strong class={`price-now ${isFreePrice(post.data.dealPrice) ? 'is-free' : ''}`}>
														{post.data.dealPrice}
													</strong>
												)}
											</div>
										)}
										{days !== null && days <= 3 && (
											<span class="urgency-badge">⏰ {days === 1 ? 'Last day!' : `${days} days left`}</span>
										)}
										<div class="card-foot">
											{post.data.affiliate && <span class="via-store">{getStoreName(post.data.affiliate)}</span>}
											<span class="card-cta">Get deal &rarr;</span>
										</div>
									</div>
								</a>
							);
						})}
					</div>
				</section>
			)}

			<!-- ── Recent Deals ───────────────────────── -->
			{recentDeals.length > 0 && (
				<section class="section">
					<header class="section-hd">
						<span class="section-label">Recent Deals</span>
						<a href="/posts" class="section-more">See all &rarr;</a>
					</header>
					<div class="deal-grid deal-grid--3">
						{recentDeals.map(post => {
							const days = daysLeft(post);
							return (
								<a href={`/posts/${post.id}/`} class="deal-card">
									{post.data.heroImage && (
										<div class="card-img-wrap">
											<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
											{getDiscountBadge(post) && <span class="bdg-discount">{getDiscountBadge(post)}</span>}
											{isNew(post.data.pubDate) && <span class="bdg-new">NEW</span>}
										</div>
									)}
									<div class="card-body">
										<h4 class="card-title">{post.data.title}</h4>
										{(post.data.dealPrice || post.data.originalPrice) && (
											<div class="price-cluster">
												{post.data.originalPrice && <s class="price-was">{post.data.originalPrice}</s>}
												{post.data.dealPrice && (
													<strong class={`price-now ${isFreePrice(post.data.dealPrice) ? 'is-free' : ''}`}>
														{post.data.dealPrice}
													</strong>
												)}
											</div>
										)}
										{days !== null && days <= 3 && (
											<span class="urgency-badge">⏰ {days === 1 ? 'Last day!' : `${days} days left`}</span>
										)}
										<div class="card-foot">
											{post.data.affiliate && <span class="via-store">{getStoreName(post.data.affiliate)}</span>}
											<span class="card-cta">Read more &rarr;</span>
										</div>
									</div>
								</a>
							);
						})}
					</div>
					<div class="see-all">
						<a href="/posts">View all {allPosts.length} deals &rarr;</a>
					</div>
				</section>
			)}

			<!-- ── Free Deals ─────────────────────────── -->
			{freeDeals.length > 0 && (
				<section class="section section--free">
					<header class="section-hd">
						<span class="section-label section-label--free">Free Downloads</span>
					</header>
					<div class="deal-grid deal-grid--3">
						{freeDeals.map(post => (
							<a href={`/posts/${post.id}/`} class="deal-card deal-card--free">
								{post.data.heroImage && (
									<div class="card-img-wrap">
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
										<span class="bdg-free">FREE</span>
									</div>
								)}
								<div class="card-body">
									<h4 class="card-title">{post.data.title}</h4>
									<div class="price-cluster">
										<strong class="price-now is-free">FREE</strong>
									</div>
									<div class="card-foot">
										{post.data.affiliate && <span class="via-store">{getStoreName(post.data.affiliate)}</span>}
										<span class="card-cta">Get free &rarr;</span>
									</div>
								</div>
							</a>
						))}
					</div>
				</section>
			)}


			<!-- ── Brand Hubs ─────────────────────────── -->
			<section class="section section--brands">
				<header class="section-hd">
					<span class="section-label">🏷 Price Trackers by Brand</span>
					<a href="/brands/" class="section-more">All brands &rarr;</a>
				</header>
				<div class="brand-chip-row">
					{brandChips.map((b) => (
						<a href={`/brands/${b.slug}/`} class="brand-chip">{b.label}</a>
					))}
				</div>
			</section>

			<section class="section section--guides">
				<div class="section-hd">
					<span class="section-label">📖 Production Guides</span>
					<a href="/free/" class="see-all">All guides →</a>
				</div>
				<div class="guide-strip">
					<a href="/posts/best-free-synth-plugins/" class="gcard">
						<span class="gc-emoji">🎹</span>
						<span class="gc-title">14 Best Free Synths 2026</span>
					</a>
					<a href="/posts/best-free-reverb-vst-plugins/" class="gcard">
						<span class="gc-emoji">🌊</span>
						<span class="gc-title">Best Free Reverb 2026</span>
					</a>
					<a href="/posts/vital-synthesizer-review-2026/" class="gcard">
						<span class="gc-emoji">⚡</span>
						<span class="gc-title">Vital Synth Review</span>
					</a>
					<a href="/posts/serum-vst-review/" class="gcard">
						<span class="gc-emoji">🔊</span>
						<span class="gc-title">Is Serum Worth It?</span>
					</a>
					<a href="/posts/best-free-vst-plugins-beginners/" class="gcard">
						<span class="gc-emoji">🎛️</span>
						<span class="gc-title">Free Plugins for Beginners</span>
					</a>
					<a href="/posts/best-free-eq-vst-plugins/" class="gcard">
						<span class="gc-emoji">🎚️</span>
						<span class="gc-title">Best Free EQ Plugins</span>
					</a>
				</div>
			</section>

		</main>

		<div class="disclosure">
			<div class="disclosure-inner">
				PluginDrop uses affiliate links. We may earn a small commission &mdash; at no extra cost to you.
				<a href="/about#affiliate">Learn more</a>
			</div>
		</div>

		<Footer />
	</body>
</html>

<style>
	/* ── Hero Strip ───────────────────────────────────────── */
	.hero-strip {
		padding: 2.25rem 0 1.75rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}
	.hero-headline-wrap { margin-bottom: 0.75rem; }
	/* ── Price-intelligence hero (NW-D) ── */
	.hero-search {
		display: flex;
		gap: 0.5rem;
		max-width: 560px;
		margin: 1rem 0 0.85rem;
	}
	.hero-search-input {
		flex: 1;
		min-width: 0;
		padding: 0.65rem 0.9rem;
		font-size: 0.95rem;
		color: var(--text-primary);
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.hero-search-input::placeholder { color: var(--text-muted); }
	.hero-search-input:focus { outline: none; border-color: var(--accent); }
	.hero-search-btn {
		padding: 0.65rem 1.1rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--bg-base);
		background: var(--accent);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		white-space: nowrap;
	}
	.hero-search-btn:hover { background: var(--accent-light); }
	.hero-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.4rem;
		font-size: 0.82rem;
		color: var(--text-muted);
	}
	.hero-stat { color: var(--text-muted); text-decoration: none; }
	.hero-stat strong { color: var(--text-primary); font-weight: 800; }
	a.hero-stat:hover { color: var(--accent); }
	.hero-stat-link { color: var(--accent-light); }

	/* ── Live Price Drops ── */
	.drops-sub { font-size: 0.8rem; color: var(--text-muted); margin: -0.35rem 0 0.8rem; }
	.drop-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 0.7rem;
	}
	.drop-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.8rem 0.9rem;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-left: 3px solid var(--sale-text);
		border-radius: var(--radius);
		text-decoration: none;
	}
	.drop-card:hover { border-color: var(--accent-border-hover, var(--accent)); }
	.drop-name { font-size: 0.9rem; font-weight: 700; color: var(--text-primary); }
	.drop-prices { display: flex; align-items: center; gap: 0.5rem; }
	.drop-off {
		font-size: 0.7rem;
		font-weight: 700;
		color: #fff;
		background: linear-gradient(135deg, #e63946 0%, #c1121f 100%);
		border-radius: 3px;
		padding: 0.1rem 0.4rem;
	}
	.drop-was { font-size: 0.8rem; color: var(--text-muted); }
	.drop-now { font-size: 0.95rem; font-weight: 800; color: var(--sale-text); }
	.drop-cta { font-size: 0.75rem; color: var(--accent-light); }

	/* ── Brand chips ── */
	.section--brands { padding-top: 1.6rem; border-top: 1px solid var(--border); }
	.brand-chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.brand-chip {
		padding: 0.4rem 0.85rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-primary);
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 999px;
		text-decoration: none;
	}
	.brand-chip:hover { border-color: var(--accent); color: var(--accent); }
	.hero-headline {
		font-family: var(--font-display);
		font-size: 2.75rem;
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.1;
		color: var(--text-primary);
		margin: 0 0 0.5rem;
	}
	.hero-sub {
		color: var(--text-secondary);
		font-size: 0.95rem;
		margin: 0;
		line-height: 1.5;
	}

	/* ── Sections ─────────────────────────────────────────── */
	.section { margin-bottom: 3rem; }
	.section--free {
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
	.section-hd {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1rem;
		gap: 1rem;
	}
	.section-label {
		font-size: 0.68rem;
		font-weight: 800;
		color: var(--text-muted);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.section-label--free { color: var(--free-text, #4caf50); }
	.section-more {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.15s;
	}
	.section-more:hover { color: var(--accent-dark); }

	/* ── Price atoms ──────────────────────────────────────── */
	.price-cluster {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		flex-wrap: wrap;
	}
	.price-was {
		font-size: 0.8rem;
		color: var(--text-muted);
		text-decoration: line-through;
		font-weight: 400;
	}
	.price-now {
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--text-primary);
		letter-spacing: -0.02em;
	}
