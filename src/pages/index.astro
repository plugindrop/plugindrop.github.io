---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DealCard from '../components/DealCard.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import BrandTiles from '../components/BrandTiles.astro';
import FreeCard from '../components/FreeCard.astro';
import GuideCard from '../components/GuideCard.astro';
import HomeFilters from '../components/HomeFilters.astro';
import { gridOrderAttrs } from '../lib/homeSort.mjs';
import { SITE_TITLE, SITE_DESCRIPTION, ENABLE_PIP_PREVIEW } from '../consts';
import priceData from '../data/price_history.json';
import freeFacts from '../data/free_plugin_facts.json';
import videos from '../data/product_videos.json';
import copy from '../data/deal_copy.json';
import facts from '../data/plugin_facts.json';
import { siteStats } from '../lib/siteStats.mjs';
import { buildDealPool, toCardModel, pickSpotlight, orderForVariety, endingSoon, brandSaleClusters, categoryTiles, brandTiles, allocateSections } from '../lib/homeDeals.mjs';

const now = Date.now();
const entries = { ...priceData.bundles, ...priceData.plugins };
const posts = (await getCollection('blog')).filter(p => !p.data.draft && p.data.pubDate.valueOf() <= now);
const pool = buildDealPool(entries, posts, now);
const cards = pool.map(deal => toCardModel(deal, { entries, priceData, now, videos, copy, facts })).sort((a, b) => (a.image.kind === 'typographic') - (b.image.kind === 'typographic'));
const spotlight = pickSpotlight(cards);
const hotCandidates = cards.filter(c => !c.aboveUsual && c.key !== spotlight?.key && c.image.kind !== 'typographic');
const hot = [...hotCandidates.filter(c => c.tagline?.trim()), ...hotCandidates.filter(c => !c.tagline?.trim())].filter((c, i, a) => !c.brand || a.findIndex(x => x.brand === c.brand) === i).slice(0, 4);
const featured = new Set([spotlight?.key, ...hot.map(c => c.key)]);
const clusters = brandSaleClusters(cards.filter(c => !featured.has(c.key)), entries).map(cluster => ({ ...cluster, cards: cluster.cards.slice(0, Math.floor(cluster.cards.length / 4) * 4) })).filter(cluster => cluster.cards.length);
const inClusters = new Set(clusters.flatMap(cluster => cluster.cards.map(card => card.key)));
const soonCandidates = endingSoon(cards.filter(c => !featured.has(c.key) && !inClusters.has(c.key)));
const soon = soonCandidates.slice(0, Math.floor(soonCandidates.length / 4) * 4);
const reserved = new Set([...featured, ...inClusters, ...soon.map(c => c.key)]);
const available = cards.filter(c => !reserved.has(c.key));
const pictured = available.filter(c => c.image.kind !== 'typographic');
const textOnly = available.filter(c => c.image.kind === 'typographic').slice(0, 4);
const balanced = [...pictured, ...textOnly];
const ordered = orderForVariety(balanced);
const remaining = ordered;
const sections = allocateSections({ spotlight, hot, clusters, soon, grid: remaining });
const dealsByName = new Map(pool.map(deal => [deal.name, deal]));
const withSection = (card, section) => card && toCardModel(dealsByName.get(card.key), { entries, priceData, now, videos, copy, facts, section });
sections.spotlight = withSection(sections.spotlight, 'spotlight');
sections.hot = sections.hot.map(card => withSection(card, 'hot'));
sections.clusters = sections.clusters.map(cluster => ({ ...cluster, cards: cluster.cards.map(card => withSection(card, 'cluster')) }));
sections.soon = sections.soon.map(card => withSection(card, 'soon'));
sections.gridInitial = sections.gridInitial.map(card => withSection(card, 'grid'));
sections.gridExtra = sections.gridExtra.map(card => withSection(card, 'grid'));
const initialShortfall = Math.max(0, Math.min(12, sections.gridInitial.length + sections.gridExtra.length) - sections.gridInitial.length);
if (initialShortfall && sections.soon.length >= initialShortfall) {
  const moved = sections.soon.splice(-initialShortfall);
  const allGrid = [...sections.gridInitial, ...sections.gridExtra];
  const visible = [sections.spotlight, ...sections.hot, ...sections.clusters.flatMap(cluster => cluster.cards), ...sections.soon].filter(Boolean);
  const brandCounts = new Map();
  for (const card of visible) if (card.brand) brandCounts.set(card.brand, (brandCounts.get(card.brand) ?? 0) + 1);
  const chosen = [], deferred = [], gridBrands = new Map();
  for (const card of allGrid) {
    const brand = card.brand;
    if (chosen.length < 12 && (!brand || ((brandCounts.get(brand) ?? 0) < 8 && (gridBrands.get(brand) ?? 0) < 3))) {
      chosen.push(card);
      if (brand) { brandCounts.set(brand, (brandCounts.get(brand) ?? 0) + 1); gridBrands.set(brand, (gridBrands.get(brand) ?? 0) + 1); }
    } else deferred.push(card);
  }
  sections.gridInitial = chosen;
  sections.gridExtra = [...deferred, ...moved];
}
const gridCards = [...sections.gridInitial, ...sections.gridExtra];
const gridOrders = gridOrderAttrs(gridCards);
const categories = categoryTiles(cards), brands = brandTiles(cards, entries);
const topCategories = categories.slice().sort((a, b) => b.count - a.count).slice(0, 4).map(c => ({'Synths':'Synth','Reverb & Delay':'Reverb','Compression':'Compressor','EQ & Mixing':'EQ'}[c.label] ?? c.label));
const stats = siteStats(priceData);
const month = stats.trackingSince ? new Date(`${stats.trackingSince}T00:00:00Z`).toLocaleDateString('en-US',{month:'short',year:'numeric',timeZone:'UTC'}) : '';
const checked = new Date(`${priceData.last_updated}T00:00:00Z`).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'});
const factProducts = Object.values(freeFacts.articles).flat();
const freeImages = { 'Vital':'/images/heroes/vital.jpg', 'Surge XT':'/images/heroes/surge-xt.jpg', 'Dexed':'/images/heroes/dexed.jpg', 'LABS':'/images/heroes/spitfire-labs.jpg' };
const freeItems = ['Vital','Surge XT','TAL-NoiseMaker','OB-Xd','Dexed','LABS'].map(name => { const fact = factProducts.find(f => f.name.toLowerCase() === name.toLowerCase() && /^https?:/.test(f.official_url ?? '')); const post = posts.find(p => p.data.title.toLowerCase().includes(name.toLowerCase()) && p.data.heroImage?.startsWith('/images/') && !p.data.aiImage); return fact ? { name, url:fact.official_url, image:freeImages[name] ?? post?.data.heroImage ?? null } : null; }).filter(Boolean).slice(0,4);
const guides = posts.filter(p => !p.data.noindex && (p.data.evergreen || p.data.tags?.includes('guide')) && p.data.heroImage?.startsWith('/images/')).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
---
<!doctype html>
<html lang="en"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'PluginDrop',url:'https://plugindrop.net',description:SITE_DESCRIPTION,potentialAction:{'@type':'SearchAction',target:{'@type':'EntryPoint',urlTemplate:'https://plugindrop.net/posts/?q={search_term_string}'},'query-input':'required name=search_term_string'}})} /></head>
<body><a href="#main-content" class="sr-only">Skip to content</a><Header /><main id="main-content" class="home-main">
  <div class="home-intro"><div class="masthead-title"><span class="eyebrow">PLUGIN DEALS · LIVE PRICES</span><h1>On sale now</h1></div><p>{cards.length} deals tracked · prices checked {checked}</p></div>
  {sections.spotlight && <section class="feature-section" aria-label="Featured deals"><div class="feature-main"><DealCard deal={sections.spotlight} variant="spotlight" eager /></div><div class="hot-block"><h2>Worth a look</h2><div class="hot-grid">{sections.hot.map(card => <DealCard deal={card} variant="row" />)}</div></div></section>}
  <section class="home-section"><div class="section-heading"><div><span class="eyebrow">FIND YOUR SOUND</span><h2>What are you making?</h2></div><a href="/categories/">Browse categories →</a></div><CategoryTiles tiles={categories} chips /></section>
  {sections.clusters.map(cluster => <section class="home-section brand-cluster home-deal-rail"><div class="section-heading"><div><span class="eyebrow">BRAND SALE<span class="desktop-sale-max"> · UP TO {cluster.summary.max}% OFF</span></span><h2 class="brand-title">{cluster.brand}</h2><p class="brand-meta">{cluster.summary.count} plugins &middot; {cluster.summary.min}&ndash;{cluster.summary.max}% off &middot; from ${cluster.summary.minPrice.toFixed(2)} &middot; ends {new Date(`${cluster.until}T00:00:00Z`).toLocaleDateString('en-US',{month:'short',day:'numeric',timeZone:'UTC'})}</p><h2 class="brand-title-mobile">{cluster.brand} &middot; {cluster.summary.count} plugins &middot; {cluster.summary.min}&ndash;{cluster.summary.max}% off &middot; from ${cluster.summary.minPrice.toFixed(2)} &middot; ends {new Date(`${cluster.until}T00:00:00Z`).toLocaleDateString('en-US',{month:'short',day:'numeric',timeZone:'UTC'})}</h2></div><a href={cluster.href}>View all {cluster.count} →</a></div><div class="compact-rail">{cluster.cards.map(card => <DealCard deal={card} variant="row" />)}</div></section>)}
  {sections.soon.length > 0 && <section class="home-section home-deal-rail"><div class="section-heading"><div><span class="eyebrow">TIME LIMITED</span><h2>Ending soon</h2></div></div><div class="compact-rail">{sections.soon.map(card => <DealCard deal={card} variant="row" />)}</div></section>}
  <section class="home-section" id="deals"><div class="section-heading"><div><span class="eyebrow">CURRENT DEALS</span><h2><span class="desktop-all-title">All deals</span><span class="mobile-all-title">On sale now</span> <span>({cards.length})</span></h2></div><a href="/plugin-prices/">View all {cards.length} →</a></div><HomeFilters categories={topCategories} /><div id="sale-grid" class="sale-grid">{gridCards.map((card,i) => <div class="grid-item" data-order-off={gridOrders[card.key].off} data-order-until={gridOrders[card.key].until} data-order-price={gridOrders[card.key].price} data-order-low={gridOrders[card.key].low} data-extra={i>=sections.gridInitial.length?'true':undefined}><DealCard deal={card} deferImage={i>=sections.gridInitial.length} /></div>)}</div>{sections.gridExtra.length>0 && <button type="button" id="show-more-deals">Show {sections.gridExtra.length} more deals ↓</button>}</section>
  {freeItems.length>0 && <section class="home-section"><div class="section-heading"><div><span class="eyebrow">OFFICIAL DOWNLOADS</span><h2>Free plugins worth downloading</h2></div><a href="/free/">More free plugins →</a></div><div class="free-grid">{freeItems.map(item => <FreeCard item={item} />)}</div></section>}
  {guides.length>0 && <section class="home-section"><div class="section-heading"><div><span class="eyebrow">READ & EXPLORE</span><h2>Guides</h2></div><a href="/posts/">All articles →</a></div><div class="guide-grid">{guides.map(post => <GuideCard post={post} />)}</div></section>}
  <section class="home-section"><div class="section-heading"><div><span class="eyebrow">EXPLORE THE CATALOG</span><h2>Shop by brand</h2></div><a href="/brands/">All brands →</a></div><BrandTiles tiles={brands} /></section>
  <p class="freshness"><span data-tracked-products={stats.trackedProducts}>{stats.trackedProducts}</span> products tracked since {month} · prices last checked {checked} · <a href="/how-we-track-prices/">How we track prices →</a></p>
</main><Footer />{ENABLE_PIP_PREVIEW && <script is:inline src="/js/pip-preview.js"></script>}<script is:inline>const saleGrid=document.querySelector('#sale-grid');if(saleGrid&&window.matchMedia('(max-width: 680px)').matches)saleGrid.dataset.view='list';document.querySelectorAll('[data-deal-card] a[href*="pluginboutique.com"]').forEach(link=>link.addEventListener('click',()=>{if(typeof gtag==='undefined')return;const href=link.getAttribute('href')||'';const section=new URL(href).searchParams.get('data1')?.split('--').at(-1);if(!['spotlight','hot','cluster','soon','grid'].includes(section))return;window.dataLayer=window.dataLayer||[];function gt(){window.dataLayer.push(arguments)}gt('event','affiliate_click',{link_url:href,link_text:link.textContent?.trim().slice(0,80),page_title:document.title,link_location:section})}));document.querySelector('#show-more-deals')?.addEventListener('click',function(){document.querySelectorAll('#sale-grid [data-extra]').forEach(x=>(x.removeAttribute('data-extra'),x.querySelectorAll('[data-image-src]').forEach(holder=>{const img=document.createElement('img');img.src=holder.dataset.imageSrc;img.alt='';img.width=640;img.height=400;img.loading='lazy';img.decoding='async';holder.replaceWith(img)})));this.remove()})</script></body></html>
<style>
  .feature-section{align-items:stretch}.feature-main{display:flex}.feature-main :global(.new-deal-card){width:100%}
  :global(html){overflow-x:clip}
  :global(.home-main){max-width:1440px;margin:auto;padding:1.5rem 1.5rem 4rem;overflow:hidden}.home-intro{padding:.4rem 0 .7rem}.eyebrow{font:700 .67rem var(--font-mono);letter-spacing:.12em;color:var(--accent)}.home-intro h1{margin:.2rem 0;font:600 clamp(2.2rem,5vw,4rem)/1 var(--font-display);color:var(--text-primary)}.home-intro p{margin:.5rem 0 0;color:var(--text-secondary);font-size:.9rem}.feature-section{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:1rem}.feature-main,.hot-block{min-width:0}.hot-block h2{margin:0 0 .5rem;font:600 1.3rem var(--font-display)}.hot-block{display:flex;flex-direction:column}.hot-grid{flex:1;display:grid;grid-template-columns:1fr;grid-template-rows:repeat(4,minmax(0,1fr));gap:.5rem}.hot-grid :global(.card-copy){padding:.55rem}.hot-grid :global(.support-chip){display:none}.home-section{margin-top:2rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1rem;border-bottom:1px solid var(--border);padding-bottom:.65rem}.section-heading h2{margin:.15rem 0 0;font:600 clamp(1.5rem,2.5vw,2.2rem)/1.1 var(--font-display)}.section-heading h2 span{font:400 .85rem var(--font-body);color:var(--text-muted)}.section-heading>a{flex:none;font-size:.78rem}.compact-rail{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.55rem}.sale-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem}.grid-item{min-width:0}.grid-item[data-extra]{display:none}.sale-grid[data-filtered="true"] .grid-item[data-extra]:not([hidden]){display:block}#show-more-deals[hidden]{display:none}#show-more-deals{display:block;margin:1.5rem auto 0;padding:.7rem 1.5rem;border:1px solid var(--accent);background:transparent;color:var(--accent);font:700 .8rem var(--font-mono);cursor:pointer}.free-grid,.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.freshness{margin:3rem 0 1.2rem;padding:1rem 0;border-top:1px solid var(--border);color:var(--text-muted);font:.73rem var(--font-mono)}
  @media(max-width:1050px){.feature-section{grid-template-columns:1fr}.hot-grid{grid-template-columns:1fr;grid-template-rows:none}.compact-rail,.sale-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:680px){:global(.home-main){padding:1rem .7rem 3rem}.home-intro{padding:.5rem 0 1rem}.feature-section{display:block}.hot-block{margin-top:1.2rem}.hot-grid{display:grid;grid-template-columns:1fr;grid-template-rows:none;overflow:visible}.hot-grid :global(.new-deal-card){min-width:0}.home-section{margin-top:2.3rem}.section-heading{align-items:start}.section-heading h2{font-size:1.5rem}.section-heading>a{font-size:.68rem;text-align:right}.compact-rail{display:grid;grid-template-columns:1fr;overflow:visible}.compact-rail :global(.new-deal-card){min-width:0}.sale-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}.free-grid{display:flex;overflow-x:auto}.free-grid :global(.free-card){min-width:65%}.guide-grid{grid-template-columns:1fr}.freshness{line-height:1.6}}
</style>


<style is:global>
  .brand-cluster .brand-title-mobile{display:none}
  .brand-cluster .brand-meta{margin:.3rem 0 0;color:var(--text-muted);font:400 .85rem/1.4 var(--font-body)}
  .desktop-sale-max,.desktop-all-title{display:none}
  .mobile-all-title{font:inherit!important;color:inherit!important}
