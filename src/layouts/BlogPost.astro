		</style>
		<!-- Global iframe/video styles (markdown content lacks Astro scoping CIDs) -->
		<style is:global>
			.skip-link {
				position: absolute;
				top: -40px;
				left: 0;
				z-index: 999;
				padding: 0.75rem 1rem;
				background: var(--bg-base);
				color: var(--accent-light);
				text-decoration: none;
				border-radius: 0 0 6px 0;
			}
			.skip-link:focus {
				top: 0;
			}
			.prose iframe {
				width: 100%;
				aspect-ratio: 16 / 9;
				border: 0;
				border-radius: 6px;
				display: block;
				margin: 1.5rem 0;
			}
			.video-embed {
				position: relative;
				width: 100%;
				padding-bottom: 56.25%;
				height: 0;
				overflow: hidden;
				border-radius: 6px;
				margin: 1.5rem 0;
			}
			.video-embed iframe {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				border: 0;
				margin: 0;
				aspect-ratio: unset;
			}
		</style>
		<style>
			/* 600px breakpoint */
			@media (max-width: 600px) {
				.article-header h1 {
					font-size: clamp(1.35rem, 5vw, 1.8rem);
				}
				.prose {
					font-size: 0.95rem;
				}
				.hero-image {
					margin: 0 -1rem;
					border-radius: 0;
				}
				.related-posts {
					grid-template-columns: 1fr;
				}
				.related-thumb {
					width: 64px;
					height: 36px;
				}
			}
			@media (max-width: 720px) {
				.article-header h1 { font-size: 1.5rem; }
				.hero-image { padding: 1rem 0.5rem 0; }
			}
		</style>
		<!-- Wrap tables in scrollable container -->
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				document.querySelectorAll('.prose table').forEach(table => {
					if (!table.parentElement?.classList.contains('table-wrap')) {
						const wrap = document.createElement('div');
						wrap.className = 'table-wrap';
						table.parentElement?.insertBefore(wrap, table);
						wrap.appendChild(table);
					}
				});
				// Hide [INTERNAL: ...] placeholders
				document.querySelectorAll('.prose p').forEach(p => {
					if (p.textContent?.trim().startsWith('[INTERNAL:')) {
						p.style.display = 'none';
					}
				});
				// Open external links in new tab
				document.querySelectorAll('.prose a[href^="http"]').forEach(link => {
					link.setAttribute('target', '_blank');
					link.setAttribute('rel', 'noopener noreferrer');
				});
				// Wrap YouTube iframes in .video-embed for responsive 16:9 sizing
				document.querySelectorAll('.prose iframe[src*="youtube"]').forEach(iframe => {
					if (!iframe.parentElement?.classList.contains('video-embed')) {
						const wrap = document.createElement('div');
						wrap.className = 'video-embed';
						iframe.parentElement?.insertBefore(wrap, iframe);
						wrap.appendChild(iframe);
					}
					iframe.setAttribute('loading', 'lazy');
					iframe.src = iframe.src.replace('youtube.com/embed', 'youtube-nocookie.com/embed');
				});
				// Countdown timer
				const cdEl = document.getElementById('deal-countdown');
				if (cdEl) {
					const expiry = new Date(cdEl.dataset.expiry || '').getTime();
					const tick = () => {
						const diff = expiry - Date.now();
						if (diff <= 0) { cdEl.style.display = 'none'; return; }
						const d = Math.floor(diff / 86400000);
						const h = Math.floor((diff % 86400000) / 3600000);
						const m = Math.floor((diff % 3600000) / 60000);
						const fmt = (n: number) => String(n).padStart(2, '0');
						document.getElementById('cd-d')!.textContent = String(d);
						document.getElementById('cd-h')!.textContent = fmt(h);
						document.getElementById('cd-m')!.textContent = fmt(m);
					};
					tick();
					setInterval(tick, 60000);
				}
				// Track affiliate link clicks in GA4
				// 本文中の a_aid 付きリンク、deal-cta-btn、sticky-cta も含めて全て計測
				const AFFILIATE_HOSTS = ['pluginboutique.com','splice.com','adsrsounds.com','loopmasters.com','sweetwater.com','thomann.de','waves.com','beatport.com','djcity.com','pluginfox.com','unison.audio','udemy.com'];
				document.querySelectorAll('.deal-cta-btn, .sticky-cta a, .prose a[href^="http"]').forEach(link => {
					const href = link.getAttribute('href') || '';
					const isAffiliate = href.includes('a_aid=') || href.includes('?ref=') || href.includes('?affid=') || AFFILIATE_HOSTS.some(h => href.includes(h));
					if (!isAffiliate && !link.classList.contains('deal-cta-btn') && !link.closest('.sticky-cta')) return;
					link.addEventListener('click', () => {
						if (typeof gtag !== 'undefined') {
							gtag('event', 'affiliate_click', {
								link_url: href,
								link_text: link.textContent?.trim().slice(0, 80),
								page_title: document.title,
								link_location: link.classList.contains('deal-cta-btn') ? 'cta_box' :
								               link.closest('.sticky-cta') ? 'sticky_cta' : 'body',
							});
						}
					});
				});
				// Sticky CTA dismiss (persisted per session)
				const stickyCta = document.getElementById('sticky-cta');
				const stickyClose = document.getElementById('sticky-cta-close');
				if (stickyCta && stickyClose) {
					if (sessionStorage.getItem('pd-sticky-dismissed')) {
						stickyCta.style.display = 'none';
					}
					stickyClose.addEventListener('click', () => {
						stickyCta.style.display = 'none';
						sessionStorage.setItem('pd-sticky-dismissed', '1');
					});
				}
				// Hero image fallback scoped to .hero-image sections (no inline onerror — CSP safe).
				// /images/default-placeholder.jpg is committed at public/images/default-placeholder.jpg.
				document.querySelectorAll('.hero-image').forEach(section => {
					section.addEventListener('error', (e) => {
						const img = e.target;
						if (!(img instanceof HTMLImageElement)) return;
						const fallback = img.dataset.fallback;
						if (fallback && img.src !== new URL(fallback, location.href).href) {
							img.src = fallback;
						}
					}, true);
				});

				// Article TOC rail + scroll-spy
				(function() {
					var tocList = document.getElementById('rail-toc-list');
					if (!tocList) return;
					var headings = Array.from(document.querySelectorAll<HTMLHeadingElement>('.prose h2'));
					if (headings.length < 2) {
						var railAside = document.querySelector<HTMLElement>('.toc-rail');
						if (railAside) railAside.style.display = 'none';
						return;
					}
					headings.forEach(function(h, i) {
						if (!h.id) h.id = 'toc-h-' + i;
						var li = document.createElement('li');
						li.className = 'rail-toc-item';
						var a = document.createElement('a');
						a.href = '#' + h.id;
						a.textContent = h.textContent || '';
						a.addEventListener('click', function(e) {
							e.preventDefault();
							h.scrollIntoView({ behavior: 'smooth', block: 'start' });
							headings.forEach(function(el) { el.style.scrollMarginTop = '80px'; });
						});
						li.appendChild(a);
						tocList.appendChild(li);
					});

					// Scroll-spy via IntersectionObserver
					var items = Array.from(tocList.querySelectorAll<HTMLLIElement>('.rail-toc-item'));
					var activeIndex = -1;
					function setActive(index: number) {
						if (index === activeIndex) return;
						activeIndex = index;
						items.forEach(function(li) { li.classList.remove('active'); });
						if (index >= 0) items[index].classList.add('active');
					}
					var observer = new IntersectionObserver(function(entries) {
						entries.forEach(function(entry) {
							var idx = headings.indexOf(entry.target as HTMLHeadingElement);
							if (entry.isIntersecting) setActive(idx);
						});
					}, { rootMargin: '-30% 0px -60% 0px' });
					headings.forEach(function(h) { observer.observe(h); });
				})();
			});
		</script>
	</head>

	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header />
		<main id="main-content">
			<article>
				{imageStr && (
					<div class="hero-image">
						<img src={imageStr} alt={title} loading="eager" fetchpriority="high" data-fallback="/images/default-placeholder.jpg" />
					</div>
				)}
				<div class="content-layout">
				<div class="prose">
					<!-- Breadcrumb -->
					<nav class="breadcrumb" aria-label="Breadcrumb">
						<a href="/">Home</a>
						<span class="sep" aria-hidden="true">/</span>
						<a href="/posts">Deals</a>
						<span class="sep" aria-hidden="true">/</span>
						<span>{title.length > 50 ? title.slice(0, 50) + '...' : title}</span>
					</nav>

					<!-- Article Header -->
					<div class="article-header">
						<h1>{title}</h1>
						<div class="meta">
							<span class="author-byline">By <a href="/about/" rel="author">PluginDrop Editorial Team</a></span>
							<span class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span> &middot; Updated <FormattedDate date={updatedDate} /></span>
								)}
							</span>
							<span class="reading-time">{readingTime}</span>
							{linkedTags.length > 0 && (
								<div class="tags">
									{linkedTags.map((tag: string) => {
										const tagSlug = slugifyTag(tag);
										return (
											<a href={`/tags/${tagSlug}/`} class={`tag ${tag === 'free' ? 'free' : tag === 'sale' ? 'sale' : ''}`} style="text-decoration:none">
												{tag}
											</a>
										);
									})}
								</div>
							)}
						</div>
					</div>

					{/* Deal CTA Box — product widget style */}
					{affiliate && (dealPrice || discount || saleExpired) && (
						<div class={`deal-cta-box${saleExpired ? ' sale-expired' : ''}`}>
							{saleExpired ? (
								<>
									<div class="deal-expired-notice">This sale has ended — check current price below</div>
									{dealSource && <div class="deal-source">Available via {dealSource}</div>}
									<a href={affiliate} class="deal-cta-btn is-expired" target="_blank" rel="noopener noreferrer nofollow">
										View Current Price →
									</a>
								</>
							) : (
								<>
									{/* score は内部ランキング用 — UI非表示 */}
									{saleExpiry && (
										<div class="deal-countdown" id="deal-countdown" data-expiry={new Date(saleExpiry).toISOString()}>
											<span class="countdown-label">Deal ends in</span>
											<div class="countdown-time">
												<div class="countdown-unit"><span class="countdown-num" id="cd-d">--</span><span style="font-size:0.65rem">d</span></div>
												<span class="countdown-sep">:</span>
												<div class="countdown-unit"><span class="countdown-num" id="cd-h">--</span><span style="font-size:0.65rem">h</span></div>
												<span class="countdown-sep">:</span>
												<div class="countdown-unit"><span class="countdown-num" id="cd-m">--</span><span style="font-size:0.65rem">m</span></div>
											</div>
										</div>
									)}
									{(dealPrice || _displayDiscount) && (
										<div class="deal-price-row">
											{(bundleValue || originalPrice) && !_isFreePrice && (
												<span class="deal-value-label">Over <span class="deal-price-original">{bundleValue ?? originalPrice}</span> value</span>
											)}
											{!bundleValue && originalPrice && _isFreePrice && <span class="deal-price-original">{originalPrice}</span>}
											{dealPrice && <span class={`deal-price-current${_isFreePrice ? ' is-free' : ''}`}>{_isFreePrice ? 'FREE' : `→ ${dealPrice}`}</span>}
											{_displayDiscount && (
												<span class={`deal-save-badge${_isFreePrice ? ' is-free' : ''}`}>{_displayDiscount}</span>
											)}
											{allTimeLow && <span class="atl-badge">Lowest price we’ve tracked</span>}
										</div>
									)}
									{dealSource && <div class="deal-source">Available via {dealSource}</div>}
									<a href={affiliate} class="deal-cta-btn" target="_blank" rel="noopener noreferrer nofollow">
										{_isFreePrice ? 'Get It Free \u2192' : 'Get This Deal \u2192'}
									</a>
								</>
							)}
						</div>
					)}

					<!-- ON SALE NOW banner for when-does articles -->
					{onSaleNow && (
						<div class="on-sale-banner">
							<strong>It's on sale right now</strong> — Current pricing and deal links are below.
						</div>
					)}

					<!-- Article content (from markdown) -->
					<slot />

					{priceTrack.length > 0 && (
						<PriceTracker pluginNames={priceTrack} />
					)}

					{bestGuides.length > 0 && (
						<div class="best-guide-box">
							<div class="best-guide-label">See our buying guides</div>
							<div class="best-guide-links">
								{bestGuides.map((g: { label: string; slug: string }) => (
									<a href={`/posts/${g.slug}/`} class="best-guide-link">{g.label} →</a>
								))}
							</div>
						</div>
					)}

					{isEvergreen && featuredDeals.length > 0 && (
						<div class="pb-deals-box">
							<div class="pb-deals-header">This week's top deals on Plugin Boutique</div>
							<ul class="pb-deals-list">
								{featuredDeals.map(deal => (
									<li class="pb-deal-item">
										<a href={`${deal.data.affiliate}&utm_source=plugindrop&utm_medium=deals-box`} target="_blank" rel="noopener noreferrer nofollow" class="pb-deal-link">
											<span class="pb-deal-title">{deal.data.title}</span>
											{deal.data.dealPrice && <span class="pb-deal-price">{deal.data.dealPrice}</span>}
										</a>
									</li>
								))}
							</ul>
							<a href="https://www.pluginboutique.com/deals?a_aid=69cb95abe1763&utm_source=plugindrop&utm_medium=deals-box&utm_campaign=see-all" class="pb-deals-more" target="_blank" rel="noopener noreferrer nofollow">See all current deals →</a>
						</div>
					)}

					{isEvergreen && <NewsletterForm />}

					{affiliate && (
						<div class="affiliate-disclosure">
							<p>This post contains affiliate links. We may earn a small commission at no extra cost to you.</p>
						</div>
					)}
				</div>
				<div class="toc-rail-wrap">
					<aside class="toc-rail" aria-label="Article outline">
						<p class="toc-heading">In this guide</p>
						<nav>
							<ol id="rail-toc-list"></ol>
						</nav>
					</aside>
					<TopDeals />
				</div>
				</div>
			</article>

			{relatedPosts.length > 0 && (
				<section class="related-posts" aria-label="Related deals">
					<h2 class="related-title">Related Deals</h2>
					<ul class="related-list">
						{relatedPosts.map(p => (
							<li class="related-item">
								<a href={`/posts/${p.id.replace(/\.mdx?$/, '')}/`} class="related-link">
									{p.data.heroImage && <img src={p.data.heroImage} alt={p.data.title} loading="lazy" width="120" height="68" class="related-thumb" />}
									<span class="related-info">
										<span class="related-item-title">{p.data.title}</span>
										{p.data.dealPrice && <span class="related-price">{p.data.dealPrice}</span>}
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</main>

		{/* Sticky CTA bar */}
		{affiliate ? (
			<div class="sticky-cta" id="sticky-cta">
				<span class="sticky-title">{saleExpired ? title : (dealPrice ? `${_isFreePrice ? 'FREE' : dealPrice} — ${title}` : title)}</span>
				<a href={affiliate} class="deal-cta-btn sticky-cta-link" target="_blank" rel="noopener noreferrer nofollow">
					{saleExpired ? 'View Price' : (_isFreePrice ? 'Get Free' : 'Get Deal')}
				</a>
				<button class="sticky-cta-close" id="sticky-cta-close" aria-label="Dismiss">✕</button>
			</div>
		) : (
			<div class="sticky-cta sticky-cta-guide" id="sticky-cta">
				<span class="sticky-title">Today's plugin deals — up to 90% off</span>
				<a href="https://www.pluginboutique.com/deals?a_aid=69cb95abe1763&utm_source=plugindrop&utm_medium=sticky&utm_campaign=guide-cta" class="deal-cta-btn sticky-cta-link" target="_blank" rel="noopener noreferrer nofollow">
					Browse Deals →
				</a>
				<button class="sticky-cta-close" id="sticky-cta-close" aria-label="Dismiss">✕</button>
			</div>
		)}

		<Footer />
	</body>
</html>
