---
import type { CollectionEntry } from 'astro:content';
import { pdAttr } from '../lib/interestTaxonomy.mjs';
import { isTagPageIndexable, slugifyTag } from '../lib/indexPolicy.mjs';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PriceTracker from '../components/PriceTracker.astro';
import TopDeals from '../components/TopDeals.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { readingTime?: string; rawBody?: string; slug?: string };

const { title, description, pubDate, updatedDate, heroImage, tags = [], affiliate, dealPrice, originalPrice, discount, saleExpiry, score, allTimeLow, evergreen, onSaleNow, bundleValue, noindex, priceTrack = [], readingTime = '3 min read', rawBody = '', slug: currentSlug = '' } = Astro.props;
const imageStr = typeof heroImage === 'string' ? heroImage : undefined;

// Check if sale has expired
const saleExpired = saleExpiry ? new Date(saleExpiry + 'T23:59:59Z') < new Date() : false;

// Derive store name from affiliate URL — netloc-based for accuracy
function getDealSource(url: string): string {
	if (!url) return '';
	try {
		const netloc = new URL(url).hostname.replace('www.', '');
		const MAP: Record<string, string> = {
			'pluginboutique.com': 'Plugin Boutique',
			'kvraudio.com': 'KVR Audio',
			'adsrsounds.com': 'ADSR Sounds',
			'loopmasters.com': 'Loopmasters',
			'splice.com': 'Splice',
			'sweetwater.com': 'Sweetwater',
			'thomann.de': 'Thomann',
			'waves.com': 'Waves',
			'native-instruments.com': 'Native Instruments',
			'arturia.com': 'Arturia',
			'izotope.com': 'iZotope',
			'plugin-alliance.com': 'Plugin Alliance',
		};
		return MAP[netloc] ?? netloc;
	} catch { return ''; }
}
const dealSource = affiliate ? getDealSource(affiliate) : '';

// Brand is only derivable when the affiliate URL is the manufacturer's own site
const BRAND_DOMAINS: Record<string, string> = {
	'waves.com': 'Waves',
	'native-instruments.com': 'Native Instruments',
	'arturia.com': 'Arturia',
	'izotope.com': 'iZotope',
	'fabfilter.com': 'FabFilter',
	'soundtoys.com': 'Soundtoys',
	'uaudio.com': 'Universal Audio',
	'klevgrand.se': 'Klevgrand',
	'audiothing.net': 'AudioThing',
	'valhalladsp.com': 'Valhalla DSP',
	'ikmultimedia.com': 'IK Multimedia',
	'toontrack.com': 'Toontrack',
	'spectrasonics.net': 'Spectrasonics',
};
function getBrand(url: string): string | null {
	if (!url) return null;
	try {
		const netloc = new URL(url).hostname.replace('www.', '').toLowerCase();
		return BRAND_DOMAINS[netloc] ?? null;
	} catch { return null; }
}
const dealBrand = affiliate ? getBrand(affiliate) : null;

const resolvedImage = imageStr ? new URL(imageStr, Astro.site).href : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Build JSON-LD structured data
const articleLD = {
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": title,
	"description": description,
	"datePublished": pubDate.toISOString(),
	...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
	...(resolvedImage ? { "image": resolvedImage } : {}),
	"url": pageUrl,
	"author": {
		"@type": "Person",
		"name": "PluginDrop Editorial Team",
		"url": "https://plugindrop.net/about/",
		"worksFor": { "@type": "Organization", "name": "SignalDrop", "url": "https://plugindrop.net" },
	},
	"publisher": {
		"@type": "Organization",
		"name": "PluginDrop",
		"url": "https://plugindrop.net",
		"logo": { "@type": "ImageObject", "url": "https://plugindrop.net/images/logo-512.png" },
		"sameAs": ["https://plugindrop.net/about/"],
	},
};

// BreadcrumbList schema
const breadcrumbLD = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).href },
		{ "@type": "ListItem", "position": 2, "name": "Deals", "item": new URL("/posts", Astro.site).href },
		{ "@type": "ListItem", "position": 3, "name": title },
	],
};

// Extract FAQ pairs from raw markdown for FAQPage schema
const faqPairs: { q: string; a: string }[] = [];
const faqRegex = /\*\*Q:\s*(.+?)\*\*\s*\nA:\s*(.+?)(?=\n\s*\*\*Q:|\n\s*##|\s*$)/gs;
let faqMatch;
while ((faqMatch = faqRegex.exec(rawBody)) !== null) {
	faqPairs.push({ q: faqMatch[1].trim(), a: faqMatch[2].trim() });
}
// Strip markdown syntax from FAQ answers for valid Google rich-result JSON-LD
function stripMarkdown(s: string): string {
	return s
		.replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
		.replace(/\*\*([^*]+)\*\*/g, '$1')
		.replace(/\*([^*]+)\*/g, '$1')
		.replace(/`([^`]+)`/g, '$1')
		.trim();
}
const faqLD = faqPairs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqPairs.map(f => ({
		"@type": "Question",
		"name": stripMarkdown(f.q),
		"acceptedAnswer": { "@type": "Answer", "text": stripMarkdown(f.a) },
	})),
} : null;

// HowTo schema for tutorial articles (title starts with "How to" or has "tutorials" tag)
// Gives Google rich "How To" results with numbered steps in SERP
const isHowTo = title.toLowerCase().startsWith('how to') || tags.includes('tutorials');
const howToSteps: { name: string; text: string }[] = [];
if (isHowTo && rawBody) {
	// Pass 1: explicit "Step N:" headings
	const stepRegex = /^## (Step \d+[:\s—–-].+?)$([\s\S]*?)(?=^## |\s*$)/gm;
	let stepMatch;
	while ((stepMatch = stepRegex.exec(rawBody)) !== null) {
		const stepName = stripMarkdown(stepMatch[1].trim());
		const stepText = stripMarkdown(stepMatch[2].replace(/#{1,6}\s+/g, '').replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1').replace(/[*`]/g, '').trim().slice(0, 500));
		if (stepName && stepText) howToSteps.push({ name: stepName, text: stepText });
	}
	// Pass 2: fallback — any non-boilerplate H2 (for articles without "Step N:" headings)
	if (howToSteps.length < 2) {
		const SKIP_H2 = new Set(['quick picks at a glance','introduction','faq','related guides','final thoughts','worth upgrading to (paid options)','full comparison table','related','conclusion','summary','verdict','how to choose']);
		const genericH2Regex = /^## (.+?)$([\s\S]*?)(?=^## |\s*$)/gm;
		let h2m;
		while ((h2m = genericH2Regex.exec(rawBody)) !== null) {
			const h2Name = h2m[1].trim();
			if (SKIP_H2.has(h2Name.toLowerCase())) continue;
			const stepText = stripMarkdown(h2m[2].replace(/#{1,6}\s+/g, '').replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1').replace(/[*`]/g, '').replace(/<[^>]+>/g, '').trim().slice(0, 300));
			if (h2Name && stepText) howToSteps.push({ name: h2Name, text: stepText });
		}
	}
}
const howToLD = (isHowTo && howToSteps.length >= 2) ? {
	"@context": "https://schema.org",
	"@type": "HowTo",
	"name": title,
	"description": description,
	...(resolvedImage ? { "image": resolvedImage } : {}),
	"step": howToSteps.map((s, i) => ({
		"@type": "HowToStep",
		"position": i + 1,
		"name": s.name,
		"text": s.text,
	})),
} : null;

// Product + Offer schema for deal pages (enables price rich results)
// FREE または価格が取得できない場合は Product schema を省略（price=0 は誤シグナル）
const _rawPrice = dealPrice?.trim().toUpperCase().replace(/[$€£¥]/g, '') ?? '';
const _isFreePrice = _rawPrice === 'FREE' || parseFloat(_rawPrice) === 0;
const _numericPrice = dealPrice ? dealPrice.replace(/[^0-9.]/g, '') : '';
// Compute discount badge from prices when not explicitly set in frontmatter
const _computedDiscount = (() => {
	if (discount) return discount;
	if (!originalPrice || !dealPrice || _isFreePrice) return null;
	const orig = parseFloat(originalPrice.replace(/[^0-9.]/g, ''));
	const deal = parseFloat(_numericPrice);
	if (!orig || !deal || orig <= deal) return null;
	return `${Math.round((1 - deal / orig) * 100)}% OFF`;
})();
const _displayDiscount = _computedDiscount;
const productLD = (affiliate && dealPrice && !saleExpired && !_isFreePrice && _numericPrice && _numericPrice !== '0') ? {
	"@context": "https://schema.org",
	"@type": "Product",
	"name": title,
	"description": description,
	...(dealBrand ? { "brand": { "@type": "Brand", "name": dealBrand } } : {}),
	...(resolvedImage ? { "image": resolvedImage } : {}),
	...(false ? {  // score は内部ランキング用のためAggregateRatingには使わない
		"aggregateRating": {
			"@type": "AggregateRating",
			"ratingValue": String(score),
			"bestRating": "10",
			"worstRating": "1",
			"ratingCount": "1",
		},
	} : {}),
	"offers": {
		"@type": "Offer",
		"url": affiliate,
		"priceCurrency": "USD",
		"price": _numericPrice,
		"availability": "https://schema.org/InStock",
		"seller": { "@type": "Organization", "name": dealSource || "PluginDrop" },
		...(saleExpiry ? { "priceValidUntil": new Date(saleExpiry).toISOString().split('T')[0] } : {}),
	},
} : null;

// Review schema — editorial rating for review articles (shows stars in SERP)
const isReview = tags.includes('review') && score > 0;
const reviewItemName = isReview
	? title.replace(/ Review\b.*$/i, '').replace(/:.*/,'').trim()
	: '';
const reviewLD = isReview ? {
	"@context": "https://schema.org",
	"@type": "Review",
	"itemReviewed": {
		"@type": "SoftwareApplication",
		"name": reviewItemName,
		"applicationCategory": "MultimediaApplication",
		"operatingSystem": "Windows, macOS",
	},
	"reviewRating": {
		"@type": "Rating",
		"ratingValue": String((score / 2).toFixed(1)),
		"bestRating": "5",
		"worstRating": "1",
	},
	"author": {
		"@type": "Organization",
		"name": "PluginDrop",
		"url": "https://plugindrop.net",
	},
	"publisher": {
		"@type": "Organization",
		"name": "PluginDrop",
		"url": "https://plugindrop.net",
	},
	...(resolvedImage ? { "image": String(resolvedImage) } : {}),
	"name": title,
	"description": description,
} : null;

// VideoObject schema — extract first YouTube embed for video search results
const _videoMatch = rawBody ? rawBody.match(/youtube(?:-nocookie)?\.com\/embed\/([A-Za-z0-9_-]{11})/) : null;
const _videoId = _videoMatch ? _videoMatch[1] : null;
const videoLD = _videoId ? {
	"@context": "https://schema.org",
	"@type": "VideoObject",
	"name": title,
	"description": description,
	"thumbnailUrl": `https://img.youtube.com/vi/${_videoId}/maxresdefault.jpg`,
	"uploadDate": pubDate.toISOString(),
	"contentUrl": `https://www.youtube.com/watch?v=${_videoId}`,
	"embedUrl": `https://www.youtube-nocookie.com/embed/${_videoId}`,
	"publisher": {
		"@type": "Organization",
		"name": "PluginDrop",
		"logo": { "@type": "ImageObject", "url": "https://plugindrop.net/favicon.png" },
	},
} : null;

// Speakable schema — marks headline + intro for AI/voice search extraction
const pageURL = new URL(Astro.url.pathname, Astro.site);
const speakableLD = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"@id": String(pageURL),
	"speakable": {
		"@type": "SpeakableSpecification",
		"cssSelector": [".article-header h1", ".prose > p:first-child"],
	},
	"url": String(pageURL),
};

// Internal link: tag → Best guide mapping
const BEST_GUIDE_MAP: Record<string, { label: string; slug: string }> = {
	'eq':           { label: 'Best EQ Plugins 2026',            slug: 'best-eq-plugins-2026' },
	'compressor':   { label: 'Best Compressor Plugins 2026',    slug: 'best-compressor-plugins-2026' },
	'reverb':       { label: 'Best Free Reverb Plugins 2026',   slug: 'best-free-reverb-vst-plugins' },
	'synth':        { label: 'Best Synth Plugins 2026',         slug: 'best-synth-plugins-2026' },
	'mixing':       { label: 'Best Mixing Plugins 2026',        slug: 'best-mixing-plugins-2026' },
	'mastering':    { label: 'Best Mastering Plugins 2026',     slug: 'best-mastering-plugins-2026' },
	'hip-hop':      { label: 'Best Hip-Hop Sample Packs',       slug: 'best-sample-packs-hip-hop-2026' },
	'drums':        { label: 'Best Drum Plugins 2026',          slug: 'best-drum-plugins-2026' },
	'tutorials':    { label: 'How-To Mixing Guides',            slug: 'how-to-sidechain-compression' },
	'techno':       { label: 'Best Plugins for Techno',         slug: 'best-plugins-for-techno-production' },
	'house':        { label: 'Best Plugins for House Music',    slug: 'best-plugins-for-house-music' },
	'metal':        { label: 'Best Plugins for Metal Mixing',   slug: 'best-vst-plugins-for-metal-mixing' },
	'film-scoring': { label: 'Best Plugins for Film Scoring',   slug: 'best-plugins-for-film-scoring' },
	'lo-fi':        { label: 'Best Plugins for Lo-Fi',          slug: 'best-plugins-for-lofi-production' },
};
const bestGuides = tags
	.map((t: string) => BEST_GUIDE_MAP[t])
	.filter(Boolean)
	.filter((g, i, arr) => arr.findIndex(x => x.slug === g.slug) === i)
	.slice(0, 3);

// Related posts: same tags, exclude current slug
const allPosts = await getCollection('blog');
const publicTagCounts = new Map<string, number>();
for (const post of allPosts) {
	if (post.data.draft) continue;
	for (const tag of (post.data.tags ?? [])) {
		const tagSlug = slugifyTag(tag);
		publicTagCounts.set(tagSlug, (publicTagCounts.get(tagSlug) ?? 0) + 1);
	}
}
const linkedTags = tags.filter((tag: string) => isTagPageIndexable(publicTagCounts.get(slugifyTag(tag)) ?? 0));
const relatedPosts = allPosts
	.filter(p => !p.data.draft && p.id !== currentSlug && p.id.replace(/\.mdx?$/, '') !== currentSlug)
	.map(p => ({ ...p, score: p.data.tags?.filter((t: string) => tags.includes(t)).length ?? 0 }))
	.filter(p => p.score > 0)
	.sort((a, b) => b.score - a.score || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

// Featured PB deals box — shown on evergreen guide pages (no affiliate link)
const isEvergreen = !!evergreen && !affiliate;
const featuredDeals = isEvergreen ? allPosts
	.filter(p => !p.data.draft &&
		p.data.affiliate?.includes('pluginboutique.com') &&
		p.data.dealPrice &&
		(!p.data.saleExpiry || new Date(p.data.saleExpiry + 'T23:59:59Z') > new Date()))
	.sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0))
	.slice(0, 4) : [];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title.length > 50 ? title : `${title} | ${SITE_TITLE}`} description={description} image={imageStr} ogType="article" articleSection={tags[0] ?? 'Music Production'} noindex={!!noindex} />
		{pdAttr({ title, tags }) && <meta name="pd-interests" content={pdAttr({ title, tags })} />}
		<script type="application/ld+json" set:html={JSON.stringify(articleLD)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />
		{faqLD && <script type="application/ld+json" set:html={JSON.stringify(faqLD)} />}
		{howToLD && <script type="application/ld+json" set:html={JSON.stringify(howToLD)} />}
		{productLD && <script type="application/ld+json" set:html={JSON.stringify(productLD)} />}
		{reviewLD && <script type="application/ld+json" set:html={JSON.stringify(reviewLD)} />}
		{videoLD && <script type="application/ld+json" set:html={JSON.stringify(videoLD)} />}
		<script type="application/ld+json" set:html={JSON.stringify(speakableLD)} />
		<style>
			main {
				width: calc(100% - 2rem);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 1.5rem 1rem 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 400px;
				object-fit: cover;
				border-radius: var(--radius);
				border: 1px solid var(--border);
			}
			/* Two-column layout: article prose + sticky "best deals" rail.
			   Falls back gracefully to a single centered column when TopDeals
			   renders nothing (no products currently on sale). */
			.content-layout {
				display: flex;
				align-items: flex-start;
				gap: 2rem;
				max-width: 1040px;
				margin: 0 auto;
			}
			.prose {
				width: 70ch;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 1rem 1rem 3rem;
				color: var(--text-secondary);
				line-height: 1.7;
				flex: 1 1 70ch;
				min-width: 0;
			}
			.prose :global(h2) {
				margin-top: 2.5rem;
			}
			.content-layout :global(.deals-rail) {
				flex: 0 0 260px;
				width: 260px;
				position: sticky;
				top: calc(56px + 1.25rem);
				margin-top: 1rem;
			}
			@media (max-width: 980px) {
				.content-layout {
					flex-direction: column;
				}
				.content-layout :global(.deals-rail) {
					position: static;
					width: 100%;
					flex-basis: auto;
					margin: 0 auto;
					max-width: calc(720px + 2rem);
					padding: 0 1rem;
				}
			}
			/* Article TOC rail */
			.toc-rail-wrap {
				flex: 0 0 260px;
				width: 260px;
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
				align-self: flex-start;
			}
			@media (max-width: 980px) {
				.toc-rail-wrap {
					display: none;
				}
			}
			.toc-rail {
				position: sticky;
				top: calc(56px + 1.25rem);
				max-height: calc(100vh - 96px);
				overflow-y: auto;
			}
			.toc-heading {
				font-size: 0.68rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--text-muted);
				margin: 0 0 0.6rem;
			}
			#rail-toc-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 2px;
			}
			:global(.rail-toc-item a) {
				display: block;
				font-size: 0.82rem;
				color: var(--text-muted);
				text-decoration: none;
				padding: 0.3rem 0.5rem;
				border-radius: 4px;
				border-left: 2px solid transparent;
				line-height: 1.35;
				transition: color 0.12s, border-color 0.12s;
			}
			:global(.rail-toc-item a:hover) { color: var(--text-secondary); }
			:global(.rail-toc-item.active a) {
				color: var(--text-primary);
				border-left-color: var(--accent);
				background: rgba(148, 211, 196, 0.06);
			}
			.article-header {
				margin-bottom: 1.5rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid var(--border);
			}
			.article-header h1 {
				margin: 0 0 0.75rem 0;
				font-family: var(--font-display);
				font-size: 2rem;
				font-weight: 500;
				line-height: 1.2;
			}
			.meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
			}
			.author-byline {
				font-size: 0.85rem;
				color: var(--text-muted);
			}
			.author-byline a {
				color: var(--accent);
				text-decoration: none;
				font-weight: 500;
			}
			.author-byline a:hover { text-decoration: underline; }
			.date {
				color: var(--text-muted);
				font-size: 0.85rem;
			}
			.reading-time {
				color: var(--text-muted);
				font-size: 0.8rem;
			}
			.tags {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}
			/* Hide the first H1 inside article content (already shown in header) */
			.prose > h1:first-of-type,
			.prose :global(h1:first-of-type) {
				display: none;
			}
			.deal-cta-box.sale-expired {
				border-color: var(--border);
				background: var(--bg-card);
				opacity: 0.85;
			}
			.deal-expired-notice {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin-bottom: 0.75rem;
				padding: 0.5rem 0.75rem;
				background: rgba(255, 180, 0, 0.08);
				border-radius: 4px;
				border: 1px solid rgba(255, 180, 0, 0.2);
			}
			.deal-cta-btn.is-expired {
				background: var(--bg-hover);
				color: var(--text-secondary);
				border: 1px solid var(--border);
			}
			.deal-cta-btn.is-expired:hover {
				background: var(--accent-muted);
				color: var(--text-primary);
			}
			.affiliate-disclosure {
				margin-top: 2.5rem;
				padding: 0.75rem 0;
				border-top: 1px solid var(--border);
			}
			.affiliate-disclosure p {
				font-size: 0.78rem;
				color: var(--text-muted);
				margin: 0;
			}
			.related-posts {
				max-width: 720px;
				margin: 2rem auto 0;
				padding: 1.5rem 1rem;
				border-top: 2px solid var(--border);
			}
			.related-title {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin: 0 0 1rem;
			}
			.related-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
			.related-link {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				text-decoration: none;
				color: inherit;
				padding: 0.5rem 0;
