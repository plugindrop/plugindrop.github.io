---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { readingTime?: string; rawBody?: string };

const { title, description, pubDate, updatedDate, heroImage, tags = [], affiliate, dealPrice, originalPrice, discount, saleExpiry, readingTime = '3 min read', rawBody = '' } = Astro.props;
const imageStr = typeof heroImage === 'string' ? heroImage : undefined;

// Check if sale has expired
const saleExpired = saleExpiry ? new Date(saleExpiry) < new Date() : false;

// Derive store name from affiliate URL for display in deal CTA box
function getDealSource(url: string): string {
	if (!url) return '';
	if (url.includes('pluginboutique.com')) return 'Plugin Boutique';
	if (url.includes('kvraudio.com')) return 'KVR Audio';
	if (url.includes('adsrsounds.com')) return 'ADSR Sounds';
	if (url.includes('loopmasters.com')) return 'Loopmasters';
	if (url.includes('splice.com')) return 'Splice';
	if (url.includes('sweetwater.com')) return 'Sweetwater';
	if (url.includes('thomann.de')) return 'Thomann';
	if (url.includes('waves.com')) return 'Waves';
	try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}
const dealSource = affiliate ? getDealSource(affiliate) : '';
const resolvedImage = imageStr ? new URL(imageStr, Astro.site).href : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Build JSON-LD structured data
const articleLD = {
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": title,
	"description": description,
	"datePublished": pubDate.toISOString(),
	...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
	...(resolvedImage ? { "image": resolvedImage } : {}),
	"url": pageUrl,
	"author": { "@type": "Organization", "name": "PluginDrop", "url": "https://plugindrop.net" },
	"publisher": {
		"@type": "Organization",
		"name": "PluginDrop",
		"url": "https://plugindrop.net",
		"logo": { "@type": "ImageObject", "url": "https://plugindrop.net/images/logo-512.png" },
	},
};

// BreadcrumbList schema
const breadcrumbLD = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).href },
		{ "@type": "ListItem", "position": 2, "name": "Deals", "item": new URL("/posts", Astro.site).href },
		{ "@type": "ListItem", "position": 3, "name": title },
	],
};

// Extract FAQ pairs from raw markdown for FAQPage schema
const faqPairs: { q: string; a: string }[] = [];
const faqRegex = /\*\*Q:\s*(.+?)\*\*\s*\nA:\s*(.+?)(?=\n\s*\*\*Q:|\n\s*##|\s*$)/gs;
let faqMatch;
while ((faqMatch = faqRegex.exec(rawBody)) !== null) {
	faqPairs.push({ q: faqMatch[1].trim(), a: faqMatch[2].trim() });
}
const faqLD = faqPairs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqPairs.map(f => ({
		"@type": "Question",
		"name": f.q,
		"acceptedAnswer": { "@type": "Answer", "text": f.a },
	})),
} : null;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={imageStr} ogType="article" />
		<script type="application/ld+json" set:html={JSON.stringify(articleLD)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />
		{faqLD && <script type="application/ld+json" set:html={JSON.stringify(faqLD)} />}
		<style>
			main {
				width: calc(100% - 2rem);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 1.5rem 1rem 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 400px;
				object-fit: cover;
				border-radius: var(--radius);
				border: 1px solid var(--border);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 1rem 1rem 3rem;
				color: var(--text-secondary);
			}
			.article-header {
				margin-bottom: 1.5rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid var(--border);
			}
			.article-header h1 {
				margin: 0 0 0.75rem 0;
				font-family: var(--font-display);
				font-size: 2rem;
				font-weight: 500;
				line-height: 1.2;
			}
			.meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
			}
			.date {
				color: var(--text-muted);
				font-size: 0.85rem;
			}
			.reading-time {
				color: var(--text-muted);
				font-size: 0.8rem;
			}
			.tags {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}
			/* Hide the first H1 inside article content (already shown in header) */
			.prose > h1:first-of-type,
			.prose :global(h1:first-of-type) {
				display: none;
			}
			.deal-cta-box.sale-expired {
				border-color: var(--border);
				background: var(--bg-card);
				opacity: 0.85;
			}
			.deal-expired-notice {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin-bottom: 0.75rem;
				padding: 0.5rem 0.75rem;
				background: rgba(255, 180, 0, 0.08);
				border-radius: 4px;
				border: 1px solid rgba(255, 180, 0, 0.2);
			}
			.deal-cta-btn.is-expired {
				background: var(--bg-hover);
				color: var(--text-secondary);
				border: 1px solid var(--border);
			}
			.deal-cta-btn.is-expired:hover {
				background: var(--accent-muted);
				color: var(--text-primary);
			}
			.affiliate-disclosure {
				margin-top: 2.5rem;
				padding: 0.75rem 0;
				border-top: 1px solid var(--border);
			}
			.affiliate-disclosure p {
				font-size: 0.78rem;
				color: var(--text-muted);
				margin: 0;
			}
			/* Direct responsive sizing for all iframes in article body */
			.prose iframe {
				width: 100%;
				aspect-ratio: 16 / 9;
				border: 0;
				border-radius: var(--radius);
				display: block;
				margin: 1.5rem 0;
			}
			.video-embed {
				position: relative;
				width: 100%;
				padding-bottom: 56.25%; /* 16:9 fallback for browsers without aspect-ratio */
				height: 0;
				overflow: hidden;
				border-radius: var(--radius);
				margin: 1.5rem 0;
			}
			.video-embed iframe {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				border: 0;
				margin: 0;
				aspect-ratio: unset;
			}
			@media (max-width: 720px) {
				.article-header h1 { font-size: 1.5rem; }
				.hero-image { padding: 1rem 0.5rem 0; }
			}
		</style>
		<!-- Wrap tables in scrollable container -->
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				document.querySelectorAll('.prose table').forEach(table => {
					if (!table.parentElement?.classList.contains('table-wrap')) {
						const wrap = document.createElement('div');
						wrap.className = 'table-wrap';
						table.parentElement?.insertBefore(wrap, table);
						wrap.appendChild(table);
					}
				});
				// Hide [INTERNAL: ...] placeholders
				document.querySelectorAll('.prose p').forEach(p => {
					if (p.textContent?.trim().startsWith('[INTERNAL:')) {
						p.style.display = 'none';
					}
				});
				// Open external links in new tab
				document.querySelectorAll('.prose a[href^="http"]').forEach(link => {
					link.setAttribute('target', '_blank');
					link.setAttribute('rel', 'noopener noreferrer');
				});
				// Wrap YouTube iframes in .video-embed for responsive 16:9 sizing
				document.querySelectorAll('.prose iframe[src*="youtube"]').forEach(iframe => {
					if (!iframe.parentElement?.classList.contains('video-embed')) {
						const wrap = document.createElement('div');
						wrap.className = 'video-embed';
						iframe.parentElement?.insertBefore(wrap, iframe);
						wrap.appendChild(iframe);
					}
				});
				// Track affiliate link clicks in GA4
				document.querySelectorAll('.deal-cta-btn, .sticky-cta a').forEach(link => {
					link.addEventListener('click', () => {
						if (typeof gtag !== 'undefined') {
							gtag('event', 'affiliate_click', {
								link_url: link.getAttribute('href'),
								link_text: link.textContent?.trim(),
								page_title: document.title,
							});
						}
					});
				});
				// Hero image fallback scoped to .hero-image sections (no inline onerror — CSP safe).
				// /images/default-placeholder.jpg is committed at public/images/default-placeholder.jpg.
				document.querySelectorAll('.hero-image').forEach(section => {
					section.addEventListener('error', (e) => {
						const img = e.target;
						if (!(img instanceof HTMLImageElement)) return;
						const fallback = img.dataset.fallback;
						if (fallback && img.src !== new URL(fallback, location.href).href) {
							img.src = fallback;
						}
					}, true);
				});
			});
		</script>
	</head>

	<body>
		<a href="#main-content" class="sr-only" style="position:absolute;top:0;left:0;z-index:999;padding:1rem;background:var(--bg-base);color:var(--accent-light);">Skip to content</a>
		<Header />
		<main id="main-content">
			<article>
				{imageStr && (
					<div class="hero-image">
						<img src={imageStr} alt={title} loading="eager" fetchpriority="high" data-fallback="/images/default-placeholder.jpg" />
					</div>
				)}
				<div class="prose">
					<!-- Breadcrumb -->
					<nav class="breadcrumb" aria-label="Breadcrumb">
						<a href="/">Home</a>
						<span class="sep" aria-hidden="true">/</span>
						<a href="/posts">Deals</a>
						<span class="sep" aria-hidden="true">/</span>
						<span>{title.length > 50 ? title.slice(0, 50) + '...' : title}</span>
					</nav>

					<!-- Article Header -->
					<div class="article-header">
						<h1>{title}</h1>
						<div class="meta">
							<span class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span> &middot; Updated <FormattedDate date={updatedDate} /></span>
								)}
							</span>
							<span class="reading-time">{readingTime}</span>
							{tags.length > 0 && (
								<div class="tags">
									{tags.map((tag: string) => (
										<span class={`tag ${tag === 'free' ? 'free' : tag === 'sale' ? 'sale' : ''}`}>
											{tag}
										</span>
									))}
								</div>
							)}
						</div>
					</div>

					{/* Deal CTA Box — product widget style */}
					{affiliate && (dealPrice || saleExpired) && (
						<div class={`deal-cta-box${saleExpired ? ' sale-expired' : ''}`}>
							{saleExpired ? (
								<>
									<div class="deal-expired-notice">⚠️ This sale has ended — check current price below</div>
									{dealSource && <div class="deal-source">Available via {dealSource}</div>}
									<a href={affiliate} class="deal-cta-btn is-expired" target="_blank" rel="noopener noreferrer nofollow">
										View Current Price →
									</a>
								</>
							) : (
								<>
									<div class="deal-price-row">
										{originalPrice && <span class="deal-price-original">{originalPrice}</span>}
										<span class={`deal-price-current${dealPrice === 'FREE' ? ' is-free' : ''}`}>{dealPrice}</span>
										{discount && (
											<span class={`deal-save-badge${dealPrice === 'FREE' ? ' is-free' : ''}`}>{discount}</span>
										)}
									</div>
									{dealSource && <div class="deal-source">Available via {dealSource}</div>}
									<a href={affiliate} class="deal-cta-btn" target="_blank" rel="noopener noreferrer nofollow">
										{dealPrice === 'FREE' ? 'Get It Free \u2192' : 'Get This Deal \u2192'}
									</a>
								</>
							)}
						</div>
					)}

					<!-- Article content (from markdown) -->
					<slot />

					<div class="affiliate-disclosure">
						<p>This post contains affiliate links. We may earn a small commission at no extra cost to you.</p>
					</div>
				</div>
			</article>
		</main>

		{/* Sticky CTA bar — mobile only, only for articles with affiliate links */}
		{affiliate && (
			<div class="sticky-cta">
				<span class="sticky-title">{saleExpired ? title : (dealPrice ? `${dealPrice} — ${title}` : title)}</span>
				<a href={affiliate} class="deal-cta-btn" target="_blank" rel="noopener noreferrer nofollow">
					{saleExpired ? 'View Price' : (dealPrice === 'FREE' ? 'Get Free' : 'Get Deal')}
				</a>
			</div>
		)}

		<Footer />
	</body>
</html>
