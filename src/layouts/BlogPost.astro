---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { readingTime?: string; rawBody?: string; slug?: string };

const { title, description, pubDate, updatedDate, heroImage, tags = [], affiliate, dealPrice, originalPrice, discount, saleExpiry, score, allTimeLow, readingTime = '3 min read', rawBody = '', slug: currentSlug = '' } = Astro.props;
const imageStr = typeof heroImage === 'string' ? heroImage : undefined;

// Check if sale has expired
const saleExpired = saleExpiry ? new Date(saleExpiry + 'T23:59:59Z') < new Date() : false;

// Derive store name from affiliate URL — netloc-based for accuracy
function getDealSource(url: string): string {
	if (!url) return '';
	try {
		const netloc = new URL(url).hostname.replace('www.', '');
		const MAP: Record<string, string> = {
			'pluginboutique.com': 'Plugin Boutique',
			'kvraudio.com': 'KVR Audio',
			'adsrsounds.com': 'ADSR Sounds',
			'loopmasters.com': 'Loopmasters',
			'splice.com': 'Splice',
			'sweetwater.com': 'Sweetwater',
			'thomann.de': 'Thomann',
			'waves.com': 'Waves',
			'native-instruments.com': 'Native Instruments',
			'arturia.com': 'Arturia',
			'izotope.com': 'iZotope',
			'plugin-alliance.com': 'Plugin Alliance',
		};
		return MAP[netloc] ?? netloc;
	} catch { return ''; }
}
const dealSource = affiliate ? getDealSource(affiliate) : '';

// Brand is only derivable when the affiliate URL is the manufacturer's own site
const BRAND_DOMAINS: Record<string, string> = {
	'waves.com': 'Waves',
	'native-instruments.com': 'Native Instruments',
	'arturia.com': 'Arturia',
	'izotope.com': 'iZotope',
	'fabfilter.com': 'FabFilter',
	'soundtoys.com': 'Soundtoys',
	'uaudio.com': 'Universal Audio',
	'klevgrand.se': 'Klevgrand',
	'audiothing.net': 'AudioThing',
	'valhalladsp.com': 'Valhalla DSP',
	'ikmultimedia.com': 'IK Multimedia',
	'toontrack.com': 'Toontrack',
	'spectrasonics.net': 'Spectrasonics',
};
function getBrand(url: string): string | null {
	if (!url) return null;
	try {
		const netloc = new URL(url).hostname.replace('www.', '').toLowerCase();
		return BRAND_DOMAINS[netloc] ?? null;
	} catch { return null; }
}
const dealBrand = affiliate ? getBrand(affiliate) : null;

const resolvedImage = imageStr ? new URL(imageStr, Astro.site).href : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Build JSON-LD structured data
const articleLD = {
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": title,
	"description": description,
	"datePublished": pubDate.toISOString(),
	...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
	...(resolvedImage ? { "image": resolvedImage } : {}),
	"url": pageUrl,
	"author": { "@type": "Organization", "name": "PluginDrop", "url": "https://plugindrop.net" },
	"publisher": {
		"@type": "Organization",
		"name": "PluginDrop",
		"url": "https://plugindrop.net",
		"logo": { "@type": "ImageObject", "url": "https://plugindrop.net/images/logo-512.png" },
	},
};

// BreadcrumbList schema
const breadcrumbLD = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).href },
		{ "@type": "ListItem", "position": 2, "name": "Deals", "item": new URL("/posts", Astro.site).href },
		{ "@type": "ListItem", "position": 3, "name": title },
	],
};

// Extract FAQ pairs from raw markdown for FAQPage schema
const faqPairs: { q: string; a: string }[] = [];
const faqRegex = /\*\*Q:\s*(.+?)\*\*\s*\nA:\s*(.+?)(?=\n\s*\*\*Q:|\n\s*##|\s*$)/gs;
let faqMatch;
while ((faqMatch = faqRegex.exec(rawBody)) !== null) {
	faqPairs.push({ q: faqMatch[1].trim(), a: faqMatch[2].trim() });
}
// Strip markdown syntax from FAQ answers for valid Google rich-result JSON-LD
function stripMarkdown(s: string): string {
	return s
		.replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
		.replace(/\*\*([^*]+)\*\*/g, '$1')
		.replace(/\*([^*]+)\*/g, '$1')
		.replace(/`([^`]+)`/g, '$1')
		.trim();
}
const faqLD = faqPairs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqPairs.map(f => ({
		"@type": "Question",
		"name": stripMarkdown(f.q),
		"acceptedAnswer": { "@type": "Answer", "text": stripMarkdown(f.a) },
	})),
} : null;

// Product + Offer schema for deal pages (enables price rich results)
// FREE または価格が取得できない場合は Product schema を省略（price=0 は誤シグナル）
const _rawPrice = dealPrice?.trim().toUpperCase().replace(/[$€£¥]/g, '') ?? '';
const _isFreePrice = _rawPrice === 'FREE' || parseFloat(_rawPrice) === 0;
const _numericPrice = dealPrice ? dealPrice.replace(/[^0-9.]/g, '') : '';
const productLD = (affiliate && dealPrice && !saleExpired && !_isFreePrice && _numericPrice && _numericPrice !== '0') ? {
	"@context": "https://schema.org",
	"@type": "Product",
	"name": title,
	"description": description,
	...(dealBrand ? { "brand": { "@type": "Brand", "name": dealBrand } } : {}),
	...(resolvedImage ? { "image": resolvedImage } : {}),
	...(false ? {  // score は内部ランキング用のためAggregateRatingには使わない
		"aggregateRating": {
			"@type": "AggregateRating",
			"ratingValue": String(score),
			"bestRating": "10",
			"worstRating": "1",
			"ratingCount": "1",
		},
	} : {}),
	"offers": {
		"@type": "Offer",
		"url": affiliate,
		"priceCurrency": "USD",
		"price": _numericPrice,
		"availability": "https://schema.org/InStock",
		"seller": { "@type": "Organization", "name": dealSource || "PluginDrop" },
		...(saleExpiry ? { "priceValidUntil": new Date(saleExpiry).toISOString().split('T')[0] } : {}),
	},
} : null;

// Internal link: tag → Best guide mapping
const BEST_GUIDE_MAP: Record<string, { label: string; slug: string }> = {
	'eq':         { label: 'Best EQ Plugins 2026',          slug: 'best-eq-plugins-2026' },
	'compressor': { label: 'Best Compressor Plugins 2026',  slug: 'best-compressor-plugins-2026' },
	'reverb':     { label: 'Best Reverb Plugins 2026',      slug: 'best-reverb-plugins-2026' },
	'synth':      { label: 'Best Synth Plugins 2026',       slug: 'best-synth-plugins-2026' },
	'mixing':     { label: 'Best Mixing Plugins 2026',      slug: 'best-mixing-plugins-2026' },
	'hip-hop':    { label: 'Best Hip-Hop Sample Packs',     slug: 'best-sample-packs-hip-hop-2026' },
};
const bestGuides = tags
	.map((t: string) => BEST_GUIDE_MAP[t])
	.filter(Boolean)
	.filter((g, i, arr) => arr.findIndex(x => x.slug === g.slug) === i)
	.slice(0, 3);

// Related posts: same tags, exclude current slug
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
	.filter(p => !p.data.draft && p.id !== currentSlug && p.id.replace(/\.mdx?$/, '') !== currentSlug)
	.map(p => ({ ...p, score: p.data.tags?.filter((t: string) => tags.includes(t)).length ?? 0 }))
	.filter(p => p.score > 0)
	.sort((a, b) => b.score - a.score || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={imageStr} ogType="article" />
		<script type="application/ld+json" set:html={JSON.stringify(articleLD)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />
		{faqLD && <script type="application/ld+json" set:html={JSON.stringify(faqLD)} />}
		{productLD && <script type="application/ld+json" set:html={JSON.stringify(productLD)} />}
		<style>
			main {
				width: calc(100% - 2rem);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 1.5rem 1rem 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 400px;
				object-fit: cover;
				border-radius: var(--radius);
				border: 1px solid var(--border);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 1rem 1rem 3rem;
				color: var(--text-secondary);
			}
			.article-header {
				margin-bottom: 1.5rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid var(--border);
			}
			.article-header h1 {
				margin: 0 0 0.75rem 0;
				font-family: var(--font-display);
				font-size: 2rem;
				font-weight: 500;
				line-height: 1.2;
			}
			.meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
			}
			.date {
				color: var(--text-muted);
				font-size: 0.85rem;
			}
			.reading-time {
				color: var(--text-muted);
				font-size: 0.8rem;
			}
			.tags {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}
			/* Hide the first H1 inside article content (already shown in header) */
			.prose > h1:first-of-type,
			.prose :global(h1:first-of-type) {
				display: none;
			}
			.deal-cta-box.sale-expired {
				border-color: var(--border);
				background: var(--bg-card);
				opacity: 0.85;
			}
			.deal-expired-notice {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin-bottom: 0.75rem;
				padding: 0.5rem 0.75rem;
				background: rgba(255, 180, 0, 0.08);
				border-radius: 4px;
				border: 1px solid rgba(255, 180, 0, 0.2);
			}
			.deal-cta-btn.is-expired {
				background: var(--bg-hover);
				color: var(--text-secondary);
				border: 1px solid var(--border);
			}
			.deal-cta-btn.is-expired:hover {
				background: var(--accent-muted);
				color: var(--text-primary);
			}
			.affiliate-disclosure {
				margin-top: 2.5rem;
				padding: 0.75rem 0;
				border-top: 1px solid var(--border);
			}
			.affiliate-disclosure p {
				font-size: 0.78rem;
				color: var(--text-muted);
				margin: 0;
			}
			.related-posts {
				max-width: 720px;
				margin: 2rem auto 0;
				padding: 1.5rem 1rem;
				border-top: 2px solid var(--border);
			}
			.related-title {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin: 0 0 1rem;
			}
			.related-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
			.related-link {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				text-decoration: none;
				color: inherit;
				padding: 0.5rem 0;
				border-bottom: 1px solid var(--border);
			}
			.related-link:hover .related-item-title { text-decoration: underline; }
			.related-thumb {
				width: 80px;
				height: 45px;
				object-fit: cover;
				border-radius: 4px;
				flex-shrink: 0;
			}
			.related-info { display: flex; flex-direction: column; gap: 0.2rem; }
			.related-item-title { font-size: 0.9rem; font-weight: 600; line-height: 1.3; }
			.related-price { font-size: 0.8rem; color: var(--accent); font-weight: 700; }
			/* Countdown timer */
			.deal-countdown {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				margin-bottom: 0.75rem;
				font-size: 0.8rem;
				color: var(--text-muted);
			}
			.countdown-label { color: var(--text-muted); }
			.countdown-time {
				display: flex;
				gap: 0.35rem;
			}
			.countdown-unit {
				display: flex;
				flex-direction: column;
				align-items: center;
				background: var(--bg-hover);
				border-radius: 4px;
				padding: 0.25rem 0.4rem;
				min-width: 36px;
			}
			.countdown-num {
				font-size: 1rem;
				font-weight: 700;
				color: var(--accent-light);
				line-height: 1;
			}
			.countdown-sep { color: var(--accent); font-weight: 700; align-self: flex-start; margin-top: 2px; }
			/* Score badge */
			.deal-score {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				font-size: 0.82rem;
				color: var(--text-muted);
				margin-bottom: 0.5rem;
			}
			.deal-score-val {
				font-weight: 700;
				color: var(--accent-light);
				font-size: 0.95rem;
			}
			/* All-time-low badge */
			.atl-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: #fff;
				background: linear-gradient(135deg, #e63946 0%, #c1121f 100%);
				border-radius: 3px;
				padding: 0.2rem 0.45rem;
				vertical-align: middle;
			}
			/* Best guide callout */
			.best-guide-box {
				margin: 1.5rem 0;
				padding: 0.9rem 1rem;
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-left: 3px solid var(--accent);
				border-radius: var(--radius);
			}
			.best-guide-label {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--text-muted);
				margin-bottom: 0.4rem;
			}
			.best-guide-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.best-guide-link {
				font-size: 0.85rem;
				color: var(--accent-light);
				text-decoration: none;
				padding: 0.2rem 0.5rem;
				border: 1px solid var(--accent-muted);
				border-radius: 20px;
			}
			.best-guide-link:hover { background: var(--accent-muted); }
		</style>
		<!-- Global iframe/video styles (markdown content lacks Astro scoping CIDs) -->
		<style is:global>
			.skip-link {
				position: absolute;
				top: -40px;
				left: 0;
				z-index: 999;
				padding: 0.75rem 1rem;
				background: var(--bg-base);
				color: var(--accent-light);
				text-decoration: none;
				border-radius: 0 0 6px 0;
			}
			.skip-link:focus {
				top: 0;
			}
			.prose iframe {
				width: 100%;
				aspect-ratio: 16 / 9;
				border: 0;
				border-radius: 6px;
				display: block;
				margin: 1.5rem 0;
			}
			.video-embed {
				position: relative;
				width: 100%;
				padding-bottom: 56.25%;
				height: 0;
				overflow: hidden;
				border-radius: 6px;
				margin: 1.5rem 0;
			}
			.video-embed iframe {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				border: 0;
				margin: 0;
				aspect-ratio: unset;
			}
		</style>
		<style>
			@media (max-width: 720px) {
				.article-header h1 { font-size: 1.5rem; }
				.hero-image { padding: 1rem 0.5rem 0; }
			}
		</style>
		<!-- Wrap tables in scrollable container -->
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				document.querySelectorAll('.prose table').forEach(table => {
					if (!table.parentElement?.classList.contains('table-wrap')) {
						const wrap = document.createElement('div');
						wrap.className = 'table-wrap';
						table.parentElement?.insertBefore(wrap, table);
						wrap.appendChild(table);
					}
				});
				// Hide [INTERNAL: ...] placeholders
				document.querySelectorAll('.prose p').forEach(p => {
					if (p.textContent?.trim().startsWith('[INTERNAL:')) {
						p.style.display = 'none';
					}
				});
				// Open external links in new tab
				document.querySelectorAll('.prose a[href^="http"]').forEach(link => {
					link.setAttribute('target', '_blank');
					link.setAttribute('rel', 'noopener noreferrer');
				});
				// Wrap YouTube iframes in .video-embed for responsive 16:9 sizing
				document.querySelectorAll('.prose iframe[src*="youtube"]').forEach(iframe => {
					if (!iframe.parentElement?.classList.contains('video-embed')) {
						const wrap = document.createElement('div');
						wrap.className = 'video-embed';
						iframe.parentElement?.insertBefore(wrap, iframe);
						wrap.appendChild(iframe);
					}
					iframe.setAttribute('loading', 'lazy');
					iframe.src = iframe.src.replace('youtube.com/embed', 'youtube-nocookie.com/embed');
				});
				// Countdown timer
				const cdEl = document.getElementById('deal-countdown');
				if (cdEl) {
					const expiry = new Date(cdEl.dataset.expiry || '').getTime();
					const tick = () => {
						const diff = expiry - Date.now();
						if (diff <= 0) { cdEl.style.display = 'none'; return; }
						const d = Math.floor(diff / 86400000);
						const h = Math.floor((diff % 86400000) / 3600000);
						const m = Math.floor((diff % 3600000) / 60000);
						const fmt = (n: number) => String(n).padStart(2, '0');
						document.getElementById('cd-d')!.textContent = String(d);
						document.getElementById('cd-h')!.textContent = fmt(h);
						document.getElementById('cd-m')!.textContent = fmt(m);
					};
					tick();
					setInterval(tick, 60000);
				}
				// Track affiliate link clicks in GA4
				document.querySelectorAll('.deal-cta-btn, .sticky-cta a').forEach(link => {
					link.addEventListener('click', () => {
						if (typeof gtag !== 'undefined') {
							gtag('event', 'affiliate_click', {
								link_url: link.getAttribute('href'),
								link_text: link.textContent?.trim(),
								page_title: document.title,
							});
						}
					});
				});
				// Hero image fallback scoped to .hero-image sections (no inline onerror — CSP safe).
				// /images/default-placeholder.jpg is committed at public/images/default-placeholder.jpg.
				document.querySelectorAll('.hero-image').forEach(section => {
					section.addEventListener('error', (e) => {
						const img = e.target;
						if (!(img instanceof HTMLImageElement)) return;
						const fallback = img.dataset.fallback;
						if (fallback && img.src !== new URL(fallback, location.href).href) {
							img.src = fallback;
						}
					}, true);
				});
			});
		</script>
	</head>

	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header />
		<main id="main-content">
			<article>
				{imageStr && (
					<div class="hero-image">
						<img src={imageStr} alt={title} loading="eager" fetchpriority="high" data-fallback="/images/default-placeholder.jpg" />
					</div>
				)}
				<div class="prose">
					<!-- Breadcrumb -->
					<nav class="breadcrumb" aria-label="Breadcrumb">
						<a href="/">Home</a>
						<span class="sep" aria-hidden="true">/</span>
						<a href="/posts">Deals</a>
						<span class="sep" aria-hidden="true">/</span>
						<span>{title.length > 50 ? title.slice(0, 50) + '...' : title}</span>
					</nav>

					<!-- Article Header -->
					<div class="article-header">
						<h1>{title}</h1>
						<div class="meta">
							<span class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span> &middot; Updated <FormattedDate date={updatedDate} /></span>
								)}
							</span>
							<span class="reading-time">{readingTime}</span>
							{tags.length > 0 && (
								<div class="tags">
									{tags.map((tag: string) => {
										const tagSlug = tag.trim().toLowerCase().replace(/\s+/g, '-');
										return (
											<a href={`/tags/${tagSlug}/`} class={`tag ${tag === 'free' ? 'free' : tag === 'sale' ? 'sale' : ''}`} style="text-decoration:none">
												{tag}
											</a>
										);
									})}
								</div>
							)}
						</div>
					</div>

					{/* Deal CTA Box — product widget style */}
					{affiliate && (dealPrice || discount || saleExpired) && (
						<div class={`deal-cta-box${saleExpired ? ' sale-expired' : ''}`}>
							{saleExpired ? (
								<>
									<div class="deal-expired-notice">⚠️ This sale has ended — check current price below</div>
									{dealSource && <div class="deal-source">Available via {dealSource}</div>}
									<a href={affiliate} class="deal-cta-btn is-expired" target="_blank" rel="noopener noreferrer nofollow">
										View Current Price →
									</a>
								</>
							) : (
								<>
									{/* score は内部ランキング用 — UI非表示 */}
									{saleExpiry && (
										<div class="deal-countdown" id="deal-countdown" data-expiry={new Date(saleExpiry).toISOString()}>
											<span class="countdown-label">Deal ends in</span>
											<div class="countdown-time">
												<div class="countdown-unit"><span class="countdown-num" id="cd-d">--</span><span style="font-size:0.65rem">d</span></div>
												<span class="countdown-sep">:</span>
												<div class="countdown-unit"><span class="countdown-num" id="cd-h">--</span><span style="font-size:0.65rem">h</span></div>
												<span class="countdown-sep">:</span>
												<div class="countdown-unit"><span class="countdown-num" id="cd-m">--</span><span style="font-size:0.65rem">m</span></div>
											</div>
										</div>
									)}
									{(dealPrice || discount) && (
										<div class="deal-price-row">
											{originalPrice && <span class="deal-price-original">{originalPrice}</span>}
											{dealPrice && <span class={`deal-price-current${_isFreePrice ? ' is-free' : ''}`}>{_isFreePrice ? 'FREE' : dealPrice}</span>}
											{discount && (
												<span class={`deal-save-badge${_isFreePrice ? ' is-free' : ''}`}>{discount}</span>
											)}
											{allTimeLow && <span class="atl-badge">All-Time Low</span>}
										</div>
									)}
									{dealSource && <div class="deal-source">Available via {dealSource}</div>}
									<a href={affiliate} class="deal-cta-btn" target="_blank" rel="noopener noreferrer nofollow">
										{_isFreePrice ? 'Get It Free \u2192' : 'Get This Deal \u2192'}
									</a>
								</>
							)}
						</div>
					)}

					<!-- Article content (from markdown) -->
					<slot />

					{bestGuides.length > 0 && (
						<div class="best-guide-box">
							<div class="best-guide-label">See our buying guides</div>
							<div class="best-guide-links">
								{bestGuides.map((g: { label: string; slug: string }) => (
									<a href={`/posts/${g.slug}/`} class="best-guide-link">{g.label} →</a>
								))}
							</div>
						</div>
					)}

					<div class="affiliate-disclosure">
						<p>This post contains affiliate links. We may earn a small commission at no extra cost to you.</p>
					</div>
				</div>
			</article>

			{relatedPosts.length > 0 && (
				<section class="related-posts" aria-label="Related deals">
					<h2 class="related-title">Related Deals</h2>
					<ul class="related-list">
						{relatedPosts.map(p => (
							<li class="related-item">
								<a href={`/posts/${p.id.replace(/\.mdx?$/, '')}/`} class="related-link">
									{p.data.heroImage && <img src={p.data.heroImage} alt="" loading="lazy" width="120" height="68" class="related-thumb" />}
									<span class="related-info">
										<span class="related-item-title">{p.data.title}</span>
										{p.data.dealPrice && <span class="related-price">{p.data.dealPrice}</span>}
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</main>

		{/* Sticky CTA bar — mobile only, only for articles with affiliate links */}
		{affiliate && (
			<div class="sticky-cta">
				<span class="sticky-title">{saleExpired ? title : (dealPrice ? `${_isFreePrice ? 'FREE' : dealPrice} — ${title}` : title)}</span>
				<a href={affiliate} class="deal-cta-btn" target="_blank" rel="noopener noreferrer nofollow">
					{saleExpired ? 'View Price' : (_isFreePrice ? 'Get Free' : 'Get Deal')}
				</a>
			</div>
		)}

		<Footer />
	</body>
</html>
